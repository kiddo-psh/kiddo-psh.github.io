---
import CoverImage from './CoverImage.astro';
import { getCategory } from '../site.config';
import { type Post } from '../lib/posts';
interface Props {post:Post; sizes:string; heading?:'h2'|'h3'}
const { post, sizes, heading:Heading='h2' } = Astro.props;
const date=post.data.pubDate.toISOString().slice(0,10);
---
<article>
  <a href={`/posts/${post.id}/`}>
    {post.data.cover && <div class="art"><CoverImage src={post.data.cover} sizes={sizes} /></div>}
    <p>{getCategory(post.data.category).name}<span aria-hidden="true">·</span><time datetime={date}>{date.replaceAll('-','.')}</time></p>
    <Heading>{post.data.title}</Heading>
  </a>
</article>
<style>
  a { display:block; color:var(--text); }
  a:hover { text-decoration:none; }
  a:hover :is(h2,h3) { text-decoration:underline; text-underline-offset:.17em; text-decoration-thickness:1px; }
  .art { aspect-ratio:1.85; overflow:hidden; border-radius:12px; background:var(--code-bg); }
  p { display:flex; gap:7px; align-items:center; margin:15px 0 7px; font-size:12px; color:var(--text-dim); }
  time { font-variant-numeric:tabular-nums; }
  h2,h3 { margin:0; font-size:clamp(19px,1.65vw,24px); line-height:1.4; font-weight:580; letter-spacing:-.045em; }
</style>
