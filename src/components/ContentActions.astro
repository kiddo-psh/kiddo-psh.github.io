---
interface Props {
  sourcePath: string;
}

const { sourcePath } = Astro.props;
const encodedPath = sourcePath
  .split('/')
  .map((segment) => encodeURIComponent(segment))
  .join('/');
const sourceUrl = `https://github.com/kiddo-psh/kiddo-psh.github.io/edit/main/${encodedPath}`;
const deleteUrl = `https://github.com/kiddo-psh/kiddo-psh.github.io/blob/main/${encodedPath}`;
---

<div class="content-actions" aria-label="글 관리">
  <a href={sourceUrl} target="_blank" rel="noreferrer">수정</a>
  <a href={deleteUrl} target="_blank" rel="noreferrer" title="GitHub 파일 화면에서 삭제">삭제</a>
</div>

<style>
  .content-actions { display: flex; gap: 8px; margin-top: 18px; }
  .content-actions a { padding: 5px 10px; border: 1px solid var(--border); border-radius: 5px; color: var(--text-dim); font-size: .78em; text-decoration: none; }
  .content-actions a:hover { color: var(--text); border-color: var(--text-dim); }
</style>
