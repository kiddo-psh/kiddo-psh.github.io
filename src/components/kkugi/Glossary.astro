---
import Icon from './Icon.astro';

interface Term {
  term: string;
  desc: string;
}

interface Props {
  terms: Term[];
  follow?: boolean;
}

const { terms, follow = false } = Astro.props;
---

<details class:list={['glossary', { follow }]}>
  <summary>
    <Icon name="chevron-right" class="gchev" size={16} />
    용어 설명<span class="count">{terms.length}</span>
  </summary>
  <dl>
    {
      terms.map((item) => (
        <div class="term">
          <dt>{item.term}</dt>
          <dd>{item.desc}</dd>
        </div>
      ))
    }
  </dl>
</details>
