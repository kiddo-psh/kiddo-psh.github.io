---
import Icon from './Icon.astro';

interface Node {
  icon: 'smartphone' | 'server' | 'cpu' | 'scan' | 'route' | 'shield-check';
  label: string;
  accent?: boolean;
}

interface Props {
  label: string;
  nodes: Node[];
  /** 960px 이상에서 본문보다 넓게. */
  wide?: boolean;
  /** 카드 높이를 맞추고, 960px 미만에서는 세로로 쌓는다. */
  even?: boolean;
}

const { label, nodes, wide = false, even = false } = Astro.props;
---

<div class:list={['arch', 'rv', { wide, even }]} data-component="ServiceArch" aria-label={label}>
  {
    nodes.map((node, index) => (
      <>
        {index > 0 && (
          <div class="link" aria-hidden="true">
            <Icon name="chevron-right" size={18} />
          </div>
        )}
        <div class:list={['card', 'node', { accent: node.accent }]}>
          <Icon name={node.icon} size={20} />
          <span>{node.label}</span>
        </div>
      </>
    ))
  }
</div>
