---
import BrowserBar from './BrowserBar.astro';
import CollabMark from './CollabMark.astro';

interface Props {
  caption: string;
}

const { caption } = Astro.props;
const base = '/projects/kkugi/collab';
const tiles = [
  { file: 'tech-scroll-01.webp', width: 1440, height: 1800 },
  { file: 'tech-scroll-02.webp', width: 1440, height: 1405 },
];
const lead =
  '꾸기 테크 블로그를 데스크톱 폭으로 위에서 아래까지 이어 붙인 화면. 첫 인사와 마스코트, 글 목록, 여섯 명의 팀 소개, 바닥글 순서다.';
---

<figure class="wide lp-fig rv" data-component="TeamBlogScroll">
  <div class="browser lp-frame">
    <BrowserBar url="teamyumyum.github.io" />
    <div class="lp-view">
      <div class="lp-scroll" tabindex="0" role="region" aria-label="꾸기 테크 페이지 전체 화면. 스크롤해서 끝까지 볼 수 있다.">
        {
          tiles.map((tile, index) => (
            <img
              src={`${base}/${tile.file}`}
              width={tile.width}
              height={tile.height}
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding="async"
              alt={index === 0 ? lead : ''}
            />
          ))
        }
      </div>
    </div>
  </div>
  <figcaption class="fig-cap">{caption}</figcaption>
  <div class="lp-actions">
    <a class="pill-btn" href="https://teamyumyum.github.io/" target="_blank" rel="noopener noreferrer">
      새 탭에서 열기<CollabMark name="out" />
    </a>
  </div>
</figure>
