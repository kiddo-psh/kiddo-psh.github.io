---
import BrowserBar from './BrowserBar.astro';
import LoopMedia from './LoopMedia.astro';
import MediaToggle from './MediaToggle.astro';

const base = '/projects/kkugi/collab';
const desktopLabel =
  '꾸기 랜딩 페이지 히어로. 일상의 장면이 클립으로 모여 격자가 되고, 가운데에서 「꾸기」가 「꾸준히기록」으로 펼쳐진다.';
const mobileLabel =
  '같은 히어로의 모바일 화면. 일상의 장면이 세로 격자로 모인 뒤 「꾸기」가 「꾸준히기록」으로 펼쳐진다.';
---

<figure class="wide hero-fig rv" data-media data-component="LandingHeroWord">
  <div class="seg-row">
    <div class="seg" role="radiogroup" aria-label="랜딩 히어로 화면 크기">
      <span class="seg-thumb" aria-hidden="true"></span>
      <button type="button" role="radio" class="seg-opt" data-show="desktop" aria-checked="true" tabindex="0" aria-controls="hero-desk">
        데스크톱
      </button>
      <button type="button" role="radio" class="seg-opt" data-show="mobile" aria-checked="false" tabindex="-1" aria-controls="hero-mob">
        모바일
      </button>
    </div>
  </div>
  <div class="hero-stage" data-show="desktop">
    <div class="hero-panel panel-desk" id="hero-desk">
      <div class="browser">
        <BrowserBar url="kkugi.duckdns.org" />
        <div class="browser-view">
          <LoopMedia
            webm={`${base}/hero-word-desk.webm`}
            mp4={`${base}/hero-word-desk.mp4`}
            gif={`${base}/hero-word-desk.gif`}
            poster={`${base}/hero-word-desk-poster.webp`}
            label={desktopLabel}
            width={1280}
            height={800}
          />
        </div>
      </div>
    </div>
    <div class="hero-panel panel-mob" id="hero-mob" hidden>
      <div class="phone">
        <LoopMedia
          webm={`${base}/hero-word-mob.webm`}
          mp4={`${base}/hero-word-mob.mp4`}
          gif={`${base}/hero-word-mob.gif`}
          poster={`${base}/hero-word-mob-poster.webp`}
          label={mobileLabel}
          width={600}
          height={1298}
        />
      </div>
    </div>
    <MediaToggle />
  </div>
</figure>
