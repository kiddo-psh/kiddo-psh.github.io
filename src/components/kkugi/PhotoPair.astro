---
const base = '/projects/kkugi/collab';
---

<figure class="wide photo-fig rv" data-component="ReviewDayPhotos">
  <div class="photo-pair">
    <figure>
      <img
        src={`${base}/review-day.webp`}
        width="1600"
        height="1200"
        loading="lazy"
        decoding="async"
        alt="시퀀스 다이어그램을 띄워 놓고 기능의 동작 흐름을 이야기하는 팀원들"
      />
    </figure>
    <figure class="p2">
      <img
        src={`${base}/review-flow.webp`}
        width="1600"
        height="1200"
        loading="lazy"
        decoding="async"
        alt="보드에 클라이언트, 서버, AI 서버와 DB 사이의 요청과 응답을 그리며 설명하는 모습"
      />
    </figure>
  </div>
</figure>
