---
interface Shot {
  id: string;
  label: string;
  src: string;
  srcset?: string;
  width: number;
  height: number;
  alt: string;
}

interface Props {
  label: string;
  caption: string;
  shots: Shot[];
}

const { label, caption, shots } = Astro.props;
---

<figure class="shot-tabs fig rv" data-shot-tabs>
  <div class="tray-toggle" role="tablist" aria-label={label}>
    <span class="pill-thumb" aria-hidden="true"></span>
    {
      shots.map((shot, index) => (
        <button
          type="button"
          class="seg-btn"
          role="tab"
          aria-pressed={index === 0 ? 'true' : 'false'}
          data-shot={shot.id}
        >
          {shot.label}
        </button>
      ))
    }
  </div>
  <div class="shot-stage card">
    {
      shots.map((shot, index) => (
        <>
          <p class="shot-name">{shot.label}</p>
          <img
            class:list={{ 'is-active': index === 0 }}
            data-shot={shot.id}
            src={shot.src}
            srcset={shot.srcset}
            sizes={shot.srcset ? '(min-width: 960px) 880px, 100vw' : undefined}
            width={shot.width}
            height={shot.height}
            alt={shot.alt}
            decoding="async"
          />
        </>
      ))
    }
  </div>
  <figcaption class="fig-cap">{caption}</figcaption>
</figure>

<style>
  .shot-tabs {
    margin: 20px 0 28px;
  }
  .shot-tabs :global(.tray-toggle) {
    max-width: 100%;
    margin-bottom: 10px;
  }
  .shot-stage {
    overflow: hidden;
  }
  .shot-stage img {
    display: block;
    width: 100%;
    height: auto;
  }
  .shot-name {
    margin: 0;
    padding: 12px 16px 0;
    color: var(--secondary);
    font-size: 0.875rem;
  }
  :global(html.js) .shot-stage img {
    display: none;
  }
  :global(html.js) .shot-stage img.is-active {
    display: block;
  }
  :global(html.js) .shot-name {
    display: none;
  }
</style>

<script>
  function place(track: HTMLElement): void {
    const thumb = track.querySelector('.pill-thumb');
    const selected = track.querySelector<HTMLElement>('[aria-pressed="true"]');
    if (!(thumb instanceof HTMLElement) || !selected) return;
    const trackBox = track.getBoundingClientRect();
    const box = selected.getBoundingClientRect();
    thumb.style.width = `${box.width}px`;
    thumb.style.transform = `translateX(${box.left - trackBox.left}px)`;
    track.classList.add('pill-ready');
  }

  document.querySelectorAll<HTMLElement>('[data-shot-tabs]').forEach((fig) => {
    const track = fig.querySelector('.tray-toggle');
    if (!(track instanceof HTMLElement)) return;
    const buttons = [...fig.querySelectorAll<HTMLButtonElement>('.seg-btn')];
    const images = [...fig.querySelectorAll<HTMLImageElement>('img')];
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const id = button.dataset.shot;
        buttons.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
        images.forEach((img) => img.classList.toggle('is-active', img.dataset.shot === id));
        place(track);
      });
    });
  });
</script>
