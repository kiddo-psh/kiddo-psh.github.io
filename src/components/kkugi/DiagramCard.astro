---
import CollabMark from './CollabMark.astro';

const src = '/projects/kkugi/collab/review-sequence.webp';
---

<figure class="wide card diagram rv" data-component="ReviewDaySequence">
  <p class="fig-title">
    <span></span>
    <a class="zoom" href={src} target="_blank" rel="noopener">
      원본 크기<CollabMark name="max" />
    </a>
  </p>
  <div class="diagram-scroll" tabindex="0" role="region" aria-label="시퀀스 다이어그램, 가로로 스크롤">
    <img
      src={src}
      width="2458"
      height="1760"
      loading="lazy"
      decoding="async"
      alt="폰에서 사진을 업로드한 뒤 Spring 서버가 AI 응답을 기다리고, 사진과 결과를 DB 트랜잭션으로 저장한 후 응답하는 시퀀스 다이어그램"
    />
  </div>
</figure>
