---
/*
 * 글·프로젝트마다 붙는 마크.
 *
 * 전에는 그림이 한 장도 없었다. "이미지를 매 글마다 만들지 않기로 했다"는 결정
 * 때문이었는데, 그 결정의 진짜 이유는 손으로 그리는 비용이지 그림 자체가 아니다.
 * 그래서 사람이 그리지 않아도 되는 그림을 둔다 — 글의 id에서 결정론적으로 뽑으므로
 * 새 글을 써도 자산을 만들 일이 없고, 같은 글은 어느 페이지에서나 같은 마크를 갖는다.
 *
 * 무엇을 그릴지는 이 블로그가 쓰는 것에서 가져왔다. 파이프라인·게이트·라우팅을
 * 쓰는 글이라 격자를 가로지르는 경로를 그리고, 그 위 한 점에서 가지를 하나 띄운다.
 * 채워진 점이 판정 지점이고 가지 끝이 걸러진 쪽이다 — 장식이 아니라 글 내용의 축약이다.
 */
interface Props {
  /** 마크를 뽑을 씨앗. 글·프로젝트의 id를 그대로 넘긴다 */
  seed: string;
  /** 타일 한 변. 기본값은 목록 행에 쓰는 크기다 */
  size?: number;
  /** 타일 색. 안 주면 씨앗에서 뽑는다 */
  tone?: 'a' | 'b' | 'c' | 'd';
  /**
   * 가로로 긴 머리그림. 글 상세 위에 깔린다.
   * 정사각 타일은 목록에서 글을 가리키는 표식이고, 이쪽은 본문 폭을 채우는 그림이라
   * 칸 수를 늘리고 게이트를 둘 둔다 — 같은 규칙을 그대로 늘리면 선 하나가 밋밋하게 지나간다.
   */
  banner?: boolean;
  /**
   * 타일 배경 없이 선만 그린다. 이미 색이 깔린 면(프로젝트 카드의 썸네일 칸) 위에
   * 올릴 때 쓴다 — 거기에 타일까지 그리면 색면 위에 색면이 겹쳐 액자 속 액자가 된다.
   */
  plain?: boolean;
  class?: string;
}
const { seed, size = 56, tone, banner = false, plain = false, class: className } = Astro.props;

/* FNV-1a. 빌드 시각이나 렌더 순서가 아니라 id에만 의존해야 마크가 고정된다 */
function hash(s: string): number {
  let h = 0x811c9dc5;
  for (let i = 0; i < s.length; i++) {
    h ^= s.charCodeAt(i);
    h = Math.imul(h, 0x01000193) >>> 0;
  }
  return h;
}

/* 해시 하나로 여러 선택을 해야 하므로 선형 합동 생성기로 늘려 쓴다 */
let state = hash(seed);
const next = () => (state = (Math.imul(state, 1664525) + 1013904223) >>> 0);

const TONES = ['a', 'b', 'c', 'd'] as const;
const pickedTone = tone ?? TONES[next() % 4];

/*
 * 4×4 격자를 왼쪽에서 오른쪽으로 가로지르는 경로.
 *
 * 처음에는 5칸에 ±1 흔들림이었는데, 그러면 대부분 거의 평평한 경로가 나와서
 * 마크 네 개를 나란히 놓으면 전부 "점이 꿰인 줄"로 똑같이 보였다. 칸을 줄이고
 * 흔들림을 ±2까지 늘렸는데도 이번엔 대부분 한 방향 계단이 나왔다 — 진폭만 보면
 * 계단도 통과하기 때문이다. 그래서 조건을 둘로 둔다: 위아래로 2칸 이상 움직이고,
 * 중간에 방향이 한 번은 뒤집힐 것. 둘을 다 걸면 남는 모양이 확 갈린다.
 */
const N = banner ? 9 : 4;
const ROWS = 4;
const varied = (rs: number[]) => {
  if (Math.max(...rs) - Math.min(...rs) < 2) return false;
  const dirs = rs.slice(1).map((r, i) => Math.sign(r - rs[i])).filter(Boolean);
  return dirs.some((d, i) => i > 0 && d !== dirs[i - 1]);
};
let rows: number[] = [];
for (let tries = 0; tries < 24; tries++) {
  let r = next() % ROWS;
  rows = [r];
  for (let c = 1; c < N; c++) {
    const d = (next() % 5) - 2;
    r = Math.min(ROWS - 1, Math.max(0, r + d));
    rows.push(r);
  }
  if (varied(rows)) break;
}

/*
 * 격자 좌표 → viewBox 좌표.
 * 타일은 100×100 안에서 17~83을 쓰고, 배너는 세로를 그대로 두고 가로만 늘린다 —
 * 칸 간격을 같이 늘리면 선이 길게 늘어져 타일과 다른 그림처럼 보인다.
 */
const VW = banner ? 560 : 100;
const VH = 100;
const X = banner ? (c: number) => 30 + c * 62.5 : (c: number) => 17 + c * 22;
const Y = (r: number) => 17 + r * 22;

/*
 * 직교 경로로 잇는다. 대각선으로 이으면 파이프라인이 아니라 꺾은선 그래프로 읽힌다.
 * 두 점 사이 중간 x에서 세로로 갈아탄다.
 */
let d = `M ${X(0)} ${Y(rows[0])}`;
for (let c = 1; c < N; c++) {
  const mid = (X(c - 1) + X(c)) / 2;
  d += rows[c - 1] === rows[c]
    ? ` L ${X(c)} ${Y(rows[c])}`
    : ` L ${mid} ${Y(rows[c - 1])} L ${mid} ${Y(rows[c])} L ${X(c)} ${Y(rows[c])}`;
}

/*
 * 판정 지점. 양 끝은 들고 나는 자리라 안쪽에서 고른다.
 * 배너는 둘을 뽑되 서로 두 칸 이상 떨어뜨린다 — 붙어 있으면 한 덩어리로 보인다.
 */
const gates: number[] = [1 + (next() % (N - 2))];
if (banner) {
  for (let t = 0; t < 12; t++) {
    const g = 1 + (next() % (N - 2));
    if (Math.abs(g - gates[0]) >= 2) { gates.push(g); break; }
  }
}

/*
 * 걸러지는 가지. 게이트에서 세로로 한 칸 뻗는다. 격자 밖으로 나가지 않는 쪽을
 * 고르고, 양쪽 다 되면 씨앗으로 정한다.
 */
const stubs = gates.map((g) => {
  const gr = rows[g];
  const dir = gr === 0 ? 1 : gr === ROWS - 1 ? -1 : next() % 2 ? 1 : -1;
  return { g, gr, dir, d: `M ${X(g)} ${Y(gr)} L ${X(g)} ${Y(gr + dir)}` };
});
---

<svg
  class:list={['mk', `t-${pickedTone}`, { banner, plain }, className]}
  width={banner ? undefined : size}
  height={banner ? undefined : size}
  viewBox={`0 0 ${VW} ${VH}`}
  {/*
    * 배너는 slice(= object-fit: cover)로 채운다. 처음에는 none으로 늘렸는데,
    * 가로만 늘어나니 점이 타원이 되고 세로선이 가로선보다 두 배 굵어졌다.
    * slice는 비율을 지키며 덮으므로 점은 원으로, 선 굵기는 사방이 같게 남는다.
    * 좁은 본문에서는 좌우가 조금 잘리는데, 선이 화면 밖으로 이어지는 그림이라 문제없다.
    */}
  preserveAspectRatio={banner ? 'xMidYMid slice' : 'xMidYMid meet'}
  role="presentation"
  aria-hidden="true"
  focusable="false"
>
  {!plain && <rect width={VW} height={VH} rx={banner ? 12 : 18} class="tile" />}
  {stubs.map((s) => <path d={s.d} class="wire branch" />)}
  <path d={d} class="wire" />
  {/* 걸러진 쪽 끝. 속을 타일색으로 비워 본선의 채워진 점과 구분한다 */}
  {stubs.map((s) => <circle cx={X(s.g)} cy={Y(s.gr + s.dir)} r="5" class="node open" />)}
  {rows.map((r, c) => (
    <circle cx={X(c)} cy={Y(r)} r={gates.includes(c) ? 8 : 5} class:list={['node', { gate: gates.includes(c) }]} />
  ))}
</svg>

<style>
  .mk { display: block; flex: 0 0 auto; }
  /*
   * 배너는 본문 폭을 채운다. preserveAspectRatio="none"이라 가로로 늘어나는데,
   * 선이 직교라 늘어나도 각이 무너지지 않는다(대각선이었다면 못 쓴다).
   * 높이를 고정해야 화면 폭에 따라 그림이 세로로도 커지지 않는다.
   */
  .banner { width: 100%; height: 132px; }
  @media (max-width: 640px) { .banner { height: 104px; } }
  .tile { fill: var(--mk); }
  .t-a { --mk: var(--mk-a); }
  .t-b { --mk: var(--mk-b); }
  .t-c { --mk: var(--mk-c); }
  .t-d { --mk: var(--mk-d); }

  /*
   * 선 굵기를 viewBox 기준으로 두면 타일이 작아질 때 같이 얇아진다. 44px 타일에서
   * 6/100 → 2.6px이라 종이색 위에서 획이 끊기지 않는다.
   */
  .wire { fill: none; stroke: var(--text); stroke-width: 6; stroke-linecap: round; stroke-linejoin: round; }
  /* 걸러지는 가지는 본선보다 가늘게 — 같은 굵기면 어느 쪽이 본선인지 알 수 없다 */
  .branch { stroke-width: 4; opacity: .45; }

  /* 본선의 점은 속을 채운다. 선과 같은 색이라 점과 선이 한 덩어리로 읽힌다 */
  .node { fill: var(--text); }
  .open { fill: var(--mk); stroke: var(--text); stroke-width: 4; opacity: .45; }
  /*
   * 타일을 안 그리는 경우 열린 점의 속도 채울 배경이 없다. 부모 면의 색을 모르므로
   * 칠하지 않고 비워 두면 뒤가 비쳐서 그대로 맞는다.
   */
  .plain .open { fill: none; }
  .gate { fill: var(--accent); }
</style>
