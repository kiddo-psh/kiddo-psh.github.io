---
/*
 * 글·프로젝트마다 붙는 마크.
 *
 * 전에는 그림이 한 장도 없었다. "이미지를 매 글마다 만들지 않기로 했다"는 결정
 * 때문이었는데, 그 결정의 진짜 이유는 손으로 그리는 비용이지 그림 자체가 아니다.
 * 그래서 사람이 그리지 않아도 되는 그림을 둔다 — 글의 id에서 결정론적으로 뽑으므로
 * 새 글을 써도 자산을 만들 일이 없고, 같은 글은 어느 페이지에서나 같은 마크를 갖는다.
 *
 * 무엇을 그리는가. 처음에는 격자를 가로지르는 파이프라인 선(점 · 게이트 · 가지)을
 * 그렸다. 글 내용의 축약이라는 뜻은 좋았지만 굵은 검은 선이 흰 카드 위에 놓이니
 * 회로도나 노선도로 읽혔고, 색판 안에 흰 카드, 그 안에 선이라 액자 속 액자가 됐다.
 * 지금은 참고한 Anthropic 도판처럼 단순한 기하 도형 몇 개를 색판 위에 바로 놓는다 —
 * 원 · 반원 · 사분원 · 막대 · 고리를 두세 색으로 겹친다. 뜻을 담지 않는 대신 어느
 * 글 옆에 놓여도 그림으로 읽힌다.
 *
 * 색은 넷뿐이다. s1 종이(제일 큰 도형), s2 판보다 한 단계 진한 같은 색,
 * s3 사이트 강조색, s0 먹(작은 점 · 고리). 판이 아니라 흰 면 위에 놓일 때(plain)는
 * 종이가 보이지 않으므로 s1이 판 색을 대신 맡는다.
 */
interface Props {
  /** 마크를 뽑을 씨앗. 글·프로젝트의 id를 그대로 넘긴다 */
  seed: string;
  /** 타일 한 변. 기본값은 목록 행에 쓰는 크기다 */
  size?: number;
  /** 타일 색. 안 주면 씨앗에서 뽑는다 */
  tone?: 'a' | 'b' | 'c' | 'd';
  /**
   * 가로로 긴 머리그림. 글 상세 위에 깔린다. 정사각 타일 한 장이 아니라 도형 묶음
   * 셋을 늘어놓고 양 끝에 큰 도형을 걸쳐 잘리게 둔다 — 화면 폭에 따라 좌우가
   * 잘리는 그림(slice)이라, 잘려도 되는 것이 잘리게 배치한다.
   */
  banner?: boolean;
  /**
   * 타일 배경 없이 도형만 그린다. 이미 색이 깔린 면(프로젝트 카드의 썸네일 칸) 위에
   * 올릴 때 쓴다 — 거기에 타일까지 그리면 색면 위에 색면이 겹쳐 액자 속 액자가 된다.
   */
  plain?: boolean;
  class?: string;
}
const { seed, size = 56, tone, banner = false, plain = false, class: className } = Astro.props;

/* FNV-1a. 빌드 시각이나 렌더 순서가 아니라 id에만 의존해야 마크가 고정된다 */
function hash(s: string): number {
  let h = 0x811c9dc5;
  for (let i = 0; i < s.length; i++) {
    h ^= s.charCodeAt(i);
    h = Math.imul(h, 0x01000193) >>> 0;
  }
  return h;
}

/* 해시 하나로 여러 선택을 해야 하므로 선형 합동 생성기로 늘려 쓴다 */
let state = hash(seed);
const next = () => (state = (Math.imul(state, 1664525) + 1013904223) >>> 0);
const pick = (n: number) => next() % n;
/* -j..+j 사이 정수. 같은 틀에서 뽑힌 마크가 서로 조금씩 다르게 앉는다 */
const jitter = (j: number) => pick(2 * j + 1) - j;

const TONES = ['a', 'b', 'c', 'd'] as const;
const pickedTone = tone ?? TONES[pick(4)];

/*
 * 도형 어휘. 좌표는 한 칸(100×100) 기준이고, 바닥선 B 위에 앉는 것과 떠 있는 것이
 * 있다. arch의 rot은 시계 방향 90° 단위로 0이 평평한 면이 아래.
 */
type Color = 's0' | 's1' | 's2' | 's3';
type Shape =
  | { k: 'disc'; x: number; y: number; r: number; c: Color }
  | { k: 'ring'; x: number; y: number; r: number; c: Color }
  | { k: 'arch'; x: number; y: number; r: number; rot: number; c: Color }
  /* dir 1이면 직각이 왼쏙 아래에 있고 오른쪽으로 부풀고, -1이면 그 거울상 */
  | { k: 'quarter'; x: number; y: number; r: number; dir: 1 | -1; c: Color }
  | { k: 'pill'; x: number; y: number; w: number; h: number; c: Color };

const B = 84;

/*
 * 여섯 틀. 큰 도형 하나(s1)에 중간 도형 하나, 먹으로 찍은 작은 점이나 고리 하나 —
 * 셋을 넘기지 않는다. 넷부터는 마크가 아니라 그림이 되어 제목과 자리를 다툰다.
 * 중간 도형의 색(s2/s3)은 씨앗이 고른다.
 */
type Template = (m: Color) => Shape[];
const TEMPLATES: Template[] = [
  /* 언덕 위의 해 */
  (m) => [
    { k: 'arch', x: 50, y: B, r: 32, rot: 0, c: 's1' },
    { k: 'disc', x: 66 + jitter(4), y: B - 40 - jitter(3), r: 12, c: m },
    { k: 'disc', x: 36 + jitter(3), y: B - 10, r: 4, c: 's0' },
  ],
  /* 두 원이 겹친 자리 */
  (m) => [
    { k: 'disc', x: 42, y: 50 + jitter(4), r: 30, c: 's1' },
    { k: 'disc', x: 64 + jitter(3), y: 58 + jitter(3), r: 20, c: m },
    { k: 'ring', x: 28, y: 26 + jitter(3), r: 6, c: 's0' },
  ],
  /* 잎 — 사분원 둘을 등지고 맞대 반원을 만든다. 위에 작은 열매 */
  (m) => [
    { k: 'quarter', x: 50, y: B, r: 34, dir: 1, c: 's1' },
    { k: 'quarter', x: 50, y: B, r: 34, dir: -1, c: m },
    { k: 'disc', x: 50 + jitter(2), y: B - 34 - 10, r: 6, c: 's0' },
  ],
  /* 기둥과 원 */
  (m) => [
    { k: 'pill', x: 34, y: 16 + jitter(3), w: 32, h: B - 16, c: 's1' },
    { k: 'disc', x: 62 + jitter(3), y: 32 + jitter(4), r: 14, c: m },
    { k: 'disc', x: 50, y: B - 12, r: 4, c: 's0' },
  ],
  /* 계단 — 막대 셋이 어긋나며 내려온다 */
  (m) => [
    { k: 'pill', x: 14, y: 20, w: 46, h: 16, c: 's1' },
    { k: 'pill', x: 30, y: 42, w: 46, h: 16, c: m },
    { k: 'pill', x: 46, y: 64, w: 40, h: 16, c: 's1' },
    { k: 'disc', x: 20, y: 72, r: 4, c: 's0' },
  ],
  /* 모서리에 큰 사분원, 그 위에 뜬 달 */
  (m) => [
    { k: 'quarter', x: 12, y: 90, r: 68, dir: 1, c: 's1' },
    { k: 'disc', x: 68 + jitter(3), y: 34 + jitter(3), r: 15, c: m },
    { k: 'ring', x: 38, y: 60, r: 6, c: 's0' },
  ],
];

/* 한 칸을 그린다. 절반은 좌우를 뒤집어 같은 틀도 다른 얼굴로 나오게 한다 */
function cell(t: number): { shapes: Shape[]; flip: boolean } {
  const mid: Color = pick(2) ? 's2' : 's3';
  return { shapes: TEMPLATES[t](mid), flip: pick(2) === 1 };
}

const N_T = TEMPLATES.length;
const VW = banner ? 560 : 100;
const VH = 100;

type Placed = { shapes: Shape[]; flip: boolean; dx: number };
const cells: Placed[] = [];
if (!banner) {
  cells.push({ ...cell(pick(N_T)), dx: 0 });
} else {
  /*
   * 머리그림. 판 높이(176px)에 맞춰 세로를 채우면 가로는 화면 폭에 따라 375~560
   * 단위만 보인다(xMidYMid slice). 그래서 세 묶음을 항상 보이는 가운데 92~468에
   * 놓고, 양 끝에는 큰 도형 하나씩을 반쯤 걸쳐 잘리게 둔다. 틀은 셋이 서로 다르다.
   */
  const order = [...Array(N_T).keys()];
  for (let i = order.length - 1; i > 0; i--) {
    const j = pick(i + 1);
    [order[i], order[j]] = [order[j], order[i]];
  }
  const xs = [118, 232, 346].map((x) => x + jitter(10));
  xs.forEach((x, i) => cells.push({ ...cell(order[i]), dx: x }));
}

/* 끝에 걸치는 큰 도형. 잘려도 되는 것이라 색은 조용한 s2만 쓴다 */
const edges: Shape[] = banner
  ? [
      { k: 'disc', x: 8 + jitter(6), y: 30 + jitter(10), r: 34, c: 's2' },
      { k: 'arch', x: 546 + jitter(6), y: B, r: 40, rot: 0, c: 's2' },
    ]
  : [];

function d(s: Shape): string {
  if (s.k === 'arch') return `M${s.x - s.r} ${s.y} A${s.r} ${s.r} 0 0 1 ${s.x + s.r} ${s.y} Z`;
  if (s.k === 'quarter') {
    /* 직각 모서리에서 위로 올라가 호를 따라 dir 쪽으로 내려온다. 거울상은 호의 방향(sweep)만 뒤집힌다 */
    return `M${s.x} ${s.y} V${s.y - s.r} A${s.r} ${s.r} 0 0 ${s.dir === 1 ? 1 : 0} ${s.x + s.dir * s.r} ${s.y} Z`;
  }
  return '';
}
const rotOf = (s: Shape) => ('rot' in s && s.rot ? `rotate(${s.rot * 90} ${s.x} ${s.y})` : undefined);
---

<svg
  class:list={['mk', `t-${pickedTone}`, { banner, plain }, className]}
  width={banner ? undefined : size}
  height={banner ? undefined : size}
  viewBox={`0 0 ${VW} ${VH}`}
  {/*
    * 배너는 slice(= object-fit: cover)로 채운다. 비율을 지키며 덮으므로 원이 타원이
    * 되지 않고, 좁은 본문에서는 좌우가 잘린다 — 잘려도 되는 도형을 끝에 두었다.
    */}
  preserveAspectRatio={banner ? 'xMidYMid slice' : 'xMidYMid meet'}
  role="presentation"
  aria-hidden="true"
  focusable="false"
>
  {!plain && <rect width={VW} height={VH} rx={banner ? 0 : 18} class="tile" />}
  {edges.map((s) => (
    s.k === 'disc' ? <circle cx={s.x} cy={s.y} r={s.r} class={s.c} /> : <path d={d(s)} class={s.c} />
  ))}
  {cells.map((c) => (
    <g transform={`translate(${c.dx} 0)${c.flip ? ' translate(100 0) scale(-1 1)' : ''}`}>
      {c.shapes.map((s) =>
        s.k === 'disc' ? <circle cx={s.x} cy={s.y} r={s.r} class={s.c} />
        : s.k === 'ring' ? <circle cx={s.x} cy={s.y} r={s.r} class:list={[s.c, 'ring']} />
        : s.k === 'pill' ? <rect x={s.x} y={s.y} width={s.w} height={s.h} rx={Math.min(s.w, s.h) / 2} class={s.c} />
        : <path d={d(s)} transform={rotOf(s)} class={s.c} />
      )}
    </g>
  ))}
</svg>

<style>
  .mk { display: block; flex: 0 0 auto; }
  /* 머리그림은 액자(.art-frame.band)를 그대로 채운다. 높이는 액자가 정한다 */
  .banner { width: 100%; height: 100%; }
  .tile { fill: var(--mk); }
  .t-a { --mk: var(--mk-a); }
  .t-b { --mk: var(--mk-b); }
  .t-c { --mk: var(--mk-c); }
  .t-d { --mk: var(--mk-d); }

  /*
   * 네 색. s2는 판 색에 먹을 조금 섞은 것이라 라이트에서는 판보다 진하고 다크에서는
   * 판보다 밝다 — 어느 쪽이든 판 위에서 한 단계 떠 보인다. 종이(s1)는 다크에서
   * 판보다 어두워져 구멍처럼 보이므로, 그때는 판 색을 크게 밝힌 값으로 바꾼다.
   */
  .mk {
    --s1: var(--bg-elev);
    --s2: color-mix(in oklab, var(--mk) 62%, var(--text));
  }
  :root[data-theme='dark'] .mk { --s1: color-mix(in oklab, var(--mk) 35%, var(--text)); }
  /* 흰 면 위(plain)에서는 종이가 안 보이므로 제일 큰 도형이 판 색을 맡는다 */
  .plain { --s1: var(--mk); }
  .s0 { fill: var(--text); }
  .s1 { fill: var(--s1); }
  .s2 { fill: var(--s2); }
  .s3 { fill: var(--accent); }
  /*
   * 고리 굵기를 viewBox 기준으로 두면 타일이 작아질 때 같이 얇아진다. 44px 타일에서
   * 4/100 → 1.8px이라 판 위에서 획이 끊기지 않는다.
   */
  .ring { fill: none; stroke: var(--text); stroke-width: 4; }
</style>
