---
interface Props {
  title: string;
  links: { href: string; label: string; meta?: string }[];
}
const { title, links } = Astro.props;
---

{links.length > 0 && (
  <section class="rel">
    <h2 class="sec-title">{title}</h2>
    <ul>
      {links.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
          {link.meta && <span class="meta">{link.meta}</span>}
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .rel { margin-top: var(--section); }
  ul { list-style: none; margin: 0; padding: 0; }
  li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--divider);
  }
  a {
    color: var(--text);
    font-size: 0.9375rem;
    font-weight: 450;
    line-height: 1.45;
  }
  a:hover { color: var(--text); }
  .meta {
    margin-left: auto;
    color: var(--text-dim);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 520px) {
    .meta { margin-left: 0; }
  }
</style>
