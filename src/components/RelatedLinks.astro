---
/*
 * 상세 페이지 맨 아래의 "다음에 볼 것".
 *
 * 전에는 글은 "같은 분류의 다른 글", 프로젝트는 본문 안에 마크다운으로 쓴
 * "관련 회고"(불릿 리스트), 브리핑은 아무것도 없어서 세 종류가 제각각이었다.
 * 페이지 끝에서 다음 행동이 예측되려면 같은 자리에 같은 모양이어야 한다.
 */
interface Props {
  title: string;
  links: { href: string; label: string; meta?: string }[];
}
const { title, links } = Astro.props;
---

{links.length > 0 && (
  <section class="rel">
    <h2 class="section-label">{title}</h2>
    <ul>
      {links.map((l) => (
        <li>
          <a href={l.href}>{l.label}</a>
          {l.meta && <span class="meta">{l.meta}</span>}
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .rel { margin-top: var(--space-16); padding-top: var(--space-6); border-top: 1px solid var(--border); }
  ul { list-style: none; margin: 0; padding: 0; }
  li {
    display: flex; align-items: baseline; gap: var(--space-3);
    padding: var(--space-3) 0; border-bottom: 1px solid var(--border);
  }
  li:last-child { border-bottom: 0; }
  li a { color: var(--text); font-size: var(--fs-400); transition: color var(--dur) var(--ease); }
  li a:hover { color: var(--accent); text-decoration: none; }
  .meta { margin-left: auto; flex: 0 0 auto; font-size: var(--fs-200); color: var(--text-dim); }

  @media (max-width: 560px) {
    li { flex-direction: column; align-items: flex-start; gap: var(--space-1); }
    .meta { margin-left: 0; }
  }
</style>
