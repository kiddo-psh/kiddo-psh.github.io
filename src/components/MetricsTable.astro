---
interface Metric { label: string; before: string; after: string }
interface Props { metrics: Metric[] }
const { metrics } = Astro.props;
---

{metrics.length > 0 && (
  <div class="metrics">
    {metrics.map((metric) => (
      <div class="m">
        <div class="lbl">{metric.label}</div>
        <div class="val">
          <s>{metric.before}</s>
          <span class="arrow" aria-hidden="true">→</span>
          <b>{metric.after}</b>
        </div>
      </div>
    ))}
  </div>
)}

<style>
  .metrics { margin: 28px 0; border-top: 1px solid var(--hair); }
  .m { padding: 12px 0; border-bottom: 1px solid var(--divider); }
  .lbl { margin-bottom: 4px; color: var(--text-dim); font-size: 0.8125rem; }
  .val { display: flex; align-items: baseline; gap: 8px; color: var(--text); font-variant-numeric: tabular-nums; }
  s { color: var(--text-dim); font-size: 0.875rem; text-decoration: line-through; }
  .arrow { color: var(--text-dim); font-size: 0.8125rem; }
  b { font-size: 1.0625rem; font-weight: 550; }
</style>
