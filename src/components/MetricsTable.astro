---
/*
 * 상세 페이지에서 전체 지표를 보여주는 용도. 카드의 대표 숫자는 ProjectCard가
 * 색 영역 안에서 직접 그리므로(흰 글씨가 필요해 스타일이 다르다) compact 모드는 없다.
 */
interface Metric { label: string; before: string; after: string }
interface Props { metrics: Metric[] }
const { metrics } = Astro.props;
const shown = metrics;
---

{shown.length > 0 && (
  <div class="metrics">
    {shown.map((m) => (
      <div class="m">
        <div class="lbl">{m.label}</div>
        <div class="val">
          <s>{m.before}</s>
          <span class="arrow" aria-hidden="true">→</span>
          <b>{m.after}</b>
        </div>
      </div>
    ))}
  </div>
)}

<style>
  .metrics {
    display: grid; gap: var(--space-3);
    grid-template-columns: repeat(auto-fit, minmax(min(171px, 100%), 1fr));
    margin: var(--space-6) 0 var(--space-8);
  }
  .m { border: 1px solid var(--border); border-radius: var(--radius-lg); padding: var(--space-3) var(--space-4); background: var(--bg-elev); }
  .lbl { font-size: var(--fs-300); color: var(--text-dim); margin-bottom: var(--space-1); }
  .val { display: flex; align-items: baseline; gap: var(--space-2); }
  s { color: var(--text-dim); opacity: .7; font-size: var(--fs-300); text-decoration: line-through; }
  .arrow { color: var(--text-dim); font-size: var(--fs-200); }
  b { color: var(--accent); font-size: var(--fs-600); font-weight: 800; letter-spacing: var(--ls-snug); }
</style>
