<button id="theme-toggle" type="button" aria-label="다크 모드로 전환" aria-pressed="false">
  <span aria-hidden="true">☾</span>
</button>

<style>
  button {
    background: none; border: 1px solid var(--border); border-radius: 6px;
    color: var(--text-dim); cursor: pointer; padding: 3px 8px; font-size: 13px;
    line-height: 1.4;
  }
  button:hover { color: var(--text); }
</style>

<script>
  const btn = document.getElementById('theme-toggle');
  const glyph = btn?.querySelector('span');

  // 버튼의 겉모습(아이콘/레이블/aria-pressed)을 현재 테마 상태에 맞춰 갱신한다.
  // 아이콘과 문구는 "누르면 일어날 동작"을 일관되게 가리킨다:
  // 라이트 모드에선 ☾(다크로 전환), 다크 모드에선 ☀(라이트로 전환).
  function sync() {
    const dark = document.documentElement.dataset.theme === 'dark';
    if (glyph) glyph.textContent = dark ? '☀' : '☾';
    btn?.setAttribute('aria-label', dark ? '라이트 모드로 전환' : '다크 모드로 전환');
    btn?.setAttribute('aria-pressed', String(dark));
  }

  sync();
  btn?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('theme', next);
    sync();
  });
</script>
