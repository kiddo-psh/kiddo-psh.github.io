<script>
  const copyIcon = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3.43" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h8"></path></svg>';
  const checkIcon = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3.43" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5 9.5 17 19 7"></path></svg>';

  for (const block of document.querySelectorAll<HTMLPreElement>('.prose pre[data-language]')) {
    const code = block.querySelector('code');
    if (!code || !navigator.clipboard) continue;
    const frame = document.createElement('div');
    frame.className = 'code-sample';
    const copy = document.createElement('button');
    copy.className = 'code-copy';
    copy.type = 'button';
    copy.innerHTML = copyIcon;
    copy.setAttribute('aria-label', '코드 복사');
    block.before(frame);
    frame.append(block, copy);
    let reset: number;
    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(code.textContent ?? '');
        copy.innerHTML = checkIcon;
        copy.setAttribute('aria-label', '복사됨');
      } catch {
        copy.setAttribute('aria-label', '복사 실패');
      }
      clearTimeout(reset);
      reset = window.setTimeout(() => {
        copy.innerHTML = copyIcon;
        copy.setAttribute('aria-label', '코드 복사');
      }, 1800);
    });
  }
</script>
