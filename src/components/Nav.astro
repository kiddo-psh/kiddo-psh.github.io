---
import { SITE } from '../site.config';
import ThemeToggle from './ThemeToggle.astro';

const LINKS = [
  { href: '/posts', label: '글' },
  { href: '/ai-briefing', label: '브리핑' },
  { href: '/projects', label: '프로젝트' },
  { href: '/about', label: '소개' },
];

// 글 상세(/posts/…)에서도 "글"이 켜지도록 접두사까지 본다.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isOn = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header>
  <nav class="page">
    <a class="brand" href="/" aria-current={path === '/' ? 'page' : undefined}>
      {/*
        * 워드마크. 전에는 글자만 있었다 — 레퍼런스 두 곳 모두 고유 마크를 갖는데
        * 여기만 없으면 헤더가 "메뉴 줄"이지 "사이트 머리"가 아니다.
        * 글·프로젝트 마크(Motif)와 같은 언어를 쓴다 — 기하 도형 몇 개를 두 색으로.
        * 여기서는 그중 "잎" 틀 하나를 고정해 둔다: 사분원 둘을 등지고 맞댄 반원의
        * 왼쪽은 먹, 오른쏙은 강조색, 위에 작은 점. 20px에서도 색이 갈리는 반원은
        * 읽힌다. favicon.svg도 같은 그림이다.
        */}
      <svg class="mk" viewBox="0 0 32 32" width="20" height="20" aria-hidden="true" focusable="false">
        <path d="M16 25 V12 A13 13 0 0 0 3 25 Z" fill="currentColor" />
        <path d="M16 25 V12 A13 13 0 0 1 29 25 Z" class="gate" />
        <circle cx="16" cy="6" r="3" fill="currentColor" />
      </svg>
      <span>{SITE.title}</span>
    </a>
    {LINKS.map((l) => (
      <a href={l.href} class:list={[{ on: isOn(l.href) }]} aria-current={isOn(l.href) ? 'page' : undefined}>
        {l.label}
      </a>
    ))}
    <div class="right">
      <a
        href="/search"
        aria-label="검색"
        title="검색 (Ctrl/⌘ K)"
        class:list={['icon', { on: isOn('/search') }]}
      >
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
        </svg>
      </a>
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  /*
   * 헤더를 화면 위에 붙여 둔다. 글이 길어서(프로젝트 문서는 1만 픽셀이 넘는다)
   * 읽는 중에 다른 곳으로 가려면 매번 맨 위까지 돌아가야 했다.
   */
  header {
    position: sticky; top: 0; z-index: 10;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    transition: box-shadow var(--dur) var(--ease);
  }
  /* 내용이 헤더 밑을 지나가는 동안에만 그림자를 준다 — 맨 위에서는 경계선만 */
  :global(html.scrolled) header { box-shadow: 0 1px 12px rgb(35 33 29 / .06); }
  :global(html[data-theme='dark'].scrolled) header { box-shadow: 0 1px 12px rgb(0 0 0 / .4); }

  /*
   * 링크가 헤더 높이를 통째로 쓰게 해서 누를 곳을 넓힌다. 전에는 글자 높이(25px)만
   * 차지해서 "검색"이 8x25px이었다 — WCAG 2.5.8의 24x24를 못 넘긴다.
   * min-width는 "글"처럼 두 글자보다 짧은 라벨을 위한 것이다.
   */
  nav { display: flex; align-items: stretch; gap: var(--space-05); height: var(--nav-h); font-size: var(--fs-300); }
  nav a {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 24px; padding: 0 var(--space-2);
    color: var(--text-dim);
    transition: color var(--dur) var(--ease);
  }
  nav a:hover { color: var(--text); text-decoration: none; }
  /*
   * 로고는 절대 줄바꿈하지 않는다. 전역 word-break: keep-all가 걸려 있어도 flex가
   * 좁아지면 "kiddo-" / "psh"로 쪼개진다 — 하이픈이 어절 경계로 취급되기 때문이다.
   */
  .brand { color: var(--text); font-weight: 800; margin-right: var(--space-3); gap: var(--space-2); white-space: nowrap; }
  .brand .mk { display: block; flex: 0 0 auto; }
  .brand .gate { fill: var(--accent); }

  /*
   * 현재 섹션 표시. 헤더 아래 테두리 위에 액센트 막대를 겹쳐 놓는다 —
   * 글자색만 바꾸면 라이트 모드에서 hover와 구분되지 않는다.
   */
  nav a.on { color: var(--text); }
  nav a.on:not(.brand) { position: relative; font-weight: 600; }
  nav a.on:not(.brand)::after {
    content: ''; position: absolute; left: var(--space-2); right: var(--space-2); bottom: -1px;
    height: 2px; background: var(--accent);
  }

  .right { margin-left: auto; display: flex; align-items: stretch; gap: var(--space-05); }
  .icon { padding: 0 var(--space-2); }
  .icon svg { display: block; }

  /*
   * 좁아지는 순서. 글자를 먼저 줄이고(480), 그래도 모자라면 항목 사이를 붙인다(400).
   * 한 번에 둘 다 하면 430px쯤에서 "브리핑프로젝트소개"가 한 덩어리로 붙어 보인다.
   */
  @media (max-width: 480px) {
    nav { font-size: var(--fs-200); }
    nav a { padding: 0 var(--space-2); }
    .brand { margin-right: var(--space-2); gap: var(--space-2); }
  }
  @media (max-width: 400px) {
    nav { gap: 0; }
    nav a { padding: 0 var(--space-1); }
    .brand { margin-right: var(--space-1); gap: var(--space-1); }
    nav a.on:not(.brand)::after { left: var(--space-1); right: var(--space-1); }
  }
</style>

<script>
  /*
   * 검색 단축키를 전역에 둔다. 전에는 /search 안 입력창에만 "Ctrl K" 힌트가 있었고
   * 정작 단축키는 어디에도 없었다 — 이미 검색창에 들어온 사람에게만 알려주는 꼴이었다.
   */
  function focusSearchbox(): boolean {
    const box = document.querySelector('pagefind-searchbox');
    if (!box) return false;
    const input =
      box.querySelector('input') ??
      box.shadowRoot?.querySelector('input') ??
      null;
    if (!input) return false;
    input.focus();
    input.select();
    return true;
  }

  window.addEventListener('keydown', (e) => {
    if (e.key.toLowerCase() !== 'k' || !(e.ctrlKey || e.metaKey) || e.altKey) return;
    e.preventDefault();
    // 이미 검색 페이지면 입력창으로만 보낸다. 아직 커스텀 엘리먼트가 안 떴으면 이동.
    if (!focusSearchbox()) window.location.href = '/search';
  });
</script>
