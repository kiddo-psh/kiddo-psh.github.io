---
interface Props {
  backHref?: string;
  backLabel?: string;
}
const { backHref, backLabel = '뒤로' } = Astro.props;

const LINKS = [
  { href: '/posts', label: '글' },
  { href: '/projects', label: '프로젝트' },
  { href: '/portfolio', label: '포트폴리오' },
];

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isOn = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="bar">
  {backHref ? (
    <a class="back" href={backHref} aria-label={backLabel}>
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 18l-6-6 6-6"></path>
      </svg>
    </a>
  ) : (
    <a class="name" href="/" aria-current={path === '/' ? 'page' : undefined}>박시현</a>
  )}
  <nav aria-label="주 탐색">
    {LINKS.map((link) => (
      <a href={link.href} aria-current={isOn(link.href) ? 'page' : undefined}>{link.label}</a>
    ))}
  </nav>
</header>

<style>
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 36px;
  }
  .name {
    color: var(--text);
    font-size: 17px;
    font-weight: 500;
    line-height: 1.4;
    text-decoration: none;
  }
  nav { display: flex; align-items: center; gap: 16px; }
  nav a {
    color: var(--text-dim);
    font-size: 15px;
    line-height: 1.4;
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }
  nav a:hover, nav a[aria-current='page'] { color: var(--text); }
  .back {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--back);
    color: var(--text);
    text-decoration: none;
    transition: background-color var(--dur) var(--ease);
  }
  .back:hover { background: #e6eaee; }
  @media (max-width: 400px) {
    nav { gap: 12px; }
    nav a { font-size: 14px; }
  }
</style>

<script>
  function focusSearchbox(): boolean {
    const box = document.querySelector('pagefind-searchbox');
    if (!box) return false;
    const input = box.querySelector('input') ?? box.shadowRoot?.querySelector('input') ?? null;
    if (!input) return false;
    input.focus();
    input.select();
    return true;
  }

  window.addEventListener('keydown', (event) => {
    if (event.key.toLowerCase() !== 'k' || !(event.ctrlKey || event.metaKey) || event.altKey) return;
    event.preventDefault();
    if (!focusSearchbox()) window.location.href = '/search';
  });
</script>
