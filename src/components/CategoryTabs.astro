---
import { WRITING_CATEGORIES } from '../site.config';

interface Props { active: string }
const { active } = Astro.props;
---

<nav class="tabs" aria-label="글 분류">
  <a href="/posts" class:list={[{ on: active === 'all' }]} aria-current={active === 'all' ? 'page' : undefined}>전체</a>
  {WRITING_CATEGORIES.map((category) => (
    <a
      href={`/posts?category=${category.id}`}
      class:list={[{ on: active === category.id }]}
      aria-current={active === category.id ? 'page' : undefined}
    >
      {category.name}
    </a>
  ))}
</nav>

<style>
  .tabs { display: flex; flex-wrap: wrap; gap: 4px 12px; }
  a {
    color: var(--text-dim);
    font-size: 14px;
    line-height: 1.4;
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }
  a.on, a:hover { color: var(--text); }
</style>
