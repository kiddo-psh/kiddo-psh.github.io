---
import { CATEGORIES } from '../site.config';

interface Props { active: string }
const { active } = Astro.props;
---

<nav class="tabs">
  <a href="/posts" class:list={['chip', { on: active === 'all' }]}>전체</a>
  {CATEGORIES.map((c) => (
    <a href={`/posts?category=${c.id}`} class:list={['chip', { on: active === c.id }]}>
      {c.name}
    </a>
  ))}
</nav>

<style>
  /* 칩 모양은 global.css의 .chip이 담당한다 — 여기서는 배치만 */
  .tabs { display: flex; gap: var(--space-2); flex-wrap: wrap; margin-bottom: var(--space-1); }
</style>
