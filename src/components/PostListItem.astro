---
import type { Post } from '../lib/posts';
import { readingMinutes } from '../lib/posts';
import { getCategory } from '../site.config';

interface Props { post: Post; headingLevel?: 2 | 3 }
const { post, headingLevel = 3 } = Astro.props;

const cat = getCategory(post.data.category);
const date = post.data.pubDate.toISOString().slice(0, 10).replace(/-/g, '.');
const minutes = readingMinutes(post.body);
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<article class="row">
  <Heading class="title">
    <a href={`/posts/${post.id}`}>{post.data.title}</a>
  </Heading>
  <p class="meta">
    <span class="cat">{cat.label}</span>
    <span>{date}</span>
    <span>{minutes}분</span>
  </p>
</article>

<style>
  /*
   * 제목과 메타만 둔다. 이미지도, 요약문도 없다.
   * 제목이 글의 내용을 혼자 전달해야 하는 구조다.
   * description은 목록에서 빠졌을 뿐이고 공유 카드·검색 결과·메타 설명에서 계속 쓰인다.
   */
  .row { padding: 17px 0; border-bottom: 1px solid var(--border); }

  .title { margin: 0 0 6px; font-size: 1.12em; line-height: 1.45; letter-spacing: -.02em; font-weight: 700; }
  .title a { color: var(--text); text-decoration: none; }
  .title a:hover { color: var(--accent); }

  .meta { margin: 0; display: flex; gap: 10px; font-size: .78em; color: var(--text-dim); }
  .cat { color: var(--accent); font-weight: 800; letter-spacing: .1em; }
</style>
