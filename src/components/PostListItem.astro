---
import { readingMinutes, type Post } from '../lib/posts';
import { getCategory } from '../site.config';
import ArticleCover from './ArticleCover.astro';
interface Props { post: Post; variant?: 'feature' | 'row'; headingLevel?: 2 | 3; }
const { post, variant = 'row', headingLevel = 3 } = Astro.props;
const cat = getCategory(post.data.category);
const date = post.data.pubDate.toISOString().slice(0, 10).replace(/-/g, '.');
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---
<article class:list={['post-entry', variant]}>
  <div class="cover">{post.data.cover ? <img src={post.data.cover} alt="" width="1200" height="750" loading={variant === 'feature' ? 'eager' : 'lazy'} /> : <ArticleCover id={post.id} />}</div>
  <div class="body">
    <p class="category">{cat.name}</p>
    <Heading class="title"><a href={`/posts/${post.id}`}>{post.data.title}</a></Heading>
    <p class="summary">{post.data.description}</p>
    <p class="meta">{date}<span>·</span>{readingMinutes(post.body)}분 읽기</p>
  </div>
</article>
<style>
.post-entry { position:relative; display:grid; grid-template-columns:240px minmax(0,1fr); align-items:center; gap:32px; padding:30px 0; }
.cover { min-width:0; transition:transform var(--dur) var(--ease); }.cover img { display:block; width:100%; height:auto; aspect-ratio:1.6; object-fit:cover; border-radius:18px; }
.category { margin:0 0 10px; color:var(--accent); font-size:14px; font-weight:650; }
.title { margin:0; font-size:24px; font-weight:700; line-height:1.45; letter-spacing:-.035em; }.title a { color:var(--text); text-decoration:none; }.title a::after { content:''; position:absolute; inset:0; }
.post-entry:hover .title a { color:var(--accent); }.post-entry:hover .cover { transform:translateY(-3px); }
.post-entry:has(a:focus-visible) { outline:2px solid var(--accent); outline-offset:6px; border-radius:12px; }
.summary { margin:12px 0 0; color:var(--text-dim); font-size:16px; line-height:1.7; }.meta { display:flex; flex-wrap:wrap; gap:10px; margin:18px 0 0; font-size:13px; color:var(--text-dim); }
.feature { grid-template-columns:1.1fr 1fr; gap:48px; padding:0 0 48px; }.feature .title { font-size:32px; line-height:1.4; }.feature .summary { font-size:17px; }
.post-entry:not(.feature) .cover :global(.cover-label),.post-entry:not(.feature) .cover :global(.cover-footer) { display:none; }
.post-entry:not(.feature) .cover :global(.clock) { width:90px; height:90px; border-width:8px; }
.post-entry:not(.feature) .cover :global(.clock > span) { font-size:38px; }
.post-entry:not(.feature) .cover :global(.clock small) { font-size:20px; }
.post-entry:not(.feature) .cover :global(.retry-art) { transform:scale(.75); }
@media(max-width:700px) {
 .post-entry { grid-template-columns:120px minmax(0,1fr); gap:18px; padding:24px 0; }.title { font-size:19px; }.summary { display:none; }.category { font-size:12px; margin-bottom:6px; }.meta { margin-top:12px; font-size:12px; }
 .feature { grid-template-columns:1fr; gap:24px; padding:0 0 32px; }.feature .title { font-size:27px; }.feature .summary { display:block; font-size:16px; }
 .post-entry:not(.feature) .cover :global(.cover-label),.post-entry:not(.feature) .cover :global(.cover-footer) { display:none; }
 .post-entry:not(.feature) .cover :global(.clock) { width:64px; height:64px; border-width:6px; }.post-entry:not(.feature) .cover :global(.clock > span) { font-size:28px; }.post-entry:not(.feature) .cover :global(.clock small) { font-size:16px; }
 .post-entry:not(.feature) .cover :global(.retry-art),.post-entry:not(.feature) .cover :global(.flow-art) { transform:scale(.45); }
}
@media(prefers-reduced-motion:reduce) { .post-entry:hover .cover { transform:none; } }
</style>
