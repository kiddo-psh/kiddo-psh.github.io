---
import { readingMinutes, type Post } from '../lib/posts';
import { getCategory } from '../site.config';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
interface Props { post: Post; headingLevel?: 2 | 3 }
const { post, headingLevel = 3 } = Astro.props;
const date = post.data.pubDate.toISOString().slice(0, 10);
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---
<article class="entry">
  <div class="meta"><time datetime={date}>{date.replaceAll('-', '.')}</time><span>{getCategory(post.data.category).name} · {readingMinutes(post.body)}분</span></div>
  <div>
    <Heading><a href={`/posts/${post.id}/`}>{post.data.title}</a></Heading>
    <p>{post.data.description}</p>
  </div>
  <ArrowUpRight size={20} aria-hidden="true" />
</article>
<style>
  .entry { position:relative; display:grid; grid-template-columns:120px minmax(0,1fr) 24px; gap:clamp(18px,3vw,44px); align-items:start; border-top:1px solid var(--border); padding:26px 0; }
  .meta { display:grid; gap:4px; color:var(--text-dim); font-size:12px; }
  time { font-family:var(--font-mono); letter-spacing:.025em; }
  h2,h3 { margin:0; font-size:clamp(19px,1.75vw,25px); line-height:1.4; font-weight:600; letter-spacing:-.04em; }
  a { color:var(--text); }
  a::after { content:''; position:absolute; inset:0; }
  p { margin:8px 0 0; color:var(--text-dim); font-size:15px; line-height:1.65; }
  svg { margin-top:4px; color:var(--text-dim); }
  .entry:hover a { text-decoration:underline; text-underline-offset:4px; }
  @media(max-width:680px) {
    .entry { grid-template-columns:minmax(0,1fr) 20px; gap:8px; padding:22px 0; }
    .meta { display:flex; gap:12px; grid-column:1/-1; }
    p { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
  }
</style>
