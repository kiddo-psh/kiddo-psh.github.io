---
import type { Post } from '../lib/posts';
import { readingMinutes } from '../lib/posts';
import { getCategory } from '../site.config';

interface Props { post: Post; headingLevel?: 2 | 3 }
const { post, headingLevel = 3 } = Astro.props;

const cat = getCategory(post.data.category);
const date = post.data.pubDate.toISOString().slice(0, 10).replace(/-/g, '.');
const minutes = readingMinutes(post.body);
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<article class="row">
  <Heading class="title">
    <a href={`/posts/${post.id}`}>{post.data.title}</a>
  </Heading>
  <p class="meta">
    <span class="cat">{cat.label}</span>
    <span>{date}</span>
    <span>{minutes}분</span>
  </p>
</article>

<style>
  /*
   * 제목과 메타만 둔다. 이미지도, 요약문도 없다.
   * 제목이 글의 내용을 혼자 전달해야 하는 구조다.
   * description은 목록에서 빠졌을 뿐이고 공유 카드·검색 결과·메타 설명에서 계속 쓰인다.
   */
  .row { position: relative; padding: var(--space-6) 0; border-bottom: 1px solid var(--border); }

  /*
   * 행 전체를 누를 수 있게 제목 링크를 덮개로 늘린다. 제목 글자만 링크로 두면
   * 날짜·분량·행 여백을 눌러도 아무 일이 없다 — 목록에서 제일 흔한 헛클릭이다.
   * 접근성 이름은 제목 그대로 유지된다(덮개는 ::after라 읽히지 않는다).
   */
  .title a::after { content: ''; position: absolute; inset: 0; }

  /*
   * 덮개 때문에 포커스 링이 제목 글자에만 걸린다. 실제로 눌리는 건 행 전체이므로
   * 링도 행에 두어 키보드 사용자가 누를 범위를 제대로 보게 한다.
   */
  .row:has(.title a:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: var(--radius-sm); }
  .row .title a:focus-visible { outline: none; }

  /*
   * 제목을 크게 두고 메타는 그 아래에 둔다. 이 둘은 묶인 결정이다 —
   * 제목이 커지면 두 줄로 감기는 일이 잦아지고, 그때 메타를 오른쪽에 두면
   * 첫 줄 옆에 붙어 아래가 비거나 제목 폭을 깎아야 한다.
   *
   * 크기는 페이지 제목(--fs-800)보다 한 칸 아래인 --fs-700을 쓴다. 전에는 28.5px이라
   * 페이지 제목 30.4px과 2px 차이였고, 그러면 "글"과 그 안의 글 제목이 같은 급으로 읽힌다.
   */
  .title { margin: 0 0 var(--space-2); font-size: var(--fs-700); line-height: var(--lh-snug); letter-spacing: var(--ls-tight); font-weight: 700; }
  .title a { color: var(--text); text-decoration: none; transition: color var(--dur) var(--ease); }
  /* 덮개 위에서는 커서가 제목 밖에 있어도 hover다 — 행 전체가 반응하게 맞춘다 */
  .row:hover .title a { color: var(--accent); }

  .meta { margin: 0; display: flex; gap: var(--space-3); font-size: var(--fs-300); color: var(--text-dim); }
  .cat { color: var(--accent); font-weight: 800; letter-spacing: var(--ls-label); }

  @media (max-width: 640px) {
    .title { font-size: var(--fs-600); }
  }
</style>
