---
import type { CollectionEntry } from 'astro:content';
import ArrowRight from '@lucide/astro/icons/arrow-right';
interface Props { project: CollectionEntry<'projects'>; number: string; }
const { project, number } = Astro.props;
const d=project.data;
---
<article class="project-entry">
  <div class="body">
    <p class="eyebrow"><span>{number}</span>{d.title}</p>
    <h2><a href={`/projects/${project.id}/`}>{d.headline}</a></h2>
    <p class="summary">{d.summary}</p>
    <div class="facts">
      <p><span>담당</span>{d.cardRole}</p>
      <p><span>검증</span>{d.validation}</p>
    </div>
    <div class="footer"><p class="metadata">{d.period}</p><a class="read-more" href={`/projects/${project.id}/`}>사례 자세히 보기<ArrowRight size={16} /></a></div>
  </div>
</article>
<style>
  .project-entry { border-top:1px solid var(--border); padding:30px 0 32px; }
  .body { max-width:780px; }
  .eyebrow { display:flex; gap:10px; margin:0 0 9px; color:var(--text-dim); font-size:12px; line-height:1.5; }
  .eyebrow > span { min-width:22px; color:var(--accent); font-variant-numeric:tabular-nums; font-weight:700; }
  h2 { margin:0 0 8px; font-size:24px; line-height:1.45; letter-spacing:-.035em; font-weight:700; }
  h2 a { color:var(--text); text-decoration:none; }
  h2 a:hover { color:var(--accent); }
  .summary { max-width:68ch; margin:0 0 16px; color:var(--text-dim); font-size:14px; line-height:1.75; }
  .facts { display:grid; grid-template-columns:1fr 1.2fr; gap:10px 28px; }
  .facts p { display:grid; grid-template-columns:36px minmax(0,1fr); gap:9px; margin:0; font-size:13px; line-height:1.65; }
  .facts p > span { color:var(--text); font-weight:650; }
  .facts p:last-child { color:var(--text-dim); }
  .footer { display:flex; align-items:center; justify-content:space-between; gap:16px; margin-top:14px; }
  .metadata { margin:0; color:var(--text-dim); font-size:12px; line-height:1.6; }
  .read-more { display:inline-flex; align-items:center; gap:7px; color:var(--accent); font-size:13px; font-weight:650; white-space:nowrap; }
  @media(max-width:700px) {
    .project-entry { padding:24px 0; }
    h2 { font-size:22px; }
    .facts { grid-template-columns:1fr; gap:6px; }
    .footer { align-items:flex-start; flex-direction:column; gap:8px; }
  }
</style>
