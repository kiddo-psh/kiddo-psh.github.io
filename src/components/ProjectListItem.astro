---
import type { CollectionEntry } from 'astro:content';
import ArrowRight from '@lucide/astro/icons/arrow-right';
interface Props { project: CollectionEntry<'projects'>; number: string; focus: string; }
const { project, number, focus } = Astro.props;
const d=project.data;
---
<article class="project-entry">
  <div class="visual">
    {d.cover && <img src={d.cover} alt="" width="1200" height="750" loading={number === '01' ? 'eager' : 'lazy'} decoding="async" />}
  </div>
  <div class="body">
    <p class="focus"><span>{number}</span>{focus}</p>
    <h2><a href={`/projects/${project.id}/`}>{d.title}</a></h2>
    <p class="headline">{d.headline}</p>
    <p class="summary">{d.summary}</p>
    <dl>
      <div><dt>직접 맡은 일</dt><dd>{d.cardRole}</dd></div>
      <div><dt>확인한 결과</dt><dd>{d.validation}</dd></div>
    </dl>
    <p class="metadata">{d.projectType}<span>{d.period}</span></p>
    <span class="read-more" aria-hidden="true">설계와 검증 읽기<ArrowRight size={16} /></span>
  </div>
</article>
<style>
  .project-entry { position:relative; display:grid; grid-template-columns:minmax(0,.85fr) minmax(0,1.4fr); gap:36px; padding:36px 0; border-top:1px solid var(--border); align-items:start; }
  .visual { overflow:hidden; background:var(--code-bg); border-radius:16px; aspect-ratio:1.6; }
  .visual img { display:block; width:100%; height:auto; transition:transform var(--dur) var(--ease); }
  .focus { display:flex; gap:12px; margin:0 0 12px; color:var(--accent); font-size:12px; font-weight:650; }
  .focus > span { font-variant-numeric:tabular-nums; }
  h2 { margin:0 0 12px; font-size:28px; line-height:1.4; letter-spacing:-.035em; font-weight:700; }
  h2 a { color:var(--text); text-decoration:none; }h2 a::after { content:''; position:absolute; inset:0; }
  .project-entry:hover h2 a { color:var(--accent); }.project-entry:hover .visual img { transform:scale(1.025); }
  .project-entry:has(h2 a:focus-visible) { outline:2px solid var(--accent); outline-offset:6px; border-radius:10px; }
  .headline { margin:0 0 12px; font-size:17px; font-weight:600; line-height:1.65; letter-spacing:-.02em; }
  .summary { margin:0 0 20px; font-size:14px; color:var(--text-dim); line-height:1.85; }
  dl { margin:0; padding:16px 18px; background:var(--code-bg); border-radius:12px; }
  dl > div { display:grid; grid-template-columns:78px minmax(0,1fr); gap:12px; font-size:13px; line-height:1.75; }
  dl > div + div { margin-top:8px; }dt { font-weight:600; }dd { margin:0; color:var(--text-dim); }
  .metadata { margin:16px 0; font-size:12px; line-height:1.8; color:var(--text-dim); }.metadata span { display:block; }
  .read-more { display:inline-flex; align-items:center; gap:8px; color:var(--accent); font-size:13px; font-weight:650; }
  @media(max-width:700px) {
    .project-entry { grid-template-columns:1fr; gap:24px; padding:28px 0; }
    h2 { font-size:25px; }.headline { font-size:16px; }.visual { max-width:100%; }
    dl { padding:14px 16px; }dl > div { grid-template-columns:72px minmax(0,1fr); gap:8px; }
  }
  @media(prefers-reduced-motion:reduce) { .project-entry:hover .visual img { transform:none; } }
</style>
