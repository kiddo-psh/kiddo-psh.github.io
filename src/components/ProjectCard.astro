---
import type { CollectionEntry } from 'astro:content';

interface Props { project: CollectionEntry<'projects'>; headingLevel?: 2 | 3 }
const { project, headingLevel = 3 } = Astro.props;
const d = project.data;
const Tag = `h${headingLevel}` as 'h2' | 'h3';
---

<a class="card" href={`/projects/${project.id}/`}>
  <span class="project-type">{d.title}</span>
  <Tag class="ttl">{d.headline}</Tag>
  <span class="sum">{d.summary}</span>
</a>

<style>
  .card {
    display:block;
    min-width:0;
    padding:clamp(20px,2.2vw,32px); background:var(--code-bg); border-radius:14px;
    border:1px solid transparent;
    color:var(--text);
    transition:border-color var(--dur) var(--ease);
  }
  .card:hover { border-color:var(--accent); text-decoration:none; }
  .project-type { display:block; margin-bottom:10px; color:var(--text-dim); font-size: 0.75rem; line-height:1.5; }
  .ttl { margin:0 0 9px; font-family:var(--font-sans); font-size: 1.25rem; font-weight:650; letter-spacing:-0.015em; line-height:1.3; }
  .card:hover .ttl { color:var(--accent); }
  .sum { display:-webkit-box; overflow:hidden; -webkit-box-orient:vertical; -webkit-line-clamp:2; color:var(--text-dim); font-size: 0.875rem; line-height:1.7; }
  @media(max-width:700px) { .card { padding:22px; }.ttl { font-size: 1.1875rem; } }
</style>
