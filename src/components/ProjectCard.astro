---
import type { CollectionEntry } from 'astro:content';
import MetricsTable from './MetricsTable.astro';

interface Props { project: CollectionEntry<'projects'>; headingLevel?: 2 | 3 }
const { project, headingLevel = 3 } = Astro.props;
const d = project.data;
const Tag = `h${headingLevel}` as 'h2' | 'h3';
---

<a class="card" href={`/projects/${project.id}`}>
  <Tag>{d.title}</Tag>
  <p class="sum">{d.summary}</p>
  <MetricsTable metrics={d.metrics} compact />
  <div class="stack">{d.stack.join(' · ')}</div>
</a>

<style>
  /* 카드가 넓어졌으므로 제목과 여백을 그에 맞춰 키운다 */
  .card {
    display: block; border: 1px solid var(--border); border-radius: 12px;
    padding: 24px; background: var(--bg-elev); color: var(--text);
    transition: border-color .15s;
  }
  .card:hover { border-color: var(--accent); text-decoration: none; }
  h2, h3 { margin: 0 0 8px; font-size: 1.18em; font-weight: 700; letter-spacing: -.02em; }
  .card:hover h2, .card:hover h3 { color: var(--accent); }
  .sum { margin: 0 0 16px; color: var(--text-dim); font-size: .92em; line-height: 1.6; }
  .stack { margin-top: 16px; font-size: .78em; color: var(--text-dim); }
</style>
