---
import type { CollectionEntry } from 'astro:content';

interface Props { project: CollectionEntry<'projects'>; headingLevel?: 2 | 3 }
const { project, headingLevel = 3 } = Astro.props;
const d = project.data;
const Tag = `h${headingLevel}` as 'h2' | 'h3';
---

<a class="card" href={`/projects/${project.id}/`}>
  <span class="project-type">{d.title}</span>
  <Tag class="ttl">{d.headline}</Tag>
  <span class="sum">{d.summary}</span>
</a>

<style>
  .card {
    display:block;
    min-width:0;
    padding:22px 8px 24px 0;
    border-top:1px solid var(--border);
    color:var(--text);
    transition:border-color var(--dur) var(--ease);
  }
  .card:hover { border-color:var(--accent); text-decoration:none; }
  .project-type { display:block; margin-bottom:10px; color:var(--text-dim); font-size:12px; line-height:1.5; }
  .ttl { margin:0 0 9px; font-family:var(--font-sans); font-size:20px; font-weight:700; letter-spacing:-.03em; line-height:1.45; }
  .card:hover .ttl { color:var(--accent); }
  .sum { display:-webkit-box; overflow:hidden; -webkit-box-orient:vertical; -webkit-line-clamp:2; color:var(--text-dim); font-size:14px; line-height:1.7; }
  @media(max-width:700px) { .card { padding:18px 0 20px; }.ttl { font-size:19px; } }
</style>
