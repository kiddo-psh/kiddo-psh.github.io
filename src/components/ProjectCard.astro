---
import type { CollectionEntry } from 'astro:content';

interface Props { project: CollectionEntry<'projects'>; headingLevel?: 2 | 3 }
const { project, headingLevel = 3 } = Astro.props;
const d = project.data;
const Tag = `h${headingLevel}` as 'h2' | 'h3';

/*
 * 틴트는 order로 정한다 — 렌더 순서가 아니라 작성자가 정한 값이라, 홈과 /projects에서
 * 같은 프로젝트가 같은 색을 갖는다. 렌더 인덱스로 하면 두 페이지에서 색이 달라진다.
 */
const TONES = ['a', 'b', 'c', 'd'] as const;
const tone = TONES[((d.order - 1) % TONES.length + TONES.length) % TONES.length];
---

<a class:list={['card', `t-${tone}`]} href={`/projects/${project.id}`}>
  <Tag>{d.title}</Tag>
  <p class="sum">{d.summary}</p>
</a>

<style>
  /*
   * 카드 전체가 틴트다. 성과 지표와 기술 스택은 상세 페이지에만 두고,
   * 카드는 제목과 설명만 담는다.
   */
  .card {
    display: block;
    border: 1px solid var(--border); border-radius: var(--radius-xl);
    padding: var(--space-8) var(--space-7);
    color: var(--text);
    transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .card:hover { border-color: var(--accent); transform: translateY(-2px); text-decoration: none; }

  .t-a { background: var(--pj-a); }
  .t-b { background: var(--pj-b); }
  .t-c { background: var(--pj-c); }
  .t-d { background: var(--pj-d); }

  h2, h3 {
    margin: 0 0 var(--space-3); font-size: var(--fs-600); font-weight: 700;
    letter-spacing: var(--ls-snug); line-height: var(--lh-snug);
    transition: color var(--dur) var(--ease);
  }
  .card:hover h2, .card:hover h3 { color: var(--accent); }
  .sum { margin: 0; color: var(--text-dim); font-size: var(--fs-400); line-height: var(--lh-normal); }
</style>
