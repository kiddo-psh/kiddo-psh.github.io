---
import type { MarkdownHeading } from 'astro';

interface Props { headings: MarkdownHeading[] }
const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{items.length > 0 && (
  <nav class="toc" aria-label="목차">
    <p class="ttl">목차</p>
    <ul>
      {items.map((h) => (
        <li class:list={[{ sub: h.depth === 3 }]}>
          <a href={`#${h.slug}`}>{h.text}</a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  /* 상단 내비게이션이 고정되어 있지 않으므로 sticky 여백은 작게 둔다 */
  .toc { position: sticky; top: 32px; font-size: .88em; line-height: 1.55; }
  .ttl { margin: 0 0 12px; font-weight: 800; font-size: .88em; letter-spacing: .06em; color: var(--text-dim); }
  ul { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--border); }
  li { padding: 0; }
  /* 항목이 두 줄로 감기는 것을 전제로 위아래 여백을 넉넉히 둔다 */
  li a { display: block; padding: 8px 0 8px 14px; color: var(--text-dim); border-left: 2px solid transparent; margin-left: -1px; }
  li a:hover { color: var(--text); text-decoration: none; }
  li a.on { color: var(--accent); font-weight: 700; border-left-color: var(--accent); }
  li.sub a { padding-left: 26px; font-size: .95em; }
</style>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('.toc a');
  if (links.length) {
    const bySlug = new Map<string, HTMLAnchorElement>();
    links.forEach((a) => bySlug.set(decodeURIComponent(a.hash.slice(1)), a));

    const active = new Set<Element>();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => (e.isIntersecting ? active.add(e.target) : active.delete(e.target)));
        let pick: Element | null = null;
        if (active.size) {
          pick = [...active].reduce((a, b) =>
            a.getBoundingClientRect().top < b.getBoundingClientRect().top ? a : b);
        } else {
          // nothing in the band: the nearest heading above the reading line
          document.querySelectorAll('.prose h2, .prose h3').forEach((h) => {
            if (h.getBoundingClientRect().top < 70) pick = h;
          });
        }
        links.forEach((a) => {
          a.classList.remove('on');
          a.removeAttribute('aria-current');
        });
        const on = pick ? bySlug.get(pick.id) : undefined;
        if (on) {
          on.classList.add('on');
          on.setAttribute('aria-current', 'true');
        }
      },
      { rootMargin: '-70px 0px -70% 0px' },
    );

    document.querySelectorAll('.prose h2, .prose h3').forEach((h) => observer.observe(h));
  }
</script>
