---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListRow from '../../components/ListRow.astro';
import CategoryTabs from '../../components/CategoryTabs.astro';
import { getVisiblePosts } from '../../lib/posts';
import { dotDate } from '../../lib/format';

const posts = await getVisiblePosts();
---

<BaseLayout title="글" description="CS, 기술, AI 개발, 회고">
  <section class="block" aria-labelledby="posts-title">
    <div class="sec-row">
      <h1 id="posts-title" class="sec-title">글</h1>
      <CategoryTabs active="all" />
    </div>
    <ul id="list" class="list">
      {posts.map((post) => (
        <li data-category={post.data.category}>
          <ListRow href={`/posts/${post.id}/`} title={post.data.title} meta={dotDate(post.data.pubDate)} />
        </li>
      ))}
    </ul>
    <p id="empty" class="empty" hidden>이 분류에 아직 글이 없습니다.</p>
  </section>
</BaseLayout>

<script>
  function applyFilter() {
    const wanted = new URLSearchParams(location.search).get('category');
    let shown = 0;
    for (const cell of document.querySelectorAll<HTMLElement>('#list [data-category]')) {
      cell.hidden = Boolean(wanted) && cell.dataset.category !== wanted;
      if (!cell.hidden) shown++;
    }
    const empty = document.getElementById('empty');
    if (empty) empty.hidden = shown > 0;
    for (const link of document.querySelectorAll<HTMLAnchorElement>('.tabs a')) {
      const selected = (new URL(link.href).searchParams.get('category') ?? null) === wanted
        || (!wanted && !new URL(link.href).searchParams.get('category'));
      link.classList.toggle('on', selected);
      if (selected) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    }
  }
  applyFilter();
  window.addEventListener('pageshow', applyFilter);
</script>
