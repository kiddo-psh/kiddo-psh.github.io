---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListRow from '../../components/ListRow.astro';
import { glyph, oneLine } from '../../lib/format';
import { sortProjects } from '../../lib/projects';

const projects = sortProjects(await getCollection('projects'));
---

<BaseLayout title="프로젝트" description="현장 영상 처리, AI 코칭, 개발 도구와 인증·연동. 직접 맡은 문제와 설계 선택, 검증 결과를 프로젝트별로 기록합니다.">
  <section class="block" aria-labelledby="projects-title">
    <h1 id="projects-title" class="sec-title">프로젝트</h1>
    <ul class="list">
      {projects.map((project) => (
        <li>
          <ListRow
            href={`/projects/${project.id}/`}
            title={project.data.title}
            meta={oneLine(project.data.summary)}
            mark={glyph(project.data.title)}
          />
        </li>
      ))}
    </ul>
    <p class="note">팀 프로젝트는 직접 맡은 범위와 팀 성과를 구분하고, 측정 결과에는 확인한 조건을 함께 남깁니다.</p>
  </section>
</BaseLayout>
