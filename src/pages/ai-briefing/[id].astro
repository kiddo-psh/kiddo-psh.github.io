---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  briefings,
  briefingLabels,
  briefingTagLabels,
  bodyLabels,
  type Briefing,
} from '../../lib/briefings';
import BackLink from '../../components/BackLink.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';

export function getStaticPaths() {
  return briefings.map((item) => ({
    params: { id: item.id },
    props: { item },
  }));
}

const { item } = Astro.props as { item: Briefing };
const label = bodyLabels[item.type];

/*
 * 같은 주제 태그를 하나라도 공유하는 다른 브리핑. 전에는 이 페이지 끝이
 * 출처 박스로 끝나서 다음에 볼 것이 없었다 — 상단 뒤로 가기만이 유일한 출구였다.
 */
const others = briefings
  .filter((b) => b.id !== item.id)
  .map((b) => ({ b, shared: b.tags.filter((t) => item.tags.includes(t)).length }))
  .sort((a, c) => c.shared - a.shared || c.b.publishedAt.localeCompare(a.b.publishedAt))
  .slice(0, 3)
  .map(({ b }) => ({
    href: `/ai-briefing/${b.id}`,
    label: b.title,
    meta: `${briefingLabels[b.type]} · ${b.publishedAt.replaceAll('-', '.')}`,
  }));
---

<BaseLayout title={item.title} description={item.preview}>
  <article class="page w-doc briefing-detail">
    <BackLink href="/ai-briefing" label="AI 브리핑" />

    <header>
      <div class="meta">
        <span class="type">{briefingLabels[item.type]}</span>
        <span>{item.source}</span>
        <time datetime={item.publishedAt}>{item.publishedAt.replaceAll('-', '.')}</time>
      </div>
      <h1 class="serif">{item.title}</h1>
      {/* 태그는 목록으로 되돌아가는 문이다. 장식으로 두면 여기서 길이 끊긴다 */}
      <div class="tags" aria-label="주제 태그">
        {item.tags.map((tag) => (
          <a href={`/ai-briefing?q=${encodeURIComponent(briefingTagLabels[tag])}`}>{briefingTagLabels[tag]}</a>
        ))}
      </div>
      <p class="lead">{item.preview}</p>
      {/*
        * 무엇을 근거로 정리했는지는 본문이 아니라 여기 한 줄로 둔다. 전에는 이 문장이
        * "근거와 한계" 항목으로 본문에 들어가 있었는데, 세 건이 전부 "일부만 봤다 ·
        * 아직 검증 안 됐다"로 같아져서 자료 얘기가 아니라 면책조항이 됐다.
        */}
      <p class="basis">AI가 {item.basis}에서 정리 · {item.generatedAt.replaceAll('-', '.')}</p>
    </header>

    {/*
      * 본문 세 칸. 칸 이름은 자료 형식을 따른다(lib/briefings의 bodyLabels).
      * 다 말하지 않는 것이 이 양식의 목적이다 — 마지막 칸은 요약이 답하지 못하는
      * 자리이고, 원문 링크가 바로 그 밑에 붙는다.
      */}
    <section class="body" aria-label="요약">
      <div class="block">
        <h2>{label.what}</h2>
        <p>{item.body.what}</p>
      </div>

      <div class="block">
        <h2>{label.concrete}</h2>
        <p>{item.body.concrete}</p>
      </div>

      {/*
        * 원문 문장 인용. 본문을 통째로 번역해 싣는 것은 2차적저작물이라 저작권자의
        * 허락이 필요하지만, 한두 문장 인용은 허용되고 요약만 있을 때보다 근거를
        * 직접 보여 준다. 앞으로 게시되는 모든 브리핑에 이 근거가 함께 붙는다.
        */}
      <figure class="quote">
        <blockquote>{item.quote.text}</blockquote>
        {/* 국내 글은 인용이 이미 한국어라 풀이가 원문과 같다. 같은 문장을 두 번 보이지 않는다 */}
        {item.quote.ko !== item.quote.text && <p class="quote-ko">{item.quote.ko}</p>}
        <figcaption>{item.source} · {item.quote.where}</figcaption>
      </figure>
    </section>

    <section class="open" aria-label={label.open}>
      <h2>{label.open}</h2>
      <p>{item.body.open}</p>
      <p class="go-row">
        <a class="go" href={item.sourceUrl} target="_blank" rel="noopener noreferrer">
          원문 읽기 <span aria-hidden="true">↗</span>
        </a>
        <span class="go-src">{item.source}</span>
      </p>
    </section>

    <RelatedLinks title="다른 브리핑" links={others} />
  </article>
</BaseLayout>

<style>
  .briefing-detail { padding-top: var(--space-8); padding-bottom: var(--space-20); }
  header { padding-bottom: var(--space-7); border-bottom: 1px solid var(--border); }
  .meta { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-3); align-items: center; color: var(--text-dim); font-size: var(--fs-200); }
  .meta span + span::before, .meta time::before { content: '·'; margin-right: var(--space-3); color: var(--border); }
  .meta .type { color: var(--accent); font-weight: 800; }
  h1 { margin: var(--space-4) 0 var(--space-4); font-size: var(--fs-title); line-height: var(--lh-tight); letter-spacing: var(--ls-tight); }

  .tags { display: flex; flex-wrap: wrap; gap: var(--space-1); }
  .tags a {
    padding: var(--space-05) var(--space-2); border-radius: var(--radius-sm);
    background: var(--accent-soft); color: var(--accent);
    font-size: var(--fs-100); font-weight: 700;
  }
  .tags a:hover { text-decoration: none; filter: brightness(.94); }

  .lead { margin: var(--space-6) 0 0; color: var(--text-dim); font-size: var(--fs-400); line-height: var(--lh-relaxed); }
  .basis { margin: var(--space-4) 0 0; color: var(--text-dim); font-size: var(--fs-200); line-height: var(--lh-normal); }

  /* ── 요약 두 칸 ───────────────────────────────────────────────── */
  .block { padding: var(--space-7) 0; border-bottom: 1px solid var(--border); }
  .block h2 { margin: 0 0 var(--space-3); font-size: var(--fs-400); letter-spacing: var(--ls-snug); }
  .block p { margin: 0; line-height: var(--lh-relaxed); }

  .quote {
    margin: var(--space-7) 0 0; padding: var(--space-5) var(--space-6);
    border-radius: var(--radius-md); background: var(--code-bg);
  }
  .quote blockquote { margin: 0; font-size: var(--fs-400); line-height: var(--lh-relaxed); }
  .quote-ko { margin: var(--space-3) 0 0; color: var(--text-dim); font-size: var(--fs-300); line-height: var(--lh-relaxed); }
  .quote figcaption { margin-top: var(--space-3); color: var(--text-dim); font-size: var(--fs-200); }

  /*
   * 마지막 칸. 여기가 원문으로 가는 자리라 링크를 안에 둔다 — 빈자리를 말한
   * 문단과 그 빈자리를 채우는 링크가 떨어져 있으면 둘이 이어지지 않는다.
   */
  .open {
    margin-top: var(--space-8); padding: var(--space-7);
    border: 1px solid var(--border); border-left: 3px solid var(--accent);
    border-radius: var(--radius-lg); background: var(--bg-elev);
  }
  .open h2 { margin: 0 0 var(--space-3); font-size: var(--fs-500); letter-spacing: var(--ls-snug); line-height: var(--lh-snug); }
  .open p { margin: 0; line-height: var(--lh-relaxed); }
  /* 어디로 가는지는 버튼 옆에 둔다 — 출처 이름을 버튼에 넣으면 "arXiv · EchoPath (Zhao 외)에서 읽기"가 된다 */
  .go-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); margin: var(--space-5) 0 0; }
  .go-src { color: var(--text-dim); font-size: var(--fs-200); }
  .go {
    display: inline-block;
    padding: var(--space-2) var(--space-4); border-radius: var(--radius-md);
    background: var(--accent); color: var(--bg);
    font-size: var(--fs-300); font-weight: 800;
    transition: filter var(--dur) var(--ease);
  }
  .go:hover { text-decoration: none; filter: brightness(1.08); }

  @media (max-width: 600px) {
    .briefing-detail { padding-top: var(--space-6); padding-bottom: var(--space-16); }
    .open { padding: var(--space-5); }
  }
</style>
