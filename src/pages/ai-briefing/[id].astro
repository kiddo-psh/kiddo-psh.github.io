---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  briefings,
  briefingLabels,
  briefingTagLabels,
  bodyLabels,
  type Briefing,
} from '../../lib/briefings';
import RelatedLinks from '../../components/RelatedLinks.astro';

export function getStaticPaths() {
  return briefings.map((item) => ({
    params: { id: item.id },
    props: { item },
  }));
}

const { item } = Astro.props as { item: Briefing };
const label = bodyLabels[item.type];

/*
 * 같은 주제 태그를 하나라도 공유하는 다른 브리핑. 전에는 이 페이지 끝이
 * 출처 박스로 끝나서 다음에 볼 것이 없었다 — 상단 뒤로 가기만이 유일한 출구였다.
 */
const others = briefings
  .filter((b) => b.id !== item.id)
  .map((b) => ({ b, shared: b.tags.filter((t) => item.tags.includes(t)).length }))
  .sort((a, c) => c.shared - a.shared || c.b.publishedAt.localeCompare(a.b.publishedAt))
  .slice(0, 3)
  .map(({ b }) => ({
    href: `/ai-briefing/${b.id}`,
    label: b.title,
    meta: `${briefingLabels[b.type]} · ${b.publishedAt.replaceAll('-', '.')}`,
  }));
---

<BaseLayout title={item.title} description={item.preview} backHref="/ai-briefing" backLabel="AI 브리핑">
  <article class="briefing-detail">
    <header class="doc-head">
      <h1>{item.title}</h1>
      <p class="meta">
        <span>{briefingLabels[item.type]}</span>
        <span>{item.source}</span>
        <time datetime={item.publishedAt}>{item.publishedAt.replaceAll('-', '.')}</time>
      </p>
      {/* 태그는 목록으로 되돌아가는 문이다. 장식으로 두면 여기서 길이 끊긴다 */}
      <div class="tags" aria-label="주제 태그">
        {item.tags.map((tag) => (
          <a href={`/ai-briefing?q=${encodeURIComponent(briefingTagLabels[tag])}`}>{briefingTagLabels[tag]}</a>
        ))}
      </div>
      <p class="lead">{item.preview}</p>
      {/*
        * 무엇을 근거로 정리했는지는 본문이 아니라 여기 한 줄로 둔다. 전에는 이 문장이
        * "근거와 한계" 항목으로 본문에 들어가 있었는데, 세 건이 전부 "일부만 봤다 ·
        * 아직 검증 안 됐다"로 같아져서 자료 얘기가 아니라 면책조항이 됐다.
        */}
      <p class="basis">AI가 {item.basis}에서 정리 · {item.generatedAt.replaceAll('-', '.')}</p>
    </header>

    {/*
      * 본문 세 칸. 칸 이름은 자료 형식을 따른다(lib/briefings의 bodyLabels).
      * 다 말하지 않는 것이 이 양식의 목적이다 — 마지막 칸은 요약이 답하지 못하는
      * 자리이고, 원문 링크가 바로 그 밑에 붙는다.
      */}
    <section class="body" aria-label="요약">
      <div class="block">
        <h2>{label.what}</h2>
        <p>{item.body.what}</p>
      </div>

      <div class="block">
        <h2>{label.concrete}</h2>
        <p>{item.body.concrete}</p>
      </div>

      {/*
        * 원문 문장 인용. 본문을 통째로 번역해 싣는 것은 2차적저작물이라 저작권자의
        * 허락이 필요하지만, 한두 문장 인용은 허용되고 요약만 있을 때보다 근거를
        * 직접 보여 준다. 앞으로 게시되는 모든 브리핑에 이 근거가 함께 붙는다.
        */}
      <figure class="quote">
        <blockquote>{item.quote.text}</blockquote>
        {/* 국내 글은 인용이 이미 한국어라 풀이가 원문과 같다. 같은 문장을 두 번 보이지 않는다 */}
        {item.quote.ko !== item.quote.text && <p class="quote-ko">{item.quote.ko}</p>}
        <figcaption>{item.source} · {item.quote.where}</figcaption>
      </figure>
    </section>

    <section class="open" aria-label={label.open}>
      <h2>{label.open}</h2>
      <p>{item.body.open}</p>
      <p class="go-row">
        <a class="go" href={item.sourceUrl} target="_blank" rel="noopener noreferrer">
          원문 읽기 <span aria-hidden="true">↗</span>
        </a>
        <span class="go-src">{item.source}</span>
      </p>
    </section>

    <RelatedLinks title="다른 브리핑" links={others} />
  </article>
</BaseLayout>

<style>
  .meta { display: flex; flex-wrap: wrap; gap: 4px 0; margin-top: 8px; color: var(--text-dim); font-size: 13px; }
  .meta span + span::before, .meta time::before { content: '·'; margin: 0 8px; color: var(--hair); }
  .tags { display: flex; flex-wrap: wrap; gap: 8px 12px; margin-top: 14px; }
  .tags a {
    color: var(--text-dim); font-size: 13px;
    text-decoration: underline; text-decoration-color: var(--link-line); text-underline-offset: 3px;
  }
  .tags a:hover { color: var(--text); text-decoration-color: var(--text); }
  .lead { margin: 18px 0 0; color: var(--text-body); font-size: 17px; line-height: 1.625; }
  .basis { margin: 10px 0 0; color: var(--text-dim); font-size: 13px; line-height: 1.6; }
  .block { margin-top: 28px; padding-top: 16px; border-top: 1px solid var(--hair); }
  .block h2 { margin: 0 0 8px; color: var(--text); font-size: 17px; font-weight: 550; }
  .block p { margin: 0; color: var(--text-body); font-size: 17px; line-height: 1.625; }
  .quote { margin: 28px 0 0; padding: 2px 0 2px 16px; border-left: 2px solid var(--hair); }
  .quote blockquote { margin: 0; color: var(--text-dim); font-size: 17px; font-weight: 400; line-height: 1.625; }
  .quote-ko { margin: 10px 0 0; color: var(--text-dim); font-size: 15px; line-height: 1.65; }
  .quote figcaption { margin-top: 10px; color: var(--text-dim); font-size: 13px; }
  .open { margin-top: 64px; }
  .open h2 {
    margin: 0 0 12px; padding-top: 16px; border-top: 1px solid var(--hair);
    color: var(--text); font-size: 17px; font-weight: 550;
  }
  .open p { margin: 0; color: var(--text-body); font-size: 17px; line-height: 1.625; }
  .go-row { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 12px; margin-top: 14px; }
  .go {
    color: inherit; font-size: 15px;
    text-decoration: underline; text-decoration-color: var(--link-line); text-underline-offset: 3px;
  }
  .go:hover { text-decoration-color: var(--text); }
  .go-src { color: var(--text-dim); font-size: 13px; }
</style>
