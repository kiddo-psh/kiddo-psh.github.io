/*
 * 협업 경험. 프로젝트 섹션이 "혼자 재고 고친 것"이라면 여기는 "팀에서 생긴 문제를
 * 어떻게 읽었는가"다. 내용은 회고 글에 있으니 여기는 문제와 바꾼 것 두 줄만 두고 글로 보낸다.
 */
interface Retro { href: string; title: string; story: string; lesson: string; next?: { href: string; label: string } }
const retros: Retro[] = [
  {
    href: '/posts/claude-code-retrospective',
    title: '같은 Claude Code를 썼는데 왜 코드는 달랐을까',
