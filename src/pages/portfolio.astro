---
import BaseLayout from '../layouts/BaseLayout.astro';
import ListRow from '../components/ListRow.astro';
import { SITE } from '../site.config';
import { glyph } from '../lib/format';
import { portfolioCases as cases, highlights, skills, education, awards, certificates, otherProjects } from '../data/portfolio';
import { inline as inlineSvg } from '../lib/inline-svg.mjs';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Mail from '@lucide/astro/icons/mail';
import Printer from '@lucide/astro/icons/printer';

/*
 * 포트폴리오. 제출한 이력서와 같은 내용·순서를 쓰고, 화면에서는 블로그의 공통 색상을 사용한다.
 * 프로젝트마다 개요(소개·담당·숫자·화면)와 문제 해결 사례 두 개(상황 → 해결 → 성과)를 한 열로 쌓는다.
 * 보조 글은 숫자를 다르게 읽게 만드는 것만 둔다. 나머지 설명은 프로젝트 상세 페이지에 있다.
 */

// **강조**만 허용한다. 나머지는 이스케이프해서 데이터의 꺾쇠가 마크업이 되지 않게 한다
const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const rich = (s: string) => escape(s).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
const pct = (v: number, max: number) => `${Math.max(2, (v / max) * 100)}%`;
---
<BaseLayout title="박시현 · 포트폴리오" description="문제를 측정 가능한 기준으로 정의하고, 평가셋과 계측 도구로 AI 시스템의 설계 판단을 검증한 박시현의 프로젝트를 소개합니다.">
  <div class="page pf">
    <header class="pf-head">
      <img class="pf-photo" src="/images/profile.jpg" alt="박시현 증명사진" width="480" height="617" decoding="async" />
      <div class="pf-head-text">
        <p class="pf-name">박시현</p>
        <h1>문제를 측정 가능한 기준으로 정의하고, <br />AI가 현장의 제약 안에서 동작하는지 검증합니다.</h1>
        <p class="pf-intro">평가셋과 계측 도구를 직접 만들어 설계 판단을 숫자로 확인합니다.</p>
        <p class="pf-status">SSAFY 15기 (2026.12 수료 예정) · 경희대학교 생체의공학과</p>
        <div class="pf-contact">
          <a href={`mailto:${SITE.links.email}`}><Mail size={16} />{SITE.links.email}</a>
          <a href={SITE.links.github} target="_blank" rel="noopener noreferrer">GitHub<ArrowUpRight size={15} /></a>
          <button type="button" id="portfolio-print"><Printer size={15} />PDF로 저장</button>
        </div>
      </div>
    </header>

    <section class="pf-section" aria-labelledby="highlights-title">
      <h2 id="highlights-title" class="pf-label">대표 성과</h2>
      <ul class="highlights">
        {highlights.map(h => (
          <li><a href={h.href}><span class="h-label">{h.label}</span><strong>{h.value}</strong><span class="h-from">{h.from}</span></a></li>
        ))}
      </ul>
    </section>

    <section class="pf-section" aria-labelledby="projects-title">
      <h2 id="projects-title" class="pf-label">프로젝트</h2>
      <ul class="list">
        {cases.map(p => (
          <li><ListRow href={`#${p.id}`} title={p.title} meta={p.summary} mark={glyph(p.title)} logo={p.logo} /></li>
        ))}
      </ul>

      {cases.map(p => (
        <article class="case" id={p.id} aria-labelledby={`${p.id}-title`}>
          <header class="case-head">
            <h3 id={`${p.id}-title`}><span class="case-num">{p.number}</span>{p.title}</h3>
            <span class="case-date">{p.period}</span>
          </header>

          <p class="case-summary">{p.summary}</p>
          <p class="case-meta"><span>{p.team}</span>{p.award && <span class="case-award">{p.award}</span>}</p>

          <ul class="roles">{p.roles.map(r => <li>{r}</li>)}</ul>

          <dl class="metrics">
            {p.metrics.map(m => (
              <div><dt>{m.label}</dt><dd class="m-value">{m.value}</dd>{m.note && <dd class="m-note">{m.note}</dd>}</div>
            ))}
          </dl>

          {p.figure && (
            <figure class="case-figure">
              {/* 도해 SVG는 인라인으로 심어야 사이트 테마 토글을 따른다 */}
              {p.figure.src.endsWith('.svg')
                ? <div class="svg-wrap" set:html={inlineSvg(p.figure.src)} />
                : <a href={p.figure.src} aria-label={`${p.title} 이미지 원본 보기`}><img src={p.figure.src} srcset={p.figure.srcset} sizes="(max-width:860px) 90vw, 800px" width={p.figure.width} height={p.figure.height} alt={p.figure.alt} loading="lazy" decoding="async" /></a>}
              {p.figure.caption && <figcaption>{p.figure.caption}</figcaption>}
            </figure>
          )}

          <h4 class="sol-heading">기술적 문제 해결</h4>
          {p.solutions.map((s, i) => (
            <section class="sol">
              <h5><span>{i + 1})</span>{s.title}</h5>
              <dl class="sar">
                <div><dt>상황</dt><dd>{s.situation}</dd></div>
                <div><dt>해결</dt><dd><ul>{s.actions.map(a => <li set:html={rich(a)} />)}</ul></dd></div>
                <div><dt>성과</dt><dd>
                  <ul>{s.results.map(r => <li set:html={rich(r)} />)}</ul>
                  {s.compare && (() => {
                    const max = Math.max(...s.compare.rows.map(r => r.before));
                    return (
                      <figure class="compare" aria-label={s.compare.caption}>
                        <figcaption>{s.compare.caption}<span><i class="k-before" />전 <i class="k-after" />후</span></figcaption>
                        {s.compare.rows.map(r => (
                          <div class="cmp-row">
                            <span class="cmp-label">{r.label}</span>
                            <div class="cmp-bars">
                              <div class="bar before" style={`width:${pct(r.before, max)}`}><b>{r.before}{s.compare!.unit}</b></div>
                              <div class="bar after" style={`width:${pct(r.after, max)}`}><b>{r.after}{s.compare!.unit}</b></div>
                            </div>
                          </div>
                        ))}
                      </figure>
                    );
                  })()}
                </dd></div>
              </dl>
            </section>
          ))}

          <footer class="case-foot">
            <p class="boundary">※ {p.boundary}</p>
            <span class="case-links">
              {p.links.map(l => l.external
                ? <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}<ArrowUpRight size={15} /></a>
                : <a href={l.href}>{l.label}<ArrowRight size={15} /></a>)}
            </span>
          </footer>
        </article>
      ))}
    </section>

    <section class="pf-section" aria-labelledby="others-title">
      <h2 id="others-title" class="pf-label">기타 프로젝트</h2>
      <dl class="rows">
        {otherProjects.map(o => <div><dt>{o.period}</dt><dd><a href={o.href}><strong>{o.title}</strong></a> · {o.text}{o.award && ` · ${o.award}`}</dd></div>)}
      </dl>
    </section>

    <section class="pf-section" aria-labelledby="skills-title">
      <h2 id="skills-title" class="pf-label">기술</h2>
      <dl class="rows">
        {skills.map(s => <div><dt>{s.k}</dt><dd>{s.v}</dd></div>)}
      </dl>
    </section>

    <section class="pf-section" aria-labelledby="edu-title">
      <h2 id="edu-title" class="pf-label">교육</h2>
      <dl class="rows">
        {education.map(e => <div><dt>{e.date}</dt><dd><strong>{e.title}</strong> · {e.text}</dd></div>)}
      </dl>
    </section>

    <div class="pf-split">
      <section class="pf-section" aria-labelledby="awards-title">
        <h2 id="awards-title" class="pf-label">수상</h2>
        <dl class="rows compact">
          {awards.map(a => <div><dt>{a.date}</dt><dd>{a.text}</dd></div>)}
        </dl>
      </section>
      <section class="pf-section" aria-labelledby="cert-title">
        <h2 id="cert-title" class="pf-label">자격·어학</h2>
        <dl class="rows compact">
          {certificates.map(c => <div><dt>{c.date}</dt><dd>{c.text}</dd></div>)}
        </dl>
      </section>
    </div>

    <footer class="pf-end">
      <a href={`mailto:${SITE.links.email}`}><Mail size={16} />{SITE.links.email}</a>
      <a href={SITE.links.github} target="_blank" rel="noopener noreferrer">GitHub<ArrowUpRight size={15} /></a>
    </footer>
  </div>
</BaseLayout>

<script>
  document.getElementById('portfolio-print')?.addEventListener('click', () => window.print());
</script>

<style>
  .pf { padding-bottom: 8px; color: var(--text-body); font-size: 16px; line-height: 1.7; }
  .pf h1, .pf h2, .pf h3, .pf h4, .pf h5, .pf p, .pf ul, .pf ol, .pf dl, .pf dd, .pf figure { margin: 0; }
  .pf a:not(.row) {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--link-line);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .pf a:not(.row):hover { color: var(--text); text-decoration-color: var(--text); }
  .pf strong { color: var(--text); font-weight: 600; }

  .pf-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 96px;
    gap: 28px;
    align-items: start;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--hair);
  }
  .pf-photo { grid-column: 2; grid-row: 1; width: 96px; height: auto; border-radius: 8px; }
  .pf-head-text { grid-column: 1; grid-row: 1; min-width: 0; }
  .pf-name { margin-bottom: 8px; color: var(--text); font-size: 17px; font-weight: 500; }
  .pf h1 { color: var(--text); font-size: 17px; font-weight: 550; line-height: 1.55; }
  .pf-intro { margin-top: 10px; color: var(--text-body); font-size: 16px; }
  .pf-status { margin-top: 6px; color: var(--text-dim); font-size: 14px; }
  .pf-contact { display: flex; flex-wrap: wrap; gap: 8px 16px; margin-top: 16px; font-size: 14px; }
  #portfolio-print {
    padding: 0; border: 0; background: none; color: var(--text-dim);
    font: inherit; font-size: 14px; cursor: pointer;
    text-decoration: underline; text-decoration-color: var(--link-line); text-underline-offset: 3px;
  }
  #portfolio-print:hover { color: var(--text); text-decoration-color: var(--text); }

  .pf-section { margin-top: var(--section); }
  .pf-label {
    margin-bottom: 0 !important;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--hair);
    color: var(--text);
    font-size: 17px;
    font-weight: 500;
  }

  .highlights { list-style: none; padding: 0; display: grid; grid-template-columns: 1fr 1fr; }
  .highlights li { border-bottom: 1px solid var(--divider); }
  .pf .highlights a { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; padding: 12px 0; text-decoration: none; }
  .pf .highlights a:hover { text-decoration: none; }
  .h-label { font-size: 13px; color: var(--text-dim); }
  .highlights strong { color: var(--text); font-size: 17px; font-weight: 550; font-variant-numeric: tabular-nums; }
  .h-from { font-size: 13px; color: var(--text-dim); }

  .case { padding-top: 64px; scroll-margin-top: 24px; }
  .case-head {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline;
    gap: 4px 16px; padding-bottom: 10px; margin-bottom: 14px; border-bottom: 1px solid var(--hair);
  }
  .case h3 { color: var(--text); font-size: 17px; font-weight: 550; line-height: 1.45; }
  .case-num { margin-right: 8px; color: var(--text-dim); font-size: 13px; font-weight: 500; font-variant-numeric: tabular-nums; }
  .case-date { color: var(--text-dim); font-size: 13px; font-variant-numeric: tabular-nums; }
  .case-summary { color: var(--text); font-size: 16px; font-weight: 500; line-height: 1.6; }
  .case-meta { display: flex; flex-wrap: wrap; gap: 6px 12px; margin-top: 8px !important; color: var(--text-dim); font-size: 14px; }
  .case-award { color: var(--text); }

  .roles { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 14px; margin-top: 14px !important; }
  .roles li { color: var(--text-dim); font-size: 14px; }

  .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 0 20px; margin-top: 18px !important; border-top: 1px solid var(--hair); }
  .metrics > div { padding: 12px 0; border-bottom: 1px solid var(--divider); }
  .metrics dt { font-size: 13px; color: var(--text-dim); }
  .m-value { color: var(--text); font-size: 17px; font-weight: 550; line-height: 1.4; font-variant-numeric: tabular-nums; }
  .m-note { font-size: 13px; color: var(--text-dim); }

  .case-figure { margin-top: 18px !important; }
  .case-figure img, .svg-wrap {
    display: block; width: 100%; border: 1px solid var(--hair); border-radius: 12px; background: #fff;
  }
  .svg-wrap { padding: 8px; }
  .svg-wrap :global(svg) { display: block; width: 100%; height: auto; }
  .case-figure figcaption { margin-top: 8px; font-size: 13px; color: var(--text-dim); }

  .sol-heading {
    margin-top: 36px !important; padding-top: 16px; border-top: 1px solid var(--hair);
    color: var(--text); font-size: 17px; font-weight: 550;
  }
  .sol { margin-top: 20px; }
  .sol + .sol { padding-top: 20px; border-top: 1px solid var(--divider); }
  .sol h5 { color: var(--text); font-size: 16px; font-weight: 550; line-height: 1.5; margin-bottom: 8px !important; }
  .sol h5 span { color: var(--text-dim); margin-right: 8px; font-weight: 500; }
  .sar > div { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 12px; padding: 6px 0; }
  .sar dt { color: var(--text-dim); font-size: 14px; font-weight: 500; }
  .sar ul { padding-left: 18px; }
  .sar li + li { margin-top: 4px; }
  .sar li::marker { color: var(--text-dim); }

  .compare { margin-top: 12px !important; max-width: 520px; }
  .compare figcaption { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 8px; font-size: 13px; color: var(--text-dim); }
  .compare figcaption span { display: inline-flex; align-items: center; gap: 6px; }
  .compare i { display: inline-block; width: 10px; height: 10px; border-radius: 2px; }
  .compare i.k-after { margin-left: 8px; }
  .k-before, .bar.before { background: #c5c8cc; }
  .k-after, .bar.after { background: var(--text); }
  .cmp-row { display: grid; grid-template-columns: 72px minmax(0, 1fr); gap: 10px; align-items: center; }
  .cmp-row + .cmp-row { margin-top: 8px; }
  .cmp-label { font-size: 13px; color: var(--text-dim); }
  .cmp-bars { display: grid; gap: 3px; padding-right: 52px; }
  .bar { position: relative; height: 8px; border-radius: 99px; }
  .bar b {
    position: absolute; left: calc(100% + 6px); top: 50%; transform: translateY(-50%);
    font-size: 12px; font-weight: 500; color: var(--text-dim); white-space: nowrap; font-variant-numeric: tabular-nums;
  }
  .bar.after b { color: var(--text); }

  .case-foot {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline;
    gap: 8px 20px; margin-top: 20px; padding-top: 12px; border-top: 1px solid var(--divider);
  }
  .boundary { flex: 1 1 240px; font-size: 13px; color: var(--text-dim); }
  .case-links { display: flex; flex-wrap: wrap; gap: 14px; font-size: 14px; }

  .rows > div { display: grid; grid-template-columns: 148px minmax(0, 1fr); gap: 12px; padding: 11px 0; border-top: 1px solid var(--divider); }
  .rows > div:last-child { border-bottom: 1px solid var(--divider); }
  .rows dt { color: var(--text); font-size: 14px; font-weight: 500; font-variant-numeric: tabular-nums; }
  .rows dd { font-size: 15px; }
  .rows.compact > div { grid-template-columns: 72px minmax(0, 1fr); }
  .rows.compact dt { color: var(--text-dim); font-weight: 400; }
  .pf-split { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  .pf-end {
    display: flex; flex-wrap: wrap; gap: 8px 16px; margin-top: 48px; padding-top: 16px;
    border-top: 1px solid var(--hair); font-size: 14px;
  }

  @media (max-width: 640px) {
    .pf-head { grid-template-columns: 1fr; gap: 16px; }
    .pf-photo, .pf-head-text { grid-column: 1; grid-row: auto; }
    .pf-photo { width: 80px; }
    .highlights { grid-template-columns: 1fr; }
    .pf-split { grid-template-columns: 1fr; gap: 0; }
    .sar > div { grid-template-columns: 1fr; gap: 0; }
    .rows > div { grid-template-columns: 1fr; gap: 2px; }
    .rows.compact > div { grid-template-columns: 64px minmax(0, 1fr); gap: 10px; }
    .case { padding-top: 48px; }
  }
  @media print {
    :global(body > .column > header), :global(body > .column > footer), #portfolio-print { display: none !important; }
    .pf { max-width: none; padding: 0; font-size: 10pt; color: #222; }
    .pf-head { padding-top: 0; }
    .highlights { grid-template-columns: 1fr 1fr; }
    .case { break-before: page; padding-top: 0; }
    .case-figure img { max-height: 70mm; }
    .pf a { text-decoration: none; }
    h3, h4, h5 { break-after: avoid; }
    .sol, .metrics, figure { break-inside: avoid; }
  }
</style>
