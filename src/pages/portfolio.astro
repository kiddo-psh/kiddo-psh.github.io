/*
 * 일하는 방식. 흔한 네 단계 도식이 되지 않게, 칸마다 그 단계를 실제로 한 사례 하나를 붙이고
 * 그 사례가 있는 곳으로 보낸다. 사례가 없는 단계는 칸을 만들지 않는다.
 */
const ways = [
  { icon: Search, name: '정의', text: '이중주차를 차량 겹침이 아니라 구역 침범으로 다시 정의했습니다.', href: '#edge' },
  { icon: Network, name: '설계', text: '에이전트 선택을 LLM 대신 테스트로 고정할 수 있는 규칙으로 정했습니다.', href: '#agents' },
  { icon: Cable, name: '연결', text: '화면과 API가 어긋나면 계약 문서를 먼저 고친 뒤 양쪽을 맞췄습니다.', href: '#feelm' },
  { icon: ChartNoAxesColumn, name: '검증', text: '채점 도구부터 검증한 뒤 설계 근거를 실험으로 다시 쟀습니다.', href: '#vision' },
];

/*
 * AI가 아닌 프로젝트. 위 네 개가 모두 AI 이야기라 그 아래의 인증·장애·연동을 다룬 근거로 둔다.
 * 대표 프로젝트와 결이 달라 프로젝트 칸으로 올리지 않고 짧게 둔다.
 * 테스트 수는 팀 단위와 섞이기 쉬워 넣지 않는다.
 */
const foundation = {
  id: 'feelm',
  title: 'feelm',
  subtitle: '영화 추천 서비스의 계정과 인증',
  award: '특화 프로젝트 1등',
  role: '7인 팀 · 계정·인증 백엔드, 프론트 API 연동',
  points: [
    { k: '실패 먼저', v: '정상 흐름보다 실패 쪽을 먼저 정했습니다. 주소를 바꿔 보내는 메일 폭탄을 IP·전역 제한으로 막고, 비밀번호가 바뀌면 예전 재설정 링크를 끊고, 교착이 생기던 탈퇴를 세 단계로 나눴습니다.' },
    { k: '계약 기준 연동', v: '목업 화면을 실제 API에 이으며 계약과 어긋나는 곳이 나오면, 화면에서 우회하지 않고 계약 문서를 먼저 고친 뒤 양쪽을 맞췄습니다.' },
  ],
  more: { href: '/projects/feelm', label: 'feelm 프로젝트 자세히 보기' },
};

const groups = { service: '끝까지 만든 서비스', practice: '검증과 개발 도구' } as const;

const num = (i: number) => String(i + 1).padStart(2, '0');
---

<BaseLayout
  title="박시현 · 포트폴리오"
  description="박시현의 AI Application Engineer 포트폴리오. 현장의 문제를 요구사항으로 정의하고 AI·백엔드를 연결해 서비스를 구현하고 검증한 작업을 소개합니다."
>
  <div class="page portfolio">
    <section class="hero col" aria-labelledby="portfolio-title">
      <p class="eyebrow">PORTFOLIO</p>
      <h1 id="portfolio-title">현장의 문제를<br />AI 시스템으로 구현합니다</h1>
      <p class="intro">문제를 실행 가능한 요구사항으로 정의하고, AI·백엔드·현장 장비를 연결해 작동하는 서비스를 만듭니다. 결과는 측정으로 확인합니다.</p>
      <p class="who"><strong>박시현</strong> AI Application Engineer</p>
      <p class="proof">AI의 답을 측정으로 증명합니다.</p>
    </section>

    <!-- 목차 겸 요약. 이 네 줄만 읽어도 무엇을 했고 무엇이 바뀌었는지 보인다 -->
    <ol class="index col" aria-label="프로젝트 요약">
      {projects.map((p, i) => (
        <>
          {(i === 0 || projects[i - 1].group !== p.group) && <li class="group" aria-hidden="true">{groups[p.group]}</li>}
          <li>
            <a href={`#${p.id}`}>
              <span class="n">{num(i)}</span>
              <span class="t"><strong>{p.title}</strong><span>{p.stack}</span></span>
              <span class="hl">{p.highlight}</span>
            </a>
          </li>
        </>
      ))}
    </ol>

    <section class="ways col" aria-labelledby="ways-title">
      <h2 id="ways-title" class="ways-title">일하는 방식</h2>
      <ol>
        {ways.map((w) => (
          <li>
            <a href={w.href}>
              <w.icon size={22} class="w-icon" />
              <strong>{w.name}</strong>
              <span>{w.text}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    {projects.map((p, i) => (
      <article class="project" id={p.id} aria-labelledby={`${p.id}-h`}>
        <div class="col">
          <p class="tag"><span class="badge">{num(i)}</span>{p.title}<span class="stack">{p.stack}</span></p>
          <h2 id={`${p.id}-h`}>{p.headline}</h2>
          {p.role && <p class="role">{p.role}</p>}

          {p.problem && <p class="problem"><strong>문제</strong>{p.problem}</p>}

          {p.flow && (
            <ol class="flow" aria-label="자동화한 흐름">
              {p.flow.map((f) => (
                <li class:list={{ mine: f.mine }}>
                  <strong>{f.name}{f.mine && <em>제 담당</em>}</strong>
                  <span>{f.text}</span>
                </li>
              ))}
            </ol>
          )}

          {(p.problem || p.flow) && <p class="sub">제가 한 일</p>}
          <dl class="brief">
            {p.brief.map((b) => <div><dt>{b.k}</dt><dd>{b.v}</dd></div>)}
          </dl>
        </div>

        {p.figure && (
          <figure class="fig">
            <img src={p.figure.src} alt={p.figure.alt} width="1920" height="1080" loading="lazy" decoding="async" />
            <figcaption>{p.figure.caption}</figcaption>
          </figure>
        )}

        <div class="col">
          {p.table && (
            <table class:list={['tbl', { num: p.table.numeric }]}>
              <thead><tr>{p.table.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
              <tbody>
                {p.table.rows.map((r) => (
                  <tr>{r.map((c, ci) => (ci === 0 ? <th scope="row">{c}</th> : <td>{c}</td>))}</tr>
                ))}
              </tbody>
            </table>
          )}

          {p.steps && (
            <ol class="steps">
              {p.steps.map((s) => <li><strong>{s.name}</strong>{s.text && <span>{s.text}</span>}</li>)}
            </ol>
          )}

          {p.findings && (
            <div class="findings">
              {p.findings.map((f) => (
                <div class="finding">
                  <div class="fv"><b>{f.value}</b><span>{f.label}</span></div>
                  <div><h3>{f.title}</h3><p>{f.text}</p></div>
                </div>
              ))}
            </div>
          )}

          {p.metrics && (
            <dl class="metrics">
              {p.metrics.map((m) => (
                <div>
                  <dt>{m.label}</dt>
                  <dd class="mv">{m.value}</dd>
                  {m.note && <dd class="mn">{m.note}</dd>}
                </div>
              ))}
            </dl>
          )}

          {p.conclusion && <p class="conclusion"><strong>결론</strong>{p.conclusion}</p>}

          {p.notes?.map((n) => <p class="note">{n}</p>)}

          {p.scope && <p class="scope"><strong>검증 범위</strong>{p.scope}</p>}

          {p.more && <p class="more"><a href={p.more.href}>{p.more.label}<ArrowRight size={16} /></a></p>}
        </div>
      </article>
    ))}

    <section class="foundation col" id={foundation.id} aria-labelledby="foundation-title">
      <p class="eyebrow">FOUNDATION</p>
      <h2 id="foundation-title">AI 밖의 기반</h2>
      <p class="tag">{foundation.title}<span class="stack">{foundation.subtitle}</span><span class="award">{foundation.award}</span></p>
      <p class="role">{foundation.role}</p>
      <dl class="brief">
        {foundation.points.map((b) => <div><dt>{b.k}</dt><dd>{b.v}</dd></div>)}
      </dl>
      <p class="more"><a href={foundation.more.href}>{foundation.more.label}<ArrowRight size={16} /></a></p>
    </section>

    <section class="collab col" aria-labelledby="collab-title">
      <p class="eyebrow">COLLABORATION</p>
      <h2 id="collab-title">협업 경험</h2>
      <p class="collab-lead">7인 팀 프로젝트 주차바로에서 겪은 문제를 회고로 남겼습니다.</p>
      <ul class="retros">
        {retros.map((r) => (
          <li>
            <h3><a href={r.href}>{r.title}</a></h3>
            <p class="r-story">{r.story}</p>
            <p class="r-lesson"><strong>배운 점</strong>{r.lesson}</p>
            <p class="r-links">
              <a href={r.href}>회고 읽기<ArrowRight size={16} /></a>
              {r.next && <a class="r-next" href={r.next.href}>{r.next.label}</a>}
            </p>
          </li>
        ))}
      </ul>
    </section>

    <footer class="contact col">
      <p>더 자세한 구현과 협업 경험이 궁금하시면 연락 주세요.</p>
      <a href={`mailto:${SITE.links.email}`}><Mail size={16} />이메일</a>
      <a href={SITE.links.github} target="_blank" rel="noopener noreferrer">{SITE.links.github.replace('https://', '')}<ArrowUpRight size={16} /></a>
    </footer>
  </div>
</BaseLayout>

<style>
  .portfolio { padding-bottom: var(--space-16); }
  /* 글은 읽기 좋은 폭에 묶고, 그림만 페이지 폭을 다 쓴다 */
  .col { max-width: var(--w-doc); }
  h1, h2, h3, p { margin-top: 0; }

  .eyebrow { margin: 0 0 var(--space-4); color: var(--accent); font-size: var(--fs-200); font-weight: 800; letter-spacing: var(--ls-label); }
  .hero { padding: var(--space-16) 0 var(--space-10); }
  h1 { margin-bottom: var(--space-5); font-size: var(--fs-title); font-weight: 800; line-height: var(--lh-tight); letter-spacing: var(--ls-tight); }
  .intro { margin-bottom: var(--space-6); color: var(--text-dim); font-size: var(--fs-lead); line-height: var(--lh-normal); }
  .who { margin: 0; font-size: var(--fs-300); color: var(--text-dim); }
  .who strong { margin-right: var(--space-2); color: var(--text); font-size: var(--fs-500); }
  .proof { margin: var(--space-4) 0 0; color: var(--accent); font-size: var(--fs-300); font-weight: 700; }

  .index { list-style: none; margin: 0 0 var(--space-8); padding: 0; border-top: 2px solid var(--text); }
  .index li { border-bottom: 1px solid var(--border); }
  .index li.group { padding: var(--space-5) 0 var(--space-2); color: var(--text-dim); font-size: var(--fs-200); font-weight: 700; }

  /* 일하는 방식. 칸마다 실제 사례로 보내는 링크라 카드 전체를 누를 수 있게 둔다 */
  .ways { margin: 0 0 var(--space-8); }
  .ways-title { margin-bottom: var(--space-4); font-size: var(--fs-300); font-weight: 800; color: var(--text-dim); letter-spacing: 0; }
  .ways ol { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); margin: 0; padding: 0; list-style: none; }
  .ways a { display: grid; grid-template-columns: auto 1fr; gap: var(--space-1) var(--space-3); height: 100%; padding: var(--space-4); border: 1px solid var(--border); border-radius: var(--radius-lg); color: var(--text); transition: border-color var(--dur) var(--ease); }
  .ways a:hover { border-color: var(--accent); text-decoration: none; }
  .ways :global(.w-icon) { grid-row: 1 / span 2; color: var(--accent); }
  .ways strong { font-size: var(--fs-400); }
  .ways span { color: var(--text-dim); font-size: var(--fs-300); line-height: var(--lh-normal); word-break: keep-all; }
  .index a { display: grid; grid-template-columns: 2.5rem 1fr auto; gap: var(--space-4); align-items: center; padding: var(--space-4) 0; color: var(--text); }
  .index a:hover { text-decoration: none; }
  .index a:hover strong { color: var(--accent); }
  .n { color: var(--accent); font-size: var(--fs-300); font-weight: 800; font-variant-numeric: tabular-nums; }
  .t { display: flex; flex-direction: column; min-width: 0; }
  .t strong { font-size: var(--fs-500); line-height: var(--lh-snug); transition: color var(--dur) var(--ease); }
  .t span { font-size: var(--fs-200); color: var(--text-dim); }
  .hl { color: var(--accent); font-size: var(--fs-500); font-weight: 800; letter-spacing: var(--ls-snug); text-align: right; white-space: nowrap; }

  .project { padding: var(--space-16) 0 var(--space-6); border-bottom: 1px solid var(--border); scroll-margin-top: calc(var(--nav-h) + var(--space-4)); }
  .tag { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-1) var(--space-3); margin-bottom: var(--space-4); color: var(--accent); font-size: var(--fs-300); font-weight: 800; }
  .badge { padding: var(--space-05) var(--space-2); border-radius: var(--radius-md); background: var(--accent); color: var(--bg); font-variant-numeric: tabular-nums; }
  .stack { color: var(--text-dim); font-weight: 500; }
  h2 { margin-bottom: var(--space-8); font-size: var(--fs-800); font-weight: 800; line-height: var(--lh-tight); letter-spacing: var(--ls-tight); word-break: keep-all; }

  .role { margin: calc(var(--space-6) * -1) 0 var(--space-8); color: var(--text-dim); font-size: var(--fs-300); }
  .problem {
    margin: 0 0 var(--space-6); padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-lg); background: var(--bg-elev);
    font-size: var(--fs-500); line-height: var(--lh-relaxed); word-break: keep-all;
  }
  .problem strong, .scope strong { display: block; margin-bottom: var(--space-1); color: var(--accent); font-size: var(--fs-300); }

  /* 자동화한 흐름. 가로로 이어지는 단계, 제가 맡은 단계만 강조색 테두리 */
  .flow { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(150px, 100%), 1fr)); gap: var(--space-2); margin: 0 0 var(--space-10); padding: 0; list-style: none; counter-reset: f; }
  .flow li { counter-increment: f; padding: var(--space-3) var(--space-4); border: 1px solid var(--border); border-radius: var(--radius-lg); }
  .flow li.mine { border-color: var(--accent); }
  .flow strong { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2); font-size: var(--fs-400); }
  .flow strong::before { content: counter(f); color: var(--accent); font-variant-numeric: tabular-nums; }
  .flow em { color: var(--accent); font-size: var(--fs-100); font-style: normal; font-weight: 700; }
  .flow span { display: block; margin-top: var(--space-1); color: var(--text-dim); font-size: var(--fs-300); line-height: var(--lh-normal); word-break: keep-all; }
  .sub { margin-bottom: var(--space-4); color: var(--text-dim); font-size: var(--fs-300); font-weight: 800; }

  /* 문제·측정·발견. 라벨 폭을 고정해 세 줄이 표처럼 세로로 맞는다 */
  .brief { display: grid; gap: var(--space-4); margin: 0 0 var(--space-10); }
  .brief div { display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: var(--space-4); }
  .brief dt { color: var(--accent); font-size: var(--fs-400); font-weight: 800; line-height: var(--lh-relaxed); }
  .brief dd { margin: 0; font-size: var(--fs-500); line-height: var(--lh-relaxed); word-break: keep-all; }

  .fig { margin: 0 0 var(--space-10); }
  .fig img { display: block; width: 100%; height: auto; border: 1px solid var(--border); border-radius: var(--radius-xl); }
  .fig figcaption { margin-top: var(--space-2); color: var(--text-dim); font-size: var(--fs-200); }

  /* 표는 가로줄만. 마지막 행(합계·결론)은 굵게 두지 않고 윗줄로만 구분한다 */
  .tbl { width: 100%; margin: 0 0 var(--space-10); border-collapse: collapse; font-size: var(--fs-400); line-height: var(--lh-normal); }
  .tbl thead th { padding: 0 var(--space-3) var(--space-2) 0; border-bottom: 2px solid var(--text); color: var(--text-dim); font-size: var(--fs-300); font-weight: 700; text-align: left; }
  .tbl tbody th, .tbl td { padding: var(--space-3) var(--space-3) var(--space-3) 0; border-bottom: 1px solid var(--border); text-align: left; vertical-align: top; }
  .tbl tbody th { font-weight: 600; }
  .tbl.num td, .tbl.num thead th:not(:first-child) { text-align: right; font-variant-numeric: tabular-nums; }
  .tbl.num tbody tr:last-child > * { border-top: 2px solid var(--text); border-bottom: 0; font-weight: 800; }

  .steps { margin: 0 0 var(--space-10); padding: 0; list-style: none; counter-reset: s; border-left: 2px solid var(--border); }
  .steps li { counter-increment: s; position: relative; padding: 0 0 var(--space-4) var(--space-6); font-size: var(--fs-500); line-height: var(--lh-normal); }
  .steps li:last-child { padding-bottom: 0; }
  .steps li::before {
    content: counter(s); position: absolute; left: -0.8rem; top: .1rem;
    width: 1.5rem; height: 1.5rem; border-radius: var(--radius-full);
    background: var(--bg); border: 2px solid var(--accent); color: var(--accent);
    font-size: var(--fs-100); font-weight: 800; line-height: 1.25rem; text-align: center;
  }
  .steps strong { display: block; }
  .steps span { display: block; color: var(--text-dim); font-size: var(--fs-400); word-break: keep-all; }

  .findings { margin: 0 0 var(--space-10); border-top: 1px solid var(--border); }
  .finding { display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: var(--space-6); padding: var(--space-6) 0; border-bottom: 1px solid var(--border); }
  .fv b { display: block; color: var(--accent); font-size: var(--fs-800); font-weight: 800; line-height: var(--lh-tight); letter-spacing: var(--ls-tight); white-space: nowrap; }
  .fv span { display: block; margin-top: var(--space-1); color: var(--text-dim); font-size: var(--fs-200); }
  .finding h3 { margin-bottom: var(--space-2); font-size: var(--fs-500); line-height: var(--lh-snug); word-break: keep-all; }
  .finding p { margin: 0; font-size: var(--fs-400); line-height: var(--lh-relaxed); word-break: keep-all; }

  .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(190px, 100%), 1fr)); gap: var(--space-6); margin: 0 0 var(--space-8); }
  .metrics > div { padding-top: var(--space-3); border-top: 2px solid var(--text); }
  .metrics dt { color: var(--text-dim); font-size: var(--fs-300); }
  .metrics dd { margin: 0; }
  .mv { margin-top: var(--space-1); color: var(--accent); font-size: var(--fs-800); font-weight: 800; line-height: var(--lh-tight); letter-spacing: var(--ls-tight); font-variant-numeric: tabular-nums; }
  .mn { margin-top: var(--space-1); color: var(--text-dim); font-size: var(--fs-200); }

  .conclusion {
    margin: 0 0 var(--space-6); padding: var(--space-4) var(--space-5);
    border-left: 3px solid var(--accent); border-radius: var(--radius-lg); background: var(--accent-soft);
    font-size: var(--fs-500); line-height: var(--lh-relaxed); word-break: keep-all;
  }
  .conclusion strong { display: block; margin-bottom: var(--space-1); color: var(--accent); font-size: var(--fs-300); }
  .note { margin-bottom: var(--space-4); font-size: var(--fs-400); line-height: var(--lh-relaxed); word-break: keep-all; }
  .scope { margin-bottom: var(--space-4); padding-top: var(--space-4); border-top: 1px solid var(--border); font-size: var(--fs-400); line-height: var(--lh-relaxed); word-break: keep-all; }
  .more { margin: var(--space-6) 0 var(--space-4); font-size: var(--fs-300); font-weight: 700; }
  /* Lucide 아이콘은 글자 옆에 붙는 기능 표시라 글자 높이에 맞춘다 */
  .more a, .r-links a, .contact a { display: inline-flex; align-items: center; gap: var(--space-1); }

  .foundation { padding: var(--space-16) 0 var(--space-6); border-bottom: 1px solid var(--border); scroll-margin-top: calc(var(--nav-h) + var(--space-4)); }
  .foundation h2 { margin-bottom: var(--space-6); }
  .foundation .tag { margin-bottom: var(--space-2); }
  .foundation .role { margin: 0 0 var(--space-6); }
  .award { padding: var(--space-05) var(--space-2); border-radius: var(--radius-md); background: var(--accent-soft); color: var(--accent); font-size: var(--fs-200); }
  .foundation .brief div { grid-template-columns: 6.5rem minmax(0, 1fr); }

  .collab { padding: var(--space-16) 0 var(--space-6); border-bottom: 1px solid var(--border); }
  .collab h2 { margin-bottom: var(--space-3); }
