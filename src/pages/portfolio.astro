---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site.config';

/*
 * 포트폴리오 한 장. 프로젝트마다 읽는 순서를 같게 둔다:
 * 무엇(머리) → 한 일(헤드라인) → 문제·측정·발견 세 줄 → 근거(표·그림, 필요할 때만) → 결과 숫자.
 * 위 세 줄과 숫자만 읽고 넘어가도 프로젝트가 전달되게 하는 것이 목표다.
 *
 * 그림은 글로 대신할 수 없는 것만 넣는다. 지금은 주차 감지 화면 하나이고,
 * 넣었으면 텍스트 칼럼을 넘어 페이지 폭을 다 쓴다. 단계별 시간·라우팅 규칙·작업 흐름은
 * 표와 목록이 그림보다 읽기 쉬워서 그림으로 그리지 않는다.
 */

interface Brief { k: string; v: string }
interface Metric { label: string; value: string; note?: string }
interface Finding { value: string; label: string; title: string; text: string }
interface Table { head: string[]; rows: string[][]; numeric?: boolean }
interface Project {
  id: string;
  title: string;
  stack: string;
  highlight: string;
  headline: string;
  brief: Brief[];
  figure?: { src: string; alt: string; caption: string };
  table?: Table;
  steps?: { name: string; text?: string }[];
  findings?: Finding[];
  metrics?: Metric[];
  conclusion?: string;
  notes?: string[];
  more?: { href: string; label: string };
}

const projects: Project[] = [
  {
    id: 'vision',
    title: '사진 식단 분석',
    stack: 'Claude Vision',
    highlight: '과검출 49 → 7건',
    headline: '측정된 적 없는 설계 근거를 실험으로 검증했습니다',
    brief: [
      { k: '가설', v: '“Vision 직접 추정과 식약처 DB 조회는 정확도 차이가 미미하다.” 사진 분석 방식을 정한 근거였지만, 한 번도 잰 적이 없었습니다.' },
      { k: '실험', v: '포장 영양표시로만 정답을 매긴 평가셋 31장을 직접 만들고, 두 방식이 같은 그램 추정을 쓰게 해 영양 계수 차이만 비교했습니다.' },
      { k: '도구', v: '채점 도구부터 검증해 결함 4건을 고쳤고, 그중 1건은 판정을 뒤집었습니다.' },
    ],
    findings: [
      {
        value: '37.5%', label: 'DB 음식명 조회 실패율',
        title: 'DB 방식의 우위는 현실에서 사라졌습니다',
        text: '계수는 정확했지만 음식명 조회가 37.5% 실패했습니다. 매칭을 느슨하게 하면 오차가 2.2배로 커졌습니다.',
      },
      {
        value: '+20%', label: '합계 칼로리 편향',
        title: '질문 밖에서 계통 오차를 찾았습니다',
        text: '합계 칼로리가 과대 추정 쪽으로 쏠렸습니다. 분해로 오진했다가, 요리와 재료의 중복 출력임을 확인했습니다. 예: 카츠동 680 · 계란 90 · 홍생강 3 · 파 3 → 가츠동 680.',
      },
      {
        value: '49 → 7', label: '과검출 건수',
        title: '한 줄만 다른 대조 프롬프트로 고쳤습니다',
        text: '과검출이 49건에서 7건으로, 음식명 F1이 0.38에서 0.77로 바뀌었습니다. 나빠진 지표는 없었습니다.',
      },
    ],
    conclusion: '결정은 유지하고 근거를 바꿨습니다. “Vision 방식에는 프롬프트라는 개선 수단이 있고, DB 방식에는 없다.” 설계 문서에 정정 기록을 남기고, 기존 프롬프트는 대조군으로 보존한 채 서비스에 반영했습니다.',
    notes: [
      '짝지은 비교 표본이 8개라 방향만 신뢰할 수 있어서, 반복 측정으로 실행 간 분산을 분리할 계획입니다.',
    ],
  },
  {
    id: 'edge',
    title: '엣지 비전 주차 감지',
    stack: 'YOLOv8 · TensorRT · Jetson',
    highlight: '6.5 → 15 FPS',
    headline: '병목을 추측하지 않고 7단계로 재서 찾았습니다',
    brief: [
      { k: '문제', v: 'Jetson에서 6.5 FPS에 그쳐 차량 추적이 끊겼습니다.' },
      { k: '측정', v: '처리 과정을 7단계로 나눠 재는 도구를 만들었습니다.' },
      { k: '발견', v: '병목은 모델 추론 35%와 광각 렌즈 보정 21%였습니다.' },
    ],
    figure: {
      src: '/images/projects/baro/zone-overlay-045s-ev.jpg',
      alt: '주차장 축소 모형 위에 일반·장애인·전기차 충전·통로·출입구 구역이 색으로 나뉘어 있고, 전기차 충전 구역의 차량 한 대가 신뢰도 0.89로 감지된 화면',
      caption: '구역 폴리곤 위에서 차량을 감지하고 어느 구역에 있는지 판정하는 화면',
    },
    table: {
      head: ['프레임당 처리', '개선 전', '개선 후'],
      rows: [
        ['모델 추론', '54ms', '32ms'],
        ['광각 렌즈 보정', '33ms', '3ms'],
        ['그 외', '67ms', '32ms'],
        ['합계', '154ms', '67ms'],
      ],
      numeric: true,
    },
    metrics: [
      { label: '프레임당 처리', value: '154 → 67ms', note: '−57%' },
      { label: '처리 속도', value: '6.5 → 15 FPS', note: '약 2.3배' },
      { label: '수상', value: '우수상', note: 'SSAFY 공통 프로젝트' },
    ],
    notes: ['계측 도구와 병목 분석은 제가 했습니다. TensorRT 변환과 보정의 GPU 전환은 팀이 적용했습니다.'],
    more: { href: '/projects/baro', label: '주차바로 프로젝트 자세히 보기' },
  },
  {
    id: 'agents',
    title: '멀티에이전트 코칭',
    stack: 'Claude API',
    highlight: '호출 4.0 → 2.5개',
    headline: '기록이 있는 에이전트만 부르도록 바꿨습니다',
    brief: [
      { k: '문제', v: '기록이 없어도 에이전트 4개를 매번 불렀습니다.' },
      { k: '가설', v: '필요한 에이전트만 부르면 품질 저하 없이 호출이 줄어듭니다.' },
      { k: '실험', v: '8개 시나리오를 실제 API로 3회씩 비교했습니다.' },
    ],
    table: {
      head: ['기록 조건', '켜는 에이전트'],
      rows: [
        ['영양 기록 1일 이상', '영양 Agent'],
        ['운동 기록 1건 이상', '운동 Agent'],
        ['체중 추세 있음', '목표 Agent'],
        ['기록 없음', 'LLM 호출 없이 안내'],
      ],
    },
    metrics: [
      { label: '에이전트 호출', value: '4.0 → 2.5개', note: '−37.5%' },
      { label: 'LLM 호출', value: '3.0 → 2.5회', note: '−16.7%' },
      { label: '평균 응답', value: '11.1 → 8.7초', note: '−21.9%, 정상 응답률 100% 유지' },
    ],
    notes: [
      '고정 DAG는 요청마다 네 Agent를 늘 실행했습니다. 동적 라우팅은 기록을 먼저 읽고, 영양과 운동이 둘 다 켜지면 목표도 함께 켜며, 켜진 Agent가 없으면 종합도 부르지 않습니다.',
      'Agent 수는 동일 비중의 평가 입력 기준이며 실제 사용자 트래픽 평균은 아닙니다. p90 응답은 0.4%만 줄어서, 에이전트가 모두 필요한 경우의 호출 구조를 다음에 측정합니다.',
    ],
    more: { href: '/projects/yumyum', label: 'yumyum 프로젝트 자세히 보기' },
  },
  {
    id: 'rules',
    title: 'AI 코딩 팀 규칙',
    stack: 'Claude Code',
    highlight: '테스트 없는 MR 0건',
    headline: 'AI 에이전트의 팀 규칙을 데이터로 고쳤습니다',
    brief: [
      { k: '문제', v: '37분에 만든 기능이 기준 차이로 5시간 30분 재작업됐습니다.' },
      { k: '해결', v: 'AI가 따르는 규칙 문서를 설계해 구현 전에 인수 테스트를 확정했습니다.' },
      { k: '검증', v: '실제 업무 5건에 적용하며 비용과 누락 결함을 쟀습니다.' },
    ],
    steps: [
      { name: '플랜', text: '인수 테스트 확정' },
      { name: '구현' },
      { name: '리뷰 A · B 동시 실행', text: 'A는 계약과 실패 경로 확인, B는 전제를 깨는 공격. Claude Code 서브에이전트로 병렬 실행' },
      { name: '사람이 대조' },
      { name: '반영' },
    ],
    metrics: [
      { label: '테스트 없는 MR', value: '0 / 17건', note: '규칙 적용 후 백엔드' },
      { label: '리뷰 발견 결함', value: '6 → 8건', note: '단일 리뷰가 놓친 결함 포함' },
      { label: '틀린 가설', value: '1개 삭제', note: '실측과 달라 근거에서 제외' },
    ],
    notes: ['“세션을 나누면 비용이 는다”는 가설은 실측과 달랐습니다. 규칙에서 그 근거를 뺐습니다.'],
    more: { href: '/posts/ai-agent-rules', label: 'AI 에이전트 규칙 글 읽기' },
  },
];

const num = (i: number) => String(i + 1).padStart(2, '0');
---

<BaseLayout
  title="박시현 · 포트폴리오"
  description="박시현의 Backend & AI 포트폴리오. 가설을 세우고, 실험으로 재고, 근거와 함께 반영한 네 가지 작업을 소개합니다."
>
  <div class="page portfolio">
    <section class="hero col" aria-labelledby="portfolio-title">
      <p class="eyebrow">PORTFOLIO</p>
      <h1 id="portfolio-title">AI의 답을<br />측정으로 증명합니다</h1>
      <p class="intro">가설을 세우고, 실험으로 재고, 근거와 함께 반영했습니다.</p>
      <p class="who"><strong>박시현</strong> Backend &amp; AI Developer</p>
    </section>

    <!-- 목차 겸 요약. 이 네 줄만 읽어도 무엇을 했고 무엇이 바뀌었는지 보인다 -->
    <ol class="index col" aria-label="프로젝트 요약">
      {projects.map((p, i) => (
        <li>
          <a href={`#${p.id}`}>
            <span class="n">{num(i)}</span>
            <span class="t"><strong>{p.title}</strong><span>{p.stack}</span></span>
            <span class="hl">{p.highlight}</span>
          </a>
        </li>
      ))}
    </ol>

    {projects.map((p, i) => (
      <article class="project" id={p.id} aria-labelledby={`${p.id}-h`}>
        <div class="col">
          <p class="tag"><span class="badge">{num(i)}</span>{p.title}<span class="stack">{p.stack}</span></p>
          <h2 id={`${p.id}-h`}>{p.headline}</h2>

          <dl class="brief">
            {p.brief.map((b) => <div><dt>{b.k}</dt><dd>{b.v}</dd></div>)}
          </dl>
        </div>

        {p.figure && (
          <figure class="fig">
            <img src={p.figure.src} alt={p.figure.alt} width="1920" height="1080" loading="lazy" decoding="async" />
            <figcaption>{p.figure.caption}</figcaption>
          </figure>
        )}

        <div class="col">
          {p.table && (
            <table class:list={['tbl', { num: p.table.numeric }]}>
              <thead><tr>{p.table.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
              <tbody>
                {p.table.rows.map((r) => (
                  <tr>{r.map((c, ci) => (ci === 0 ? <th scope="row">{c}</th> : <td>{c}</td>))}</tr>
                ))}
              </tbody>
            </table>
          )}

          {p.steps && (
            <ol class="steps">
              {p.steps.map((s) => <li><strong>{s.name}</strong>{s.text && <span>{s.text}</span>}</li>)}
            </ol>
          )}

          {p.findings && (
            <div class="findings">
              {p.findings.map((f) => (
                <div class="finding">
                  <div class="fv"><b>{f.value}</b><span>{f.label}</span></div>
                  <div><h3>{f.title}</h3><p>{f.text}</p></div>
                </div>
              ))}
            </div>
          )}

          {p.metrics && (
            <dl class="metrics">
              {p.metrics.map((m) => (
                <div>
                  <dt>{m.label}</dt>
                  <dd class="mv">{m.value}</dd>
                  {m.note && <dd class="mn">{m.note}</dd>}
                </div>
              ))}
            </dl>
          )}

          {p.conclusion && <p class="conclusion"><strong>결론</strong>{p.conclusion}</p>}

          {p.notes?.map((n) => <p class="note">{n}</p>)}

          {p.more && <p class="more"><a href={p.more.href}>{p.more.label} →</a></p>}
        </div>
      </article>
    ))}

    <footer class="contact col">
      <p>더 자세한 구현과 협업 경험이 궁금하시면 연락 주세요.</p>
      <a href={`mailto:${SITE.links.email}`}>이메일 <span aria-hidden="true">↗</span></a>
      <a href={SITE.links.github} target="_blank" rel="noopener noreferrer">{SITE.links.github.replace('https://', '')} <span aria-hidden="true">↗</span></a>
    </footer>
  </div>
</BaseLayout>

<style>
  .portfolio { padding-bottom: var(--space-16); }
  /* 글은 읽기 좋은 폭에 묶고, 그림만 페이지 폭을 다 쓴다 */
  .col { max-width: var(--w-doc); }
  h1, h2, h3, p { margin-top: 0; }

  .eyebrow { margin: 0 0 var(--space-4); color: var(--accent); font-size: var(--fs-200); font-weight: 800; letter-spacing: var(--ls-label); }
  .hero { padding: var(--space-16) 0 var(--space-10); }
  h1 { margin-bottom: var(--space-5); font-size: var(--fs-title); font-weight: 800; line-height: var(--lh-tight); letter-spacing: var(--ls-tight); }
  .intro { margin-bottom: var(--space-6); color: var(--text-dim); font-size: var(--fs-lead); line-height: var(--lh-normal); }
  .who { margin: 0; font-size: var(--fs-300); color: var(--text-dim); }
  .who strong { margin-right: var(--space-2); color: var(--text); font-size: var(--fs-500); }

  .index { list-style: none; margin: 0 0 var(--space-8); padding: 0; border-top: 2px solid var(--text); }
  .index li { border-bottom: 1px solid var(--border); }
  .index a { display: grid; grid-template-columns: 2.5rem 1fr auto; gap: var(--space-4); align-items: center; padding: var(--space-4) 0; color: var(--text); }
  .index a:hover { text-decoration: none; }
  .index a:hover strong { color: var(--accent); }
  .n { color: var(--accent); font-size: var(--fs-300); font-weight: 800; font-variant-numeric: tabular-nums; }
  .t { display: flex; flex-direction: column; min-width: 0; }
  .t strong { font-size: var(--fs-500); line-height: var(--lh-snug); transition: color var(--dur) var(--ease); }
  .t span { font-size: var(--fs-200); color: var(--text-dim); }
  .hl { color: var(--accent); font-size: var(--fs-500); font-weight: 800; letter-spacing: var(--ls-snug); text-align: right; white-space: nowrap; }

  .project { padding: var(--space-16) 0 var(--space-6); border-bottom: 1px solid var(--border); scroll-margin-top: calc(var(--nav-h) + var(--space-4)); }
  .tag { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-1) var(--space-3); margin-bottom: var(--space-4); color: var(--accent); font-size: var(--fs-300); font-weight: 800; }
  .badge { padding: var(--space-05) var(--space-2); border-radius: var(--radius-md); background: var(--accent); color: var(--bg); font-variant-numeric: tabular-nums; }
  .stack { color: var(--text-dim); font-weight: 500; }
  h2 { margin-bottom: var(--space-8); font-size: var(--fs-800); font-weight: 800; line-height: var(--lh-tight); letter-spacing: var(--ls-tight); word-break: keep-all; }

  /* 문제·측정·발견. 라벨 폭을 고정해 세 줄이 표처럼 세로로 맞는다 */
  .brief { display: grid; gap: var(--space-4); margin: 0 0 var(--space-10); }
  .brief div { display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: var(--space-4); }
  .brief dt { color: var(--accent); font-size: var(--fs-400); font-weight: 800; line-height: var(--lh-relaxed); }
  .brief dd { margin: 0; font-size: var(--fs-500); line-height: var(--lh-relaxed); word-break: keep-all; }

  .fig { margin: 0 0 var(--space-10); }
  .fig img { display: block; width: 100%; height: auto; border: 1px solid var(--border); border-radius: var(--radius-xl); }
  .fig figcaption { margin-top: var(--space-2); color: var(--text-dim); font-size: var(--fs-200); }

  /* 표는 가로줄만. 마지막 행(합계·결론)은 굵게 두지 않고 윗줄로만 구분한다 */
  .tbl { width: 100%; margin: 0 0 var(--space-10); border-collapse: collapse; font-size: var(--fs-400); line-height: var(--lh-normal); }
  .tbl thead th { padding: 0 var(--space-3) var(--space-2) 0; border-bottom: 2px solid var(--text); color: var(--text-dim); font-size: var(--fs-300); font-weight: 700; text-align: left; }
  .tbl tbody th, .tbl td { padding: var(--space-3) var(--space-3) var(--space-3) 0; border-bottom: 1px solid var(--border); text-align: left; vertical-align: top; }
  .tbl tbody th { font-weight: 600; }
  .tbl.num td, .tbl.num thead th:not(:first-child) { text-align: right; font-variant-numeric: tabular-nums; }
  .tbl.num tbody tr:last-child > * { border-top: 2px solid var(--text); border-bottom: 0; font-weight: 800; }

  .steps { margin: 0 0 var(--space-10); padding: 0; list-style: none; counter-reset: s; border-left: 2px solid var(--border); }
  .steps li { counter-increment: s; position: relative; padding: 0 0 var(--space-4) var(--space-6); font-size: var(--fs-500); line-height: var(--lh-normal); }
  .steps li:last-child { padding-bottom: 0; }
  .steps li::before {
    content: counter(s); position: absolute; left: -0.8rem; top: .1rem;
    width: 1.5rem; height: 1.5rem; border-radius: var(--radius-full);
