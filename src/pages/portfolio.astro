---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site.config';

const cases = [
  {
    number: '01',
    category: 'WEB SERVICE · AUTH',
    title: 'feelm',
    lead: '인증의 정상 흐름보다 실패·만료·동시 요청의 계약을 먼저 정했습니다.',
    context: '영화 추천 서비스 · 7인 팀 · 진행 중',
    ownership: '계정·인증 백엔드, 프론트 세션 연동',
    points: [
      '이메일·IP·전역 단위로 발송 제한을 나누고, 계정 존재 여부가 응답에 드러나지 않도록 계약 테스트를 작성했습니다.',
      '비밀번호 변경 시 남아 있던 재설정 링크를 무효화하고, 만료·중복 요청의 응답을 테스트로 고정했습니다.',
      '동시 요청이 세션 갱신 한 번을 공유하고 일시적인 갱신 실패에서 세션을 보존하도록 프론트 동작을 검증했습니다.',
    ],
    evidence: '계정·인증 테스트 291개 · 2026년 9월 기준 진행 중',
    stack: 'Java · Spring Boot · PostgreSQL · Redis · React · TypeScript',
    href: '/projects/feelm',
    link: '인증 설계와 테스트 자세히 보기',
  },
  {
    number: '02',
    category: 'REAL-TIME SYSTEM · RELIABILITY',
    title: '주차바로',
    lead: '카메라 판정이 바뀌어도 같은 영상으로 결과를 다시 확인할 수 있게 만들었습니다.',
    context: '실시간 주차 위반 감지 · SSAFY 공통 프로젝트',
    ownership: 'Jetson 판정 파이프라인, 재현 도구, 판정 로직',
    points: [
      '녹화 영상을 영상 시간 기준으로 재생하는 리플레이 도구를 만들고 JSONL·오버레이 영상으로 판정 변화를 비교했습니다.',
      '트랙 재결합 시간의 단위 오류와 출차 오판정 경로를 재현한 뒤 판정 조건을 수정했습니다.',
      '카메라 보정·RGB/BGR 불일치를 바로잡고, 좌표계는 유지한 채 탐지 입력만 마스킹했습니다.',
    ],
    evidence: '같은 영상 재실행 시 JSONL 바이트 단위 일치 · 공통 프로젝트 우수상',
    stack: 'Python · OpenCV · YOLOv8 · ByteTrack · Jetson',
    href: '/projects/baro',
    link: '재현 방법과 판정 기준 자세히 보기',
  },
  {
    number: '03',
    category: 'BACKEND · AI INTEGRATION',
    title: 'yumyum',
    lead: '기록 상태를 먼저 확인해 필요한 분석만 실행하도록 AI 호출 경계를 바꿨습니다.',
    context: '식단·운동 코칭 서비스 · 2인 팀',
    ownership: 'Spring Boot 서비스와 FastAPI 코칭 파이프라인',
    points: [
      '영양·운동·체중 기록에 따라 Agent를 선택하는 규칙을 만들고, 기록이 없으면 모델 호출 없이 안내하도록 했습니다.',
      '식품 검색에 관련성 기준과 실패 시 동작을 두어 근거 없는 수치가 답변에 들어가지 않게 했습니다.',
      '홈 코멘트 요청의 긴 외부 호출이 DB 트랜잭션을 붙잡지 않도록 호출 경계를 분리했습니다.',
    ],
    evidence: '고정 fixture 8개에서 평균 실행 Agent 4.0개 → 2.5개 · 관통 프로젝트 최우수상',
    stack: 'Java · Spring Boot · Python · FastAPI · Redis · Vue 3',
    href: '/projects/yumyum',
    link: '설계와 측정 조건 자세히 보기',
  },
];
---

<BaseLayout
  title="SW Engineer 포트폴리오"
  description="kiddo-psh의 SW Engineer 포트폴리오. 인증과 세션, 실시간 판정, AI 서비스의 호출 경계를 설계하고 검증한 프로젝트를 소개합니다."
>
  <div class="page portfolio">
    <section class="hero" aria-labelledby="portfolio-title">
      <p class="eyebrow">SOFTWARE ENGINEER · PORTFOLIO</p>
      <h1 id="portfolio-title">동작하는 기능을 넘어,<br /><span>변경을 확인할 수 있는 시스템</span>을 만듭니다.</h1>
      <p class="intro">
        안녕하세요, <strong>kiddo-psh</strong>입니다. 웹 서비스의 인증과 세션, 실시간 영상 판정,
        AI 서비스의 호출 경계를 구현해 왔습니다. 요구사항을 코드로 옮길 때 실패 조건을 먼저 정하고,
        같은 입력으로 다시 검증할 수 있는 도구와 테스트를 남깁니다.
      </p>
      <div class="hero-links">
        <a class="primary-link" href="#work">대표 프로젝트 보기 <span aria-hidden="true">↘</span></a>
        <a class="text-link" href={SITE.links.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="focus" aria-labelledby="focus-title">
      <div class="section-heading">
        <p class="eyebrow">HOW I WORK</p>
        <h2 id="focus-title">제가 반복해서 풀어온 문제</h2>
      </div>
      <div class="focus-grid">
        <div><span class="focus-index">01 / 계약</span><h3>실패를 먼저 정의합니다</h3><p>인증 실패, 토큰 만료, 중복·동시 요청에서 사용자에게 어떤 응답을 약속할지 테스트로 고정합니다.</p></div>
        <div><span class="focus-index">02 / 재현</span><h3>같은 입력으로 다시 봅니다</h3><p>실시간 파이프라인에도 리플레이 도구를 두고 판정 변경의 영향을 비교합니다.</p></div>
        <div><span class="focus-index">03 / 경계</span><h3>의존성을 분리합니다</h3><p>DB 트랜잭션, 메일 발송, AI 호출의 경계를 나눠 지연과 실패가 번지는 범위를 줄입니다.</p></div>
      </div>
    </section>

    <section class="work" id="work" aria-labelledby="work-title">
      <div class="section-heading">
        <p class="eyebrow">SELECTED WORK</p>
        <h2 id="work-title">대표 프로젝트</h2>
        <p>각 사례에 제가 맡은 범위와 확인 가능한 결과를 적었습니다. 링크에서 설계 과정과 측정 조건을 볼 수 있습니다.</p>
      </div>
      <div class="case-list">
        {cases.map((item) => (
          <article class="case">
            <div class="case-side"><span class="case-number">{item.number}</span><span class="case-category">{item.category}</span></div>
            <div class="case-main">
              <h3>{item.title}</h3>
              <p class="case-lead">{item.lead}</p>
              <div class="case-meta"><span>{item.context}</span><span>담당: {item.ownership}</span></div>
              <ul>{item.points.map((point) => <li>{point}</li>)}</ul>
              <p class="case-evidence"><strong>확인한 결과</strong> {item.evidence}</p>
              <p class="case-stack">{item.stack}</p>
              <a class="case-link" href={item.href}>{item.link} <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="more" aria-labelledby="more-title">
      <div><p class="eyebrow">ENGINEERING PRACTICE</p><h2 id="more-title">개발 과정도 검증 가능하게</h2></div>
      <div><p>AI를 활용해 구현 속도가 빨라질수록 변경의 영향을 확인하는 기준이 필요하다고 생각합니다. 프로젝트에서 작업 규칙과 영역별 검증 명령, 변경 감지·종료 시점 확인 절차를 갖춘 개발 하네스를 만들고 있습니다.</p><p class="more-note">진행 중인 개인 도구이며, 팀 적용 성과로 계산하지 않았습니다.</p></div>
    </section>

    <section class="contact" aria-labelledby="contact-title">
      <p class="eyebrow">CONTACT</p>
      <h2 id="contact-title">함께 일할 기회를 찾고 있습니다.</h2>
      <p>서비스를 구현하고, 실패를 재현하고, 변경 후에도 약속이 지켜지는지 확인하는 일을 좋아합니다.</p>
      <div class="contact-links"><a href={`mailto:${SITE.links.email}`}>이메일 보내기 <span aria-hidden="true">↗</span></a><a href={SITE.links.github} target="_blank" rel="noopener noreferrer">GitHub 보기 <span aria-hidden="true">↗</span></a><a href="/about">이력과 기술 보기 <span aria-hidden="true">↗</span></a></div>
    </section>
  </div>
</BaseLayout>

<style>
  .portfolio { padding-bottom: var(--space-20); }
  .eyebrow { margin: 0 0 var(--space-4); color: var(--accent); font-family: var(--font-mono); font-size: var(--fs-200); font-weight: 700; letter-spacing: var(--ls-label); }
  .hero { max-width: 860px; padding: var(--space-20) 0 var(--space-16); }
  h1, h2, h3, p { margin-top: 0; }
  h1 { margin-bottom: var(--space-8); font-family: var(--font-serif); font-size: clamp(2.1rem, 1.35rem + 3vw, 3.7rem); line-height: var(--lh-tight); letter-spacing: var(--ls-tight); }
  h1 span { color: var(--accent); }
  .intro { max-width: 690px; margin-bottom: var(--space-8); color: var(--text-dim); font-size: var(--fs-lead); line-height: var(--lh-relaxed); }
  .intro strong { color: var(--text); }
  .hero-links, .contact-links { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-5); }
  .primary-link { display: inline-flex; align-items: center; gap: var(--space-5); padding: var(--space-3) var(--space-5); border-radius: var(--radius-md); background: var(--accent); color: var(--bg-elev); font-size: var(--fs-300); font-weight: 700; }
  .primary-link:hover { text-decoration: none; filter: brightness(1.12); }
  .text-link, .case-link { font-size: var(--fs-300); font-weight: 700; }
  .focus, .work, .more { border-top: 1px solid var(--border); padding: var(--space-14) 0; }
  .section-heading { margin-bottom: var(--space-8); }
  .section-heading h2, .more h2, .contact h2 { margin-bottom: var(--space-3); font-size: var(--fs-800); line-height: var(--lh-tight); letter-spacing: var(--ls-snug); }
  .section-heading > p:last-child { max-width: 650px; margin-bottom: 0; color: var(--text-dim); font-size: var(--fs-400); }
  .focus-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); }
  .focus-grid > div { padding: var(--space-6); border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--bg-elev); }
  .focus-index { color: var(--accent); font-family: var(--font-mono); font-size: var(--fs-200); }
  .focus h3 { margin: var(--space-5) 0 var(--space-2); font-size: var(--fs-600); line-height: var(--lh-snug); }
  .focus-grid p { margin: 0; color: var(--text-dim); font-size: var(--fs-300); line-height: var(--lh-normal); }
  .case { display: grid; grid-template-columns: 156px minmax(0, 1fr); gap: var(--space-8); padding: var(--space-10) 0; border-top: 1px solid var(--border); }
  .case:last-child { border-bottom: 1px solid var(--border); }
  .case-side { display: flex; flex-direction: column; gap: var(--space-2); }
  .case-number { font-family: var(--font-serif); font-size: var(--fs-900); line-height: 1; }
  .case-category { color: var(--text-dim); font-family: var(--font-mono); font-size: var(--fs-100); letter-spacing: .05em; }
  .case h3 { margin: 0 0 var(--space-3); font-size: var(--fs-700); line-height: var(--lh-tight); }
  .case-lead { margin-bottom: var(--space-5); font-size: var(--fs-500); font-weight: 700; line-height: var(--lh-snug); }
  .case-meta { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); color: var(--text-dim); font-size: var(--fs-300); }
  .case ul { margin: var(--space-6) 0; padding-left: 1.3em; font-size: var(--fs-400); line-height: var(--lh-normal); }
  .case li { margin-bottom: var(--space-2); }
  .case li::marker { color: var(--accent); }
  .case-evidence { margin-bottom: var(--space-2); font-size: var(--fs-300); }
  .case-evidence strong { margin-right: var(--space-2); color: var(--accent); }
  .case-stack { margin-bottom: var(--space-5); color: var(--text-dim); font-family: var(--font-mono); font-size: var(--fs-200); }
  .more { display: grid; grid-template-columns: 1fr 1.5fr; gap: var(--space-8); }
  .more p:not(.eyebrow) { margin-bottom: var(--space-3); color: var(--text-dim); font-size: var(--fs-400); }
  .more .more-note { font-size: var(--fs-300) !important; }
  .contact { padding: var(--space-12); border-radius: var(--radius-xl); background: var(--accent-soft); }
  .contact > p:not(.eyebrow) { margin-bottom: var(--space-6); color: var(--text-dim); font-size: var(--fs-400); }
  .contact-links a { font-size: var(--fs-300); font-weight: 700; }
  @media (max-width: 700px) { .hero { padding: var(--space-14) 0; } .focus-grid { grid-template-columns: 1fr; } .case { grid-template-columns: 1fr; gap: var(--space-4); } .case-side { flex-direction: row; align-items: center; gap: var(--space-4); } .case-number { font-size: var(--fs-700); } .more { grid-template-columns: 1fr; gap: var(--space-2); } .contact { padding: var(--space-8); } }
</style>
