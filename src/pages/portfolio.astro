---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site.config';

const projects = [
  {
    number: '01',
    title: 'feelm',
    subtitle: '영화 추천 서비스의 계정과 인증',
    context: '7인 팀 · Java / Spring Boot / Redis / React',
    role: '계정·인증 백엔드, 프론트 세션 연동, 테스트 환경 개선',
    work: [
      {
        label: '동시 로그인',
        detail: '실패 4회 뒤 동시 요청이 모두 비밀번호 검사로 들어가던 잠금 경합을 원자적 시도 집계로 수정했습니다.',
        proof: '동시 요청 4건 중 1건만 검사(401), 3건 차단(429)을 계약 테스트로 확인',
      },
      {
        label: '세션 복구',
        detail: '재발급 5xx에서도 로그아웃시키던 제 코드를 고쳐 401에서만 세션을 종료했습니다. 동시 만료 요청은 재발급 한 번을 공유합니다.',
        proof: '500·502·503·504 세션 유지, 동시 요청 3건의 재발급 1회 테스트',
      },
      {
        label: '테스트 신뢰성',
        detail: 'Spring 테스트 설정 차이를 수집·대조하는 스크립트를 만들어 불필요한 context 분리를 정리했습니다.',
        proof: 'context 생성 42→30회, 캐시 재생성 0회, 전체 테스트 2,197개 통과',
      },
    ],
  },
  {
    number: '02',
    title: '주차바로',
    subtitle: '실시간 주차 위반 판정',
    context: '7인 팀 · Python / OpenCV / YOLOv8 / Jetson',
    role: '영상 판정 흐름과 리플레이 검증 도구',
    work: [
      {
        label: '판정 재현',
        detail: '녹화 영상을 영상 시간 기준으로 다시 흘리는 도구를 만들어 변경 전후 판정을 비교했습니다.',
        proof: '같은 영상 재실행 시 판정 JSONL이 바이트 단위로 일치',
      },
      {
        label: '오판정 수정',
        detail: '화면에서 사라진 차량을 출차로 처리하던 조건을 출차 구역 통과 관측으로 바꾸고, 트랙 보관 설정의 프레임·초 단위 오류를 수정했습니다.',
        proof: '각 실패 경로를 재현 테스트로 고정 · SSAFY 공통 프로젝트 우수상',
      },
    ],
  },
  {
    number: '03',
    title: 'yumyum',
    subtitle: '식단·운동 기록 기반 코칭 서비스',
    context: '2인 팀 · Java / Spring Boot / Python / FastAPI',
    role: '서비스 백엔드와 AI 코칭 호출 흐름',
    work: [
      {
        label: '호출 기준',
        detail: '기록이 없어도 Agent 네 개를 모두 실행하던 흐름을 기록별 선택 방식으로 바꿨습니다. 기록이 없으면 모델을 호출하지 않습니다.',
        proof: '고정 입력 8개에서 평균 실행 Agent 4.0→2.5개',
      },
      {
        label: '외부 호출 경계',
        detail: '식품 검색에 관련성 기준을 두고, 홈 코멘트의 FastAPI 응답을 기다리는 동안 DB 트랜잭션을 붙잡지 않게 분리했습니다.',
        proof: '호출·실패 규칙을 테스트로 고정 · SSAFY 관통 프로젝트 최우수상',
      },
    ],
    note: 'Agent 수는 동일 비중의 평가 입력 기준이며 실제 사용자 트래픽 평균은 아닙니다.',
  },
];
---

<BaseLayout
  title="박시현 · SW Engineer 포트폴리오"
  description="박시현의 SW Engineer 포트폴리오. 인증 동시성, 세션 복구, 실시간 판정 재현과 AI 호출 경계를 실제 프로젝트 결과로 소개합니다."
>
  <div class="page portfolio">
    <section class="hero" aria-labelledby="portfolio-title">
      <p class="eyebrow">SOFTWARE ENGINEER / PORTFOLIO</p>
      <h1 id="portfolio-title">실패까지 설계하고,<br /><span>테스트로 확인합니다.</span></h1>
      <p class="intro">박시현입니다. 인증, 실시간 판정, AI 연동 서비스를 만들며 동시 요청과 장애 상황에서 무엇이 일어나는지 확인해 왔습니다.</p>
      <a class="jump" href="#projects">프로젝트 보기 <span aria-hidden="true">↓</span></a>
    </section>

    <section id="projects" aria-labelledby="projects-title">
      <div class="section-title"><p class="eyebrow">SELECTED WORK</p><h2 id="projects-title">대표 경험</h2></div>
      {projects.map((project) => (
        <article class="project">
          <div class="project-head">
            <span class="number">{project.number}</span>
            <div>
              <h3>{project.title}</h3>
              <p class="subtitle">{project.subtitle}</p>
              <p class="context">{project.context}</p>
            </div>
          </div>
          <p class="role"><strong>담당</strong> {project.role}</p>
          <div class="work-list">
            {project.work.map((item) => (
              <div class="work-item">
                <h4>{item.label}</h4>
                <div><p>{item.detail}</p><p class="proof"><strong>확인</strong> {item.proof}</p></div>
              </div>
            ))}
          </div>
          {project.note && <p class="note">{project.note}</p>}
        </article>
      ))}
    </section>

    <footer class="contact">
      <p>더 자세한 구현과 협업 경험이 궁금하시면 연락 주세요.</p>
      <a href={`mailto:${SITE.links.email}`}>이메일 <span aria-hidden="true">↗</span></a>
      <a href={SITE.links.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
    </footer>
  </div>
</BaseLayout>

<style>
  .portfolio { padding-bottom: var(--space-16); }
  .eyebrow { margin: 0 0 var(--space-4); color: var(--accent); font-family: var(--font-mono); font-size: var(--fs-200); font-weight: 700; letter-spacing: .08em; }
  h1, h2, h3, h4, p { margin-top: 0; }
  .hero { padding: var(--space-16) 0 var(--space-14); }
  h1 { margin-bottom: var(--space-6); font-family: var(--font-serif); font-size: clamp(2.2rem, 1.45rem + 3vw, 3.8rem); line-height: var(--lh-tight); letter-spacing: var(--ls-tight); }
  h1 span { color: var(--accent); }
  .intro { max-width: 650px; margin-bottom: var(--space-6); color: var(--text-dim); font-size: var(--fs-lead); line-height: var(--lh-normal); }
  .jump { font-size: var(--fs-300); font-weight: 700; }
  .section-title { display: flex; align-items: baseline; gap: var(--space-5); padding: var(--space-8) 0 var(--space-4); border-top: 1px solid var(--border); }
  .section-title .eyebrow { margin: 0; }
  .section-title h2 { margin: 0; font-size: var(--fs-700); }
  .project { padding: var(--space-8) 0 var(--space-10); border-bottom: 1px solid var(--border); }
  .project-head { display: flex; gap: var(--space-5); align-items: baseline; margin-bottom: var(--space-4); }
  .number { min-width: 2.5rem; color: var(--accent); font-family: var(--font-mono); font-size: var(--fs-300); font-weight: 700; }
  h3 { margin: 0; font-size: var(--fs-700); line-height: var(--lh-tight); }
  .subtitle { margin: var(--space-1) 0 0; font-size: var(--fs-400); font-weight: 600; }
  .context { margin: var(--space-2) 0 0; color: var(--text-dim); font-size: var(--fs-300); }
  .role { margin: 0 0 var(--space-4) 3.75rem; font-size: var(--fs-300); }
  .role strong { margin-right: var(--space-2); color: var(--accent); }
  .work-list { margin-left: 3.75rem; border-top: 1px solid var(--border); }
  .work-item { display: grid; grid-template-columns: 8rem minmax(0, 1fr); gap: var(--space-4); padding: var(--space-4) 0; border-bottom: 1px solid var(--border); }
  .work-item:last-child { border-bottom: 0; }
  h4 { margin: 0; font-size: var(--fs-400); line-height: var(--lh-normal); }
  .work-item p { margin: 0; font-size: var(--fs-400); line-height: var(--lh-normal); }
  .work-item .proof { margin-top: var(--space-2); color: var(--text-dim); font-size: var(--fs-300); }
  .proof strong { margin-right: var(--space-2); color: var(--accent); }
  .note { margin: var(--space-3) 0 0 3.75rem; color: var(--text-dim); font-size: var(--fs-200); }
  .contact { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-3) var(--space-6); padding-top: var(--space-10); }
  .contact p { flex-basis: 100%; margin: 0; font-size: var(--fs-400); font-weight: 600; }
  .contact a { font-size: var(--fs-300); font-weight: 700; }
  @media (max-width: 600px) { .hero { padding: var(--space-12) 0; } .section-title { display: block; } .section-title h2 { margin-top: var(--space-2); } .role, .work-list, .note { margin-left: 0; } .work-item { grid-template-columns: 1fr; gap: var(--space-1); } .work-item h4 { color: var(--accent); } }
</style>
