---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site.config';
import { portfolioCases as cases, highlights, skills, education, awards, certificates } from '../data/portfolio';
import { inline as inlineSvg } from '../lib/inline-svg.mjs';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Mail from '@lucide/astro/icons/mail';
import Printer from '@lucide/astro/icons/printer';

/*
 * 포트폴리오. 제출한 이력서와 같은 내용·순서를 쓰고, 블로그 디자인 토큰을 따르지 않는다.
 * 프로젝트마다 개요(소개·담당·숫자·화면)와 문제 해결 사례 두 개(상황 → 해결 → 성과)를 한 열로 쌓는다.
 * 보조 글은 숫자를 다르게 읽게 만드는 것만 둔다. 나머지 설명은 프로젝트 상세 페이지에 있다.
 */

// **강조**만 허용한다. 나머지는 이스케이프해서 데이터의 꺾쇠가 마크업이 되지 않게 한다
const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const rich = (s: string) => escape(s).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
const pct = (v: number, max: number) => `${Math.max(2, (v / max) * 100)}%`;
---
<BaseLayout title="박시현 · 포트폴리오" description="문제를 측정 가능한 기준으로 정의하고, 평가셋과 계측 도구로 AI 시스템의 설계 판단을 검증한 박시현의 프로젝트를 소개합니다.">
  <div class="page pf">
    <header class="pf-head">
      <img class="pf-photo" src="/images/profile.jpg" alt="박시현 증명사진" width="480" height="617" decoding="async" />
      <div class="pf-head-text">
        <p class="pf-name">박시현</p>
        <h1>문제를 측정 가능한 기준으로 정의하고, <br />AI가 현장의 제약 안에서 동작하는지 검증합니다.</h1>
        <p class="pf-intro">평가셋과 계측 도구를 직접 만들어 설계 판단을 숫자로 확인합니다.</p>
        <p class="pf-status">SSAFY 15기 (2026.12 수료 예정) · 경희대학교 생체의공학과</p>
        <div class="pf-contact">
          <a href={`mailto:${SITE.links.email}`}><Mail size={16} />{SITE.links.email}</a>
          <a href={SITE.links.github} target="_blank" rel="noopener noreferrer">GitHub<ArrowUpRight size={15} /></a>
          <button type="button" id="portfolio-print"><Printer size={15} />PDF로 저장</button>
        </div>
      </div>
    </header>

    <section class="pf-section" aria-labelledby="highlights-title">
      <h2 id="highlights-title" class="pf-label">대표 성과</h2>
      <ul class="highlights">
        {highlights.map(h => (
          <li><a href={h.href}><span class="h-label">{h.label}</span><strong>{h.value}</strong><span class="h-from">{h.from}</span></a></li>
        ))}
      </ul>
    </section>

    <section class="pf-section" aria-labelledby="projects-title">
      <h2 id="projects-title" class="pf-label">프로젝트</h2>
      <ol class="toc">
        {cases.map(p => (
          <li><a href={`#${p.id}`}><span class="toc-num">{p.number}</span><strong>{p.title}</strong><span class="toc-date">{p.period}</span></a></li>
        ))}
      </ol>

      {cases.map(p => (
        <article class="case" id={p.id} aria-labelledby={`${p.id}-title`}>
          <header class="case-head">
            <h3 id={`${p.id}-title`}><span class="case-num">{p.number}</span>{p.title}</h3>
            <span class="case-date">{p.period}</span>
          </header>

          <p class="case-summary">{p.summary}</p>
          <p class="case-meta"><span>{p.team}</span>{p.award && <span class="case-award">{p.award}</span>}</p>

          <ul class="roles">{p.roles.map(r => <li>{r}</li>)}</ul>

          <dl class="metrics">
            {p.metrics.map(m => (
              <div><dt>{m.label}</dt><dd class="m-value">{m.value}</dd>{m.note && <dd class="m-note">{m.note}</dd>}</div>
            ))}
          </dl>

          {p.figure && (
            <figure class="case-figure">
              {/* 도해 SVG는 인라인으로 심어야 사이트 테마 토글을 따른다 */}
              {p.figure.src.endsWith('.svg')
                ? <div class="svg-wrap" set:html={inlineSvg(p.figure.src)} />
                : <a href={p.figure.src} aria-label={`${p.title} 이미지 원본 보기`}><img src={p.figure.src} alt={p.figure.alt} loading="lazy" decoding="async" /></a>}
              {p.figure.caption && <figcaption>{p.figure.caption}</figcaption>}
            </figure>
          )}

          <h4 class="sol-heading">기술적 문제 해결</h4>
          {p.solutions.map((s, i) => (
            <section class="sol">
              <h5><span>{i + 1})</span>{s.title}</h5>
              <dl class="sar">
                <div><dt>상황</dt><dd>{s.situation}</dd></div>
                <div><dt>해결</dt><dd><ul>{s.actions.map(a => <li set:html={rich(a)} />)}</ul></dd></div>
                <div><dt>성과</dt><dd>
                  <ul>{s.results.map(r => <li set:html={rich(r)} />)}</ul>
                  {s.compare && (() => {
                    const max = Math.max(...s.compare.rows.map(r => r.before));
                    return (
                      <figure class="compare" aria-label={s.compare.caption}>
                        <figcaption>{s.compare.caption}<span><i class="k-before" />전 <i class="k-after" />후</span></figcaption>
                        {s.compare.rows.map(r => (
                          <div class="cmp-row">
                            <span class="cmp-label">{r.label}</span>
                            <div class="cmp-bars">
                              <div class="bar before" style={`width:${pct(r.before, max)}`}><b>{r.before}{s.compare!.unit}</b></div>
                              <div class="bar after" style={`width:${pct(r.after, max)}`}><b>{r.after}{s.compare!.unit}</b></div>
                            </div>
                          </div>
                        ))}
                      </figure>
                    );
                  })()}
                </dd></div>
              </dl>
            </section>
          ))}

          <footer class="case-foot">
            <p class="boundary">※ {p.boundary}</p>
            <span class="case-links">
              {p.links.map(l => l.external
                ? <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}<ArrowUpRight size={15} /></a>
                : <a href={l.href}>{l.label}<ArrowRight size={15} /></a>)}
            </span>
          </footer>
        </article>
      ))}
    </section>

    <section class="pf-section" aria-labelledby="skills-title">
      <h2 id="skills-title" class="pf-label">기술</h2>
      <dl class="rows">
        {skills.map(s => <div><dt>{s.k}</dt><dd>{s.v}</dd></div>)}
      </dl>
    </section>

    <section class="pf-section" aria-labelledby="edu-title">
      <h2 id="edu-title" class="pf-label">교육</h2>
      <dl class="rows">
        {education.map(e => <div><dt>{e.date}</dt><dd><strong>{e.title}</strong> · {e.text}</dd></div>)}
      </dl>
    </section>

    <div class="pf-split">
      <section class="pf-section" aria-labelledby="awards-title">
        <h2 id="awards-title" class="pf-label">수상</h2>
        <dl class="rows compact">
          {awards.map(a => <div><dt>{a.date}</dt><dd>{a.text}</dd></div>)}
        </dl>
      </section>
      <section class="pf-section" aria-labelledby="cert-title">
        <h2 id="cert-title" class="pf-label">자격·어학</h2>
        <dl class="rows compact">
          {certificates.map(c => <div><dt>{c.date}</dt><dd>{c.text}</dd></div>)}
        </dl>
      </section>
    </div>

    <footer class="pf-end">
      <a href={`mailto:${SITE.links.email}`}><Mail size={16} />{SITE.links.email}</a>
      <a href={SITE.links.github} target="_blank" rel="noopener noreferrer">GitHub<ArrowUpRight size={15} /></a>
    </footer>
  </div>
</BaseLayout>

<script>
  document.getElementById('portfolio-print')?.addEventListener('click', () => window.print());
</script>

<style>
  /*
   * 색은 본문 도해(diagram-theme.css)와 같은 벌을 쓴다. 강조는 g 초록, 면은 q 회색,
   * 비교 막대의 전/후는 q-bar / g-bar. 보조 글은 대비를 지키게 한 단계 진한 회색을 쓴다
   */
  .pf {
    --ink:#191f28; --body:#333d4b; --muted:#4e5968; --line:#e5e8eb; --surface:#f2f4f6;
    --accent:#246b50; --accent-bg:#eaf4ee; --bar:#a6afb9;
    max-width:860px; padding-bottom:72px; color:var(--body);
    font-size:16.5px; line-height:1.7; word-break:keep-all;
  }
  :global([data-theme="dark"]) .pf {
    --ink:#f9fafb; --body:#e5e8eb; --muted:#b0b8c1; --line:#333d4b; --surface:#262b32;
    --accent:#80cfa7; --accent-bg:#1e332a; --bar:#77838f;
  }
  .pf h1,.pf h2,.pf h3,.pf h4,.pf h5,.pf p,.pf ul,.pf ol,.pf dl,.pf dd,.pf figure { margin:0; }
  .pf a { color:var(--accent); display:inline-flex; align-items:center; gap:6px; }
  .pf a:hover { text-decoration:underline; text-underline-offset:3px; }
  .pf strong { color:var(--ink); font-weight:700; }

  /* 머리 */
  .pf-head { display:grid; grid-template-columns:minmax(0,1fr) 140px; gap:40px; align-items:center; padding:56px 0 40px; border-bottom:1px solid var(--line); }
  .pf-photo { grid-column:2; grid-row:1; width:140px; height:auto; border-radius:12px; }
  .pf-head-text { grid-column:1; grid-row:1; min-width:0; }
  .pf-name { color:var(--ink); font-size:20px; font-weight:700; margin-bottom:12px; }
  .pf h1 { color:var(--ink); font-size:clamp(25px,3.4vw,33px); line-height:1.45; font-weight:750; letter-spacing:-.03em; margin-bottom:14px; }
  .pf-intro { font-size:17px; margin-bottom:6px; }
  .pf-status { font-size:15px; font-weight:600; color:var(--muted); margin-bottom:20px !important; }
  .pf-contact { display:flex; flex-wrap:wrap; gap:10px 22px; align-items:center; font-size:15px; font-weight:600; }
  #portfolio-print { display:inline-flex; align-items:center; gap:6px; padding:0; border:0; background:none; color:var(--muted); font:inherit; cursor:pointer; }
  #portfolio-print:hover { color:var(--accent); }

  /* 섹션 공통 */
  .pf-section { padding-top:48px; }
  .pf-label { color:var(--ink); font-size:20px; font-weight:750; letter-spacing:-.02em; margin-bottom:16px !important; }

  /* 대표 성과 */
  .highlights { list-style:none; padding:0; display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12px; }
  .highlights a { display:flex; flex-direction:column; align-items:flex-start; gap:2px; height:100%; padding:18px; border-radius:12px; background:var(--surface); color:var(--body); }
  .highlights a:hover { text-decoration:none; outline:2px solid var(--accent); }
  .h-label { font-size:14px; font-weight:600; color:var(--body); }
  .highlights strong { color:var(--accent); font-size:24px; line-height:1.35; font-weight:800; letter-spacing:-.02em; font-variant-numeric:tabular-nums; }
  .h-from { font-size:13px; color:var(--muted); margin-top:6px; }

  /* 프로젝트 목차 */
  .toc { list-style:none; padding:0; display:grid; grid-template-columns:repeat(auto-fill,minmax(270px,1fr)); gap:0 28px; border-top:1px solid var(--line); }
  .toc li { border-bottom:1px solid var(--line); }
  .toc a { display:grid; grid-template-columns:28px minmax(0,1fr) auto; gap:10px; align-items:baseline; padding:11px 0; color:var(--body); }
  .toc a:hover { text-decoration:none; }
  .toc a:hover strong { color:var(--accent); }
  .toc-num { color:var(--accent); font-size:14px; font-weight:700; font-variant-numeric:tabular-nums; }
  .toc strong { font-size:16px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .toc-date { font-size:14px; color:var(--muted); font-variant-numeric:tabular-nums; }

  /* 프로젝트 */
  .case { padding:64px 0 8px; scroll-margin-top:80px; }
  .case-head { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:baseline; gap:4px 16px; padding-bottom:12px; margin-bottom:16px; border-bottom:2px solid var(--ink); }
  .case h3 { color:var(--ink); font-size:30px; line-height:1.3; font-weight:800; letter-spacing:-.025em; }
  .case-num { color:var(--accent); font-size:17px; font-weight:750; margin-right:12px; font-variant-numeric:tabular-nums; }
  .case-date { color:var(--muted); font-size:15px; font-weight:600; font-variant-numeric:tabular-nums; }
  .case-summary { color:var(--ink); font-size:18px; font-weight:600; line-height:1.6; }
  .case-meta { display:flex; flex-wrap:wrap; align-items:center; gap:8px 12px; margin-top:8px !important; font-size:15px; color:var(--body); }
  .case-award { padding:2px 10px; border-radius:6px; background:var(--accent-bg); color:var(--accent); font-size:14px; font-weight:700; }

  .roles { list-style:none; padding:0; display:flex; flex-wrap:wrap; gap:8px; margin-top:18px !important; }
  .roles li { padding:5px 12px; border:1px solid var(--line); border-radius:999px; font-size:14.5px; font-weight:500; }

  .metrics { display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:12px; margin-top:22px !important; }
  .metrics > div { padding:14px 16px; border-radius:10px; background:var(--surface); }
  .metrics dt { font-size:14px; font-weight:600; color:var(--body); }
  .m-value { color:var(--accent); font-size:23px; font-weight:800; line-height:1.35; letter-spacing:-.02em; font-variant-numeric:tabular-nums; margin-top:2px !important; }
  .m-note { font-size:13px; color:var(--muted); }

  .case-figure { margin-top:22px !important; }
  .case-figure a { display:block; }
  .case-figure img { display:block; width:100%; max-height:400px; object-fit:contain; border-radius:10px; background:var(--surface); }
  .svg-wrap { padding:12px; border-radius:10px; background:var(--surface); }
  .svg-wrap :global(svg) { display:block; width:100%; height:auto; }
  .case-figure figcaption { margin-top:6px; font-size:13.5px; color:var(--muted); }

  /* 문제 해결 */
  /* 구역 표시일 뿐이라 숫자 카드보다 약하게. 옅은 바탕에 강조색 글자 */
  .sol-heading { margin-top:36px !important; padding:8px 14px; border-left:3px solid var(--accent); border-radius:0 6px 6px 0; background:var(--accent-bg); color:var(--accent); font-size:15px; font-weight:700; }
  .sol { margin-top:24px; }
  .sol + .sol { padding-top:24px; border-top:1px solid var(--line); }
  .sol h5 { color:var(--ink); font-size:19px; font-weight:750; line-height:1.45; letter-spacing:-.02em; margin-bottom:10px !important; }
  .sol h5 span { color:var(--accent); margin-right:8px; }
  .sar > div { display:grid; grid-template-columns:44px minmax(0,1fr); gap:12px; padding:7px 0; }
  .sar dt { color:var(--accent); font-size:15px; font-weight:750; line-height:1.7; }
  .sar ul { padding-left:18px; }
  .sar li + li { margin-top:4px; }
  .sar li::marker { color:var(--muted); }

  /* 전후 비교 막대 */
  .compare { margin-top:12px !important; padding:14px 16px; border-radius:10px; background:var(--surface); max-width:520px; }
  .compare figcaption { display:flex; justify-content:space-between; gap:12px; font-size:13.5px; font-weight:600; color:var(--body); margin-bottom:10px; }
  .compare figcaption span { display:inline-flex; align-items:center; gap:6px; font-weight:500; }
  .compare i { display:inline-block; width:10px; height:10px; border-radius:2px; }
  .compare i.k-after { margin-left:8px; }
  .k-before, .bar.before { background:var(--bar); }
  .k-after, .bar.after { background:var(--accent); }
  .cmp-row { display:grid; grid-template-columns:72px minmax(0,1fr); gap:10px; align-items:center; }
  .cmp-row + .cmp-row { margin-top:10px; }
  .cmp-label { font-size:13.5px; }
  .cmp-bars { display:grid; gap:3px; padding-right:52px; }
  .bar { position:relative; height:16px; border-radius:3px; }
  .bar b { position:absolute; left:calc(100% + 6px); top:50%; transform:translateY(-50%); font-size:12.5px; font-weight:700; color:var(--body); white-space:nowrap; font-variant-numeric:tabular-nums; }
  .bar.after b { color:var(--accent); }

  .case-foot { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:baseline; gap:8px 24px; margin-top:24px; padding-top:14px; border-top:1px solid var(--line); }
  .boundary { flex:1 1 360px; font-size:14px; color:var(--muted); }
  .case-links { display:flex; flex-wrap:wrap; gap:18px; font-size:15px; font-weight:700; }

  /* 이력 */
  .rows > div { display:grid; grid-template-columns:150px minmax(0,1fr); gap:16px; padding:11px 0; border-top:1px solid var(--line); }
  .rows > div:last-child { border-bottom:1px solid var(--line); }
  .rows dt { color:var(--ink); font-size:15px; font-weight:700; font-variant-numeric:tabular-nums; }
  .rows dd { font-size:15.5px; }
  .rows.compact > div { grid-template-columns:72px minmax(0,1fr); padding:9px 0; }
  .rows.compact dt { font-weight:600; color:var(--muted); }
  .pf-split { display:grid; grid-template-columns:1fr 1fr; gap:40px; }

  .pf-end { display:flex; flex-wrap:wrap; gap:10px 22px; margin-top:48px; padding-top:24px; border-top:1px solid var(--line); font-size:15px; font-weight:600; }

  @media (max-width:760px) {
    .pf-head { grid-template-columns:1fr; gap:20px; }
    .pf-photo, .pf-head-text { grid-column:1; grid-row:auto; }
    .pf-photo { width:96px; border-radius:10px; }
    .highlights { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .pf-split { grid-template-columns:1fr; gap:0; }
  }
  @media (max-width:520px) {
    .pf { font-size:16px; }
    .pf-head { padding-top:32px; }
    .pf h1 br { display:none; }
    .highlights strong { font-size:21px; }
    .highlights a { padding:14px; }
    .case { padding-top:48px; }
    .case h3 { font-size:25px; }
    .case-summary { font-size:17px; }
    .sar > div { grid-template-columns:1fr; gap:0; }
    .rows > div { grid-template-columns:1fr; gap:2px; }
    .rows.compact > div { grid-template-columns:66px minmax(0,1fr); gap:10px; }
  }
  @media print {
    :global(body > header),:global(body > footer),#portfolio-print { display:none !important; }
    :global(html) { color-scheme:light; }
    .pf { --ink:#111; --body:#222; --muted:#555; --line:#ddd; --surface:#f4f6f9; --accent:#246b50; --accent-bg:#eaf4ee; --bar:#a6afb9; max-width:none; padding:0; font-size:10pt; }
    .pf-head { padding-top:0; }
    .highlights { grid-template-columns:repeat(4,1fr); }
    .case { break-before:page; padding-top:0; }
    .case-figure img { max-height:70mm; }
    .pf a { text-decoration:none; }
    h3,h4,h5 { break-after:avoid; }
    .sol,.metrics,figure { break-inside:avoid; }
  }
</style>
