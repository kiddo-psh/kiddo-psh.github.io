---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site.config';
import Search from '@lucide/astro/icons/search';
import Network from '@lucide/astro/icons/network';
import Cable from '@lucide/astro/icons/cable';
import ChartNoAxesColumn from '@lucide/astro/icons/chart-no-axes-column';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Mail from '@lucide/astro/icons/mail';

/*
 * 포트폴리오 한 장. 프로젝트마다 읽는 순서를 같게 둔다:
 * 무엇(머리) → 한 일(헤드라인) → 누구의 어떤 문제였나 → 자동화한 흐름(서비스만)
 * → 제가 한 일 세 줄 → 근거(표·그림, 필요할 때만) → 결과 숫자 → 검증 범위.
 * 기술 설명보다 "왜 만들었고 무엇이 달라졌나"가 먼저 읽히게 한다. 기술 근거는 지우지 않고 그 아래에 둔다.
 *
 * 앞의 둘(service)은 끝까지 만든 서비스, 뒤의 둘(practice)은 검증과 개발 도구 사례다.
 *
 * 아이콘은 Lucide 하나로 통일하고 기능에만 쓴다(일하는 방식 네 칸, 링크 화살표, 메일).
 * 프로젝트 정체성은 Motif 마크가 맡으므로 프로젝트별 아이콘은 두지 않는다.
 *
 * 그림은 글로 대신할 수 없는 것만 넣는다. 지금은 주차 감지 화면 하나이고,
 * 넣었으면 텍스트 칼럼을 넘어 페이지 폭을 다 쓴다. 단계별 시간·라우팅 규칙·작업 흐름은
 * 표와 목록이 그림보다 읽기 쉬워서 그림으로 그리지 않는다.
 */

interface Brief { k: string; v: string }
interface Metric { label: string; value: string; note?: string }
interface Finding { value: string; label: string; title: string; text: string }
interface Table { head: string[]; rows: string[][]; numeric?: boolean }
interface Project {
  id: string;
  group: 'service' | 'practice';
  title: string;
  stack: string;
  highlight: string;
  headline: string;
  /** 팀 규모와 맡은 범위 */
  role?: string;
  /** 사용자 쪽에서 본 문제. 기술 문제가 아니라 누가 무엇을 겪었는지 */
  problem?: string;
  /** 자동화한 흐름. mine은 제가 맡은 단계 */
  flow?: { name: string; text: string; mine?: boolean }[];
  brief: Brief[];
  /** 무엇까지 확인했고 어디부터는 확인하지 못했는지 */
  scope?: string;
  figure?: { src: string; alt: string; caption: string };
  table?: Table;
  steps?: { name: string; text?: string }[];
  findings?: Finding[];
  metrics?: Metric[];
  conclusion?: string;
  notes?: string[];
  more?: { href: string; label: string };
}

const projects: Project[] = [
