---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileHeader from '../components/ProfileHeader.astro';
import CategoryTabs from '../components/CategoryTabs.astro';
import PostListItem from '../components/PostListItem.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getVisiblePosts } from '../lib/posts';
import { getCollection } from 'astro:content';
import { SITE } from '../site.config';
import { briefings, briefingLabels } from '../lib/briefings';

const posts = (await getVisiblePosts()).slice(0, 6);
const allProjects = await getCollection('projects');
const featured = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<BaseLayout title={SITE.title}>
  <div class="page">
    <ProfileHeader projectCount={allProjects.length} />
    <CategoryTabs active="all" />
    <div class="post-list">
      {posts.map((post) => <PostListItem post={post} headingLevel={2} />)}
    </div>
    <p class="all"><a href="/posts">글 전체 보기 →</a></p>
    {briefings.length > 0 && <section class="briefing-preview" aria-labelledby="briefing-title">
      <div class="briefing-heading">
        <div>
          <p class="briefing-kicker">CURATED READING · AI BRIEFING</p>
          <h2 id="briefing-title" class="sec-h">AI 브리핑</h2>
        </div>
        <a href="/ai-briefing">전체 보기 →</a>
      </div>
      <p class="briefing-desc">기사·인터뷰·논문에서 개발에 연결되는 자료만 골라 읽는 공간입니다.</p>
      <div class="briefing-rows">
        {briefings.slice(0, 2).map((item) => (
          <a href="/ai-briefing" class="briefing-row">
            <span class="briefing-type">{briefingLabels[item.type]}</span>
            <span class="briefing-title">{item.title}</span>
            <span class="briefing-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>}
    {featured.length > 0 && (
      <section class="pj">
        <h2 class="sec-h">프로젝트</h2>
        <div class="pj-grid">
          {featured.map((project) => <ProjectCard project={project} />)}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  /* margin-bottom을 명시하지 않으면 브라우저 기본 1em(=17px)이 들어와 그리드를 벗어난다 */
  .all { margin: var(--space-6) 0 var(--space-8); font-size: var(--fs-400); }

  /*
   * 홈의 두 섹션(브리핑·프로젝트)은 같은 층위다. 전에는 "AI 브리핑"이 24.3px 잉크색,
   * "프로젝트"가 14.8px 흐린색이라 한 화면 안에서 같은 급으로 읽히지 않았다.
   * 제목 모양은 하나로 두고, 브리핑에만 키커와 설명을 덧붙인다.
   */
  .sec-h { margin: 0; font-size: var(--fs-600); line-height: var(--lh-snug); letter-spacing: var(--ls-tight); }

  .briefing-preview { margin-top: var(--space-14); }
  .briefing-heading { display: flex; align-items: end; justify-content: space-between; gap: var(--space-4); }
  .briefing-kicker {
    margin: 0 0 var(--space-2); color: var(--accent);
    font-size: var(--fs-100); font-weight: 800; letter-spacing: var(--ls-label);
  }
  .briefing-heading > a { font-size: var(--fs-300); white-space: nowrap; }
  .briefing-desc { margin: var(--space-3) 0 var(--space-5); color: var(--text-dim); font-size: var(--fs-300); line-height: var(--lh-normal); }
  .briefing-rows { border-top: 1px solid var(--border); }
  .briefing-row {
    display: flex; align-items: baseline; gap: var(--space-4);
    padding: var(--space-4) 0; border-bottom: 1px solid var(--border);
    color: var(--text); font-size: var(--fs-400); line-height: var(--lh-snug);
    transition: color var(--dur) var(--ease);
  }
  .briefing-row:hover { color: var(--accent); text-decoration: none; }
  .briefing-type { flex: 0 0 55px; color: var(--accent); font-size: var(--fs-200); font-weight: 800; }
  .briefing-title { flex: 1; font-weight: 700; }
  .briefing-arrow { color: var(--text-dim); }

  .pj { margin-top: var(--space-14); }
  .pj .sec-h { margin-bottom: var(--space-4); }
</style>
