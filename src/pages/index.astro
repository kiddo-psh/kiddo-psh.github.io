---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ListRow from '../components/ListRow.astro';
import { getCsPosts, getWritingPosts } from '../lib/posts';
import { SITE } from '../site.config';
import { dotDate, glyph, oneLine } from '../lib/format';
import { EXTERNAL_PROJECTS, listProjects } from '../lib/projects';

const writing = (await getWritingPosts()).slice(0, 4);
const csPosts = (await getCsPosts()).slice(0, 4);
const projects = listProjects(await getCollection('projects')).filter((project) => project.data.featured);
---

<BaseLayout title={SITE.title}>
  <h1 class="intro">{SITE.intro}</h1>

  {projects.length > 0 && (
    <section class="block" aria-labelledby="projects-title">
      <h2 id="projects-title" class="sec-title">프로젝트</h2>
      <ul class="list">
        {projects.map((project) => (
          <li>
            <ListRow
              href={`/projects/${project.id}/`}
              title={project.data.title}
              meta={oneLine(project.data.summary)}
              mark={glyph(project.data.title)}
              logo={project.data.logo}
            />
          </li>
        ))}
        {EXTERNAL_PROJECTS.map((project) => (
          <li>
            <ListRow href={project.href} title={project.title} meta={project.summary} logo={project.logo} />
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="block" aria-labelledby="posts-title">
    <h2 id="posts-title" class="sec-title">글</h2>
    <ul class="list">
      {writing.map((post) => (
        <li>
          <ListRow href={`/posts/${post.id}/`} title={post.data.title} meta={dotDate(post.data.pubDate)} />
        </li>
      ))}
    </ul>
  </section>

  {csPosts.length > 0 && (
    <section class="block" aria-labelledby="cs-title">
      <h2 id="cs-title" class="sec-title">CS</h2>
      <ul class="list">
        {csPosts.map((post) => (
          <li>
            <ListRow href={`/posts/${post.id}/`} title={post.data.title} meta={dotDate(post.data.pubDate)} />
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
