---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site.config';
import * as si from 'simple-icons';

const stacks: { group: string; items: { name: string; slug?: string }[] }[] = [
  { group: '언어', items: [
    { name: 'Python', slug: 'python' }, { name: 'Java', slug: 'openjdk' },
    { name: 'TypeScript', slug: 'typescript' }, { name: 'SQL' } ] },
  { group: 'AI·비전', items: [
    { name: 'YOLOv8' }, { name: 'ByteTrack' }, { name: 'TensorRT', slug: 'nvidia' },
    { name: 'OpenCV', slug: 'opencv' }, { name: 'Jetson', slug: 'nvidia' } ] },
  { group: 'LLM', items: [
    { name: 'Claude API', slug: 'claude' }, { name: 'RAG' }, { name: 'ChromaDB' } ] },
  { group: '백엔드', items: [
    { name: 'Spring Boot', slug: 'springboot' }, { name: 'JPA' },
    { name: 'FastAPI', slug: 'fastapi' } ] },
  { group: '프론트엔드', items: [
    { name: 'Vue 3', slug: 'vuedotjs' }, { name: 'React', slug: 'react' } ] },
  { group: '데이터', items: [
    { name: 'MySQL', slug: 'mysql' }, { name: 'PostgreSQL', slug: 'postgresql' },
    { name: 'Redis', slug: 'redis' } ] },
  { group: '인프라', items: [
    { name: 'Docker', slug: 'docker' }, { name: 'GitHub Actions', slug: 'githubactions' } ] },
];

// simple-icons는 siPython 형태로 내보낸다. 로고가 없는 항목은 글자만 렌더한다.
const icon = (slug?: string) => {
  if (!slug) return null;
  const key = 'si' + slug.charAt(0).toUpperCase() + slug.slice(1);
  return (si as Record<string, any>)[key] ?? null;
};

/*
 * 브랜드 원색은 테마 한쪽에서 묻힌다. Java(#000000)는 다크 배경에서 대비 1.31,
 * React(#61DAFB)는 흰 칩 위에서 1.63이다. 칩 배경(--bg-elev)과의 대비가 2.2 미만인
 * 로고만 그 테마에서 본문 색으로 떨어뜨린다. 나머지는 원색 그대로 간다.
 */
const luminance = (hex: string) => {
  const c = [0, 2, 4]
    .map((i) => parseInt(hex.slice(i, i + 2), 16) / 255)
    .map((v) => (v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4));
  return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2];
};
const contrast = (a: number, b: number) =>
  (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05);
const BG_LIGHT = luminance('ffffff'); // --bg-elev (light)
const BG_DARK = luminance('211f1c');  // --bg-elev (dark)
const MIN_CONTRAST = 2.2;

const themeClass = (hex: string) => {
  const l = luminance(hex);
  return [
    contrast(l, BG_LIGHT) < MIN_CONTRAST ? 'no-light' : '',
    contrast(l, BG_DARK) < MIN_CONTRAST ? 'no-dark' : '',
  ]
    .filter(Boolean)
    .join(' ');
};

const timeline = [
  { when: '2026.01 ~', what: '삼성 청년 SW·AI 아카데미 15기' },
  { when: '2018.03 ~ 2024.02', what: '경희대학교 생체의공학과' },
];

/*
 * 수상과 자격을 나눈다.
 *
 * 한 목록일 때 "삼성 SW역량테스트 B형"이 상 셋 사이에 끼어 네 번째 상처럼 보였다.
 * 그건 받은 상이 아니라 통과한 시험이다. 그리고 자격증 넷은 목록 아래 흐린 글씨
 * 한 줄로만 있어서, 같은 무게의 것이 한쪽은 목록 한쪽은 각주로 갈렸다.
 * 둘을 같은 모양의 목록 둘로 세운다.
 */
const awards = [
  { title: '공통 프로젝트 우수상', note: '주차바로 · SSAFY 2학기', href: '/projects/baro' },
  { title: '관통 프로젝트 최우수상', note: 'yumyum · SSAFY 1학기', href: '/projects/yumyum' },
  { title: '성적 우수상', note: 'SSAFY 1학기', href: null },
];

/* 취득일 내림차순. 위의 이력 목록과 같은 규칙이다 */
const certs = [
  { title: '정보처리기사', note: '2026.09' },
  { title: 'SQLD', note: '2026.06' },
  { title: 'ADsP', note: '2026.06' },
  { title: '삼성 SW역량테스트 B형', note: 'Professional · 2026.03' },
  { title: 'OPIc IH', note: '2025.09' },
];
---

<BaseLayout title="소개" description={SITE.description}>
  <div class="page w-read">
    <h1 class="page-title">소개</h1>

    <div class="prose">
      <p>
        만드는 것보다 <strong>기준을 정하는 게</strong> 더 어렵다고 생각해요. 뭘 위반으로 볼지,
        어떤 근거를 믿을지, 언제 모델을 부르지 말아야 할지 같은 것들이요. 경계를 미리 정해두지
        않으면 코드는 늘 그럴듯한 답을 내놓거든요.
      </p>
      <p>
        그래서 세 가지를 지키려고 해요. 추측은 재 보고 나서 말하기. 근거가 없으면 답을
        지어내지 않기. 수치를 말할 때는 그 수치가 나온 조건도 같이 적기.
      </p>
      <p>
        기능이 돌아가는 것보다, 안 돌아갈 때 무슨 일이 생기는지를 먼저 정해요. 이 블로그에는
        뭘 만들었는지보다 <strong>왜 그렇게 판단했는지</strong>를 써요.
      </p>
    </div>

    <h2>기술 스택</h2>
    <dl class="stack">
      {stacks.map((s) => (
        <div>
          <dt>{s.group}</dt>
          <dd class="chips">
            {s.items.map((it) => {
              const ic = icon(it.slug);
              return (
                <span class="chip stack-chip">
                  {ic && (
                    <svg
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                      class={themeClass(ic.hex)}
                      style={`--brand:#${ic.hex}`}
                    >
                      <path d={ic.path} />
                    </svg>
                  )}
                  {it.name}
                </span>
              );
            })}
          </dd>
        </div>
      ))}
    </dl>

    <h2>이력</h2>
    <dl class="stack">
      {timeline.map((t) => (
        <div>
          <dt class="wide">{t.when}</dt>
          <dd>{t.what}</dd>
        </div>
      ))}
    </dl>

    <h2>수상</h2>
    <ul class="record">
      {awards.map((a) => (
        <li>
          {a.href ? <a href={a.href}>{a.title}</a> : <span>{a.title}</span>}
          <small>{a.note}</small>
        </li>
      ))}
    </ul>

    <h2>자격</h2>
    <ul class="record">
      {certs.map((c) => (
        <li>
          <span>{c.title}</span>
          <small>{c.note}</small>
        </li>
      ))}
    </ul>

    <h2>연락</h2>
    <ul class="links">
      <li><a href={SITE.links.github}>GitHub</a></li>
      <li><a href="https://solved.ac/asded3563">solved.ac</a></li>
      <li><a href={`mailto:${SITE.links.email}`}>{SITE.links.email}</a></li>
    </ul>
  </div>
</BaseLayout>

<style>
  /* 폭은 global.css의 .w-read 유틸리티가 담당한다 (Task 6에서 통합) */
  h2 { font-size: var(--fs-600); margin: var(--space-10) 0 var(--space-3); line-height: var(--lh-snug); }


  .stack { margin: 0; display: grid; gap: var(--space-3); }
  .stack > div { display: flex; gap: var(--space-4); font-size: var(--fs-400); align-items: baseline; }
  .chips { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  /* 기하는 global.css의 .chip이 정한다. 여기서는 로고 자리와 배경만 더한다 */
  .stack-chip { gap: var(--space-2); background: var(--bg-elev); color: var(--text); }
  .stack-chip svg { width: 12px; height: 12px; flex: 0 0 auto; fill: var(--brand, currentColor); }
  :root[data-theme='light'] .stack-chip svg.no-light { fill: currentColor; }
  :root[data-theme='dark'] .stack-chip svg.no-dark { fill: currentColor; }
  dt { flex: 0 0 79px; color: var(--text-dim); white-space: nowrap; }
  dt.wide { flex: 0 0 135px; }
  dd { margin: 0; }

  /* 수상과 자격이 같은 모양을 쓴다 — 나눈 것은 성격이지 무게가 아니다 */
  .record { list-style: none; margin: 0; padding: 0; font-size: var(--fs-400); }
  .record li { padding: var(--space-1) 0; display: flex; align-items: baseline; gap: var(--space-3); flex-wrap: wrap; }
  .record small { font-size: var(--fs-300); color: var(--text-dim); }


  .links { list-style: none; margin: 0; padding: 0; font-size: var(--fs-400); }
  .links li { padding: var(--space-1) 0; }

  @media (max-width: 560px) {
    .stack div { flex-direction: column; gap: var(--space-05); }
    dt, dt.wide { flex: none; }
  }
</style>
