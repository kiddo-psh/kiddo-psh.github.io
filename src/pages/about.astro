---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site.config';

const projects = [
  {
    name: '주차바로',
    href: '/projects/baro',
    period: '2026.07 ~ 2026.08 · 7인 · 6주',
    role: 'AI 파트(차량 추적·주차 판정 파이프라인), 스크럼 마스터',
    desc: '천장 카메라와 엣지 AI로 이중주차·전용구역 무단 점유를 감지하고, 개인정보 노출 없이 이동 요청부터 재확인까지 중계하는 서비스.',
    stack: 'Jetson Orin Nano · YOLOv8 · ByteTrack · TensorRT · FastAPI',
  },
  {
    name: 'yumyum (냠냠코치)',
    href: '/projects/yumyum',
    period: '2026.05 ~ 2026.06 · 2인 · 4주',
    role: '2인 팀에서 백엔드·AI·프론트 전반 — 운동 루틴·프로그램, 주간 코칭, AI 상담(RAG)',
    desc: '식단·운동 기록 기반 AI 영양 상담과 주간 코칭 서비스. 고정 DAG로 모든 Agent를 돌리던 구조를, 질문과 기록 상태에 따라 필요한 Agent만 고르는 동적 라우팅으로 바꿨습니다.',
    stack: 'Spring Boot · FastAPI · Vue 3 · Claude API · ChromaDB',
  },
  {
    name: 'feelm',
    href: '/projects/feelm',
    period: '2026.08 ~ 진행 중 · 7인',
    role: '백엔드 계정 도메인·인증 기반',
    desc: 'MovieLens 32M 평점을 Hadoop/Spark로 처리하는 영화 추천 서비스. 인증은 정상 응답보다 실패·만료·중복·동시 요청을 먼저 명세하고 구현했습니다.',
    stack: 'Spring Boot · PostgreSQL · Redis · Spark/HDFS',
  },
];

const stacks = [
  { group: '언어', items: 'Python, Java, TypeScript, SQL' },
  { group: 'AI·비전', items: 'YOLOv8, ByteTrack, TensorRT, OpenCV' },
  { group: 'LLM', items: 'RAG, Multi-Agent, Claude API' },
  { group: '백엔드', items: 'Spring Boot, JPA, FastAPI' },
  { group: '프론트엔드', items: 'Vue 3, React' },
  { group: '데이터·인프라', items: 'MySQL, Spark/HDFS, Docker, GitHub Actions' },
];

const timeline = [
  { when: '2026.01 ~', what: '삼성 청년 SW·AI 아카데미 15기' },
  { when: '2018.03 ~ 2024.02', what: '경희대학교 생체의공학과' },
];

const awards = [
  { title: '공통 프로젝트 우수상', note: '주차바로 · SSAFY 2학기', href: '/projects/baro' },
  { title: '관통 프로젝트 최우수상', note: 'yumyum · SSAFY 1학기', href: '/projects/yumyum' },
  { title: '성적 우수상', note: 'SSAFY 1학기', href: null },
  { title: '삼성 SW역량테스트 B형 (Professional)', note: '2026.03', href: null },
];
---

<BaseLayout title="소개" description={SITE.description}>
  <div class="page w-read">
    <h1>소개</h1>

    <div class="prose">
      <p>
        만드는 일보다 <strong>기준을 정하는 일</strong>이 어렵다고 생각합니다. 무엇을 위반으로 볼지,
        어떤 근거를 믿을지, 언제 모델을 부르지 않을지. 경계를 정해두지 않으면 코드는 언제나
        그럴듯한 답을 내놓거든요.
      </p>
      <p>
        그래서 세 가지를 지키려고 합니다. 추측한 것은 재보고 나서 말하기. 근거가 없으면 답을
        만들지 않기. 수치를 주장할 때는 그 수치가 나온 조건을 함께 적기.
      </p>
      <p>
        기능이 되는 것보다 안 될 때 무슨 일이 일어나는지를 먼저 정합니다. 이 블로그에는 무엇을
        만들었는지보다 <strong>무엇을 어떤 근거로 판단했는지</strong>를 씁니다.
      </p>
    </div>

    <h2>프로젝트</h2>
    <ul class="pj">
      {projects.map((p) => (
        <li>
          <div class="pj-hd">
            <span class="pj-nm">
              {p.href ? <a href={p.href}>{p.name}</a> : p.name}
            </span>
            <span class="pj-pd">{p.period}</span>
          </div>
          <p class="pj-role">{p.role}</p>
          <p class="pj-desc">{p.desc}</p>
          <p class="pj-stack">{p.stack}</p>
        </li>
      ))}
    </ul>

    <h2>기술 스택</h2>
    <dl class="stack">
      {stacks.map((s) => (
        <div>
          <dt>{s.group}</dt>
          <dd>{s.items}</dd>
        </div>
      ))}
    </dl>

    <h2>이력</h2>
    <dl class="stack">
      {timeline.map((t) => (
        <div>
          <dt class="wide">{t.when}</dt>
          <dd>{t.what}</dd>
        </div>
      ))}
    </dl>

    <h2>수상·자격</h2>
    <ul class="awards">
      {awards.map((a) => (
        <li>
          {a.href ? <a href={a.href}>{a.title}</a> : <span>{a.title}</span>}
          <small>{a.note}</small>
        </li>
      ))}
    </ul>
    <details class="certs">
      <summary>그 외 자격증</summary>
      <p>정보처리기사 (2026.09) · SQLD (2026.06) · ADsP (2026.06) · OPIc IH (2025.09)</p>
    </details>

    <h2>연락</h2>
    <ul class="links">
      <li><a href={SITE.links.github}>GitHub</a></li>
      <li><a href="https://solved.ac/asded3563">solved.ac</a></li>
      <li><a href={`mailto:${SITE.links.email}`}>{SITE.links.email}</a></li>
    </ul>
  </div>
</BaseLayout>

<style>
  /* 폭은 global.css의 .w-read 유틸리티가 담당한다 (Task 6에서 통합) */
  h1 { font-size: 1.6em; margin: 40px 0 20px; }
  h2 { font-size: 1.05em; margin: 40px 0 12px; }

  .pj { list-style: none; margin: 0; padding: 0; }
  .pj > li { padding: 14px 0; border-top: 1px solid var(--border); }
  .pj > li:last-child { border-bottom: 1px solid var(--border); }
  .pj-hd { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .pj-nm { font-weight: 800; font-size: .98em; }
  .pj-pd { font-size: .8em; color: var(--text-dim); margin-left: auto; }
  .pj-role { margin: 4px 0 0; font-size: .85em; color: var(--accent); }
  .pj-desc { margin: 7px 0 0; font-size: .9em; line-height: 1.65; }
  .pj-stack { margin: 7px 0 0; font-size: .78em; color: var(--text-dim); }

  .stack { margin: 0; display: grid; gap: 9px; }
  .stack div { display: flex; gap: 14px; font-size: .93em; }
  dt { flex: 0 0 72px; color: var(--text-dim); }
  dt.wide { flex: 0 0 148px; }
  dd { margin: 0; }

  .awards { list-style: none; margin: 0; padding: 0; font-size: .93em; }
  .awards li { padding: 4px 0; display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .awards small { font-size: .82em; color: var(--text-dim); }

  .certs { margin-top: 14px; font-size: .88em; }
  .certs summary { color: var(--text-dim); cursor: pointer; }
  .certs p { margin: 8px 0 0; color: var(--text-dim); }

  .links { list-style: none; margin: 0; padding: 0; font-size: .93em; }
  .links li { padding: 3px 0; }

  @media (max-width: 560px) {
    .pj-pd { margin-left: 0; }
    .stack div { flex-direction: column; gap: 2px; }
    dt, dt.wide { flex: none; }
  }
</style>
