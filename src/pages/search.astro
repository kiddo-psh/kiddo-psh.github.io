---
import BaseLayout from '../layouts/BaseLayout.astro';
import PagefindConfig from 'astro-pagefind/components/PagefindConfig.astro';
import ListRow from '../components/ListRow.astro';
import CategoryTabs from '../components/CategoryTabs.astro';
import { getVisiblePosts } from '../lib/posts';
import { dotDate } from '../lib/format';

const recent = (await getVisiblePosts()).slice(0, 5);
---

<BaseLayout title="검색" description="사이트 내 글 검색">
  <h1 class="page-title">검색</h1>
  <noscript class="note">검색에는 자바스크립트가 필요합니다. <a class="content-link" href="/posts">글 목록에서 분류별로 둘러보세요</a>.</noscript>
  <PagefindConfig />
  <pagefind-searchbox></pagefind-searchbox>
  <div class="filters">
    <CategoryTabs active="" />
  </div>

  <section class="block" aria-labelledby="recent-title">
    <h2 id="recent-title" class="sec-title">최근 글</h2>
    <ul class="list">
      {recent.map((post) => (
        <li>
          <ListRow href={`/posts/${post.id}/`} title={post.data.title} meta={dotDate(post.data.pubDate)} />
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  pagefind-searchbox {
    --pf-background: var(--bg);
    --pf-text: var(--text);
    --pf-text-secondary: var(--text-dim);
    --pf-text-muted: var(--text-dim);
    --pf-border: var(--hair);
    --pf-border-focus: var(--text);
    --pf-hover: #f4f6f8;
    --pf-mark: var(--text);
    --pf-outline-focus: var(--text);
    --pf-font: var(--font-sans);
    --pf-searchbox-max-width: 100%;
    display: block;
    margin-top: 20px;
  }
  .filters { margin-top: 16px; }
</style>
