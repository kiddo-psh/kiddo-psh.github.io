---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="찾을 수 없는 페이지" description="요청한 주소에 페이지가 없습니다.">
  <div class="page box">
    <p class="code">404</p>
    <h1>페이지를 찾을 수 없습니다</h1>
    <p class="hint">주소가 바뀌었거나 삭제된 글일 수 있습니다.</p>
    <p class="links"><a href="/">홈으로</a> · <a href="/posts">글 목록</a></p>
  </div>
</BaseLayout>

<style>
  .box { text-align: center; padding: var(--space-20) var(--space-5); }
  .code { margin: 0; font-family: var(--font-mono); font-size: var(--fs-900); color: var(--accent); line-height: var(--lh-tight); }
  h1 { font-size: var(--fs-600); margin: var(--space-3) 0; line-height: var(--lh-snug); }
  /* 여백을 명시하지 않으면 브라우저 기본 1em이 들어와 글자 크기만큼 제각각이 된다 */
  .hint { margin: 0 0 var(--space-6); color: var(--text-dim); font-size: var(--fs-400); }
  .links { margin: 0; font-size: var(--fs-400); }
</style>
