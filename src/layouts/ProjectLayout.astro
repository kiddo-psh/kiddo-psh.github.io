---
import type { CollectionEntry } from 'astro:content';
import '../styles/article-content.css';
import BaseLayout from './BaseLayout.astro';
import MetricsTable from '../components/MetricsTable.astro';
import BackLink from '../components/BackLink.astro';
import Motif from '../components/Motif.astro';
import CoverImage from '../components/CoverImage.astro';
import CodeCopy from '../components/CodeCopy.astro';
import { projectTone } from '../lib/motif';
import RelatedLinks from '../components/RelatedLinks.astro';
import { getVisiblePosts, readingMinutes } from '../lib/posts';
import { getCategory } from '../site.config';

interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props;
const d = project.data;


// frontmatter의 relatedPosts를 실제 글로 바꾼다. 없는 slug는 조용히 버린다.
const all = await getVisiblePosts();
const related = (d.relatedPosts ?? [])
  .map((id) => all.find((p) => p.id === id))
  .filter((p): p is (typeof all)[number] => Boolean(p))
  .map((p) => ({
    href: `/posts/${p.id}`,
    label: p.data.title,
    meta: `${getCategory(p.data.category).label} · ${readingMinutes(p.body)}분`,
  }));
---

<BaseLayout title={d.title} description={d.summary} ogImage={d.cover ?? `/og/project-${project.id}.png`}>
  <div class="page-wide">
    <div class="shell doc">
      <article data-pagefind-body>
        <BackLink href="/projects" label="프로젝트" />
        <h1 class="page-title">{d.title}</h1>
        <p class="project-headline">{d.headline}</p>
        <p class="project-summary">{d.summary}</p>

        <span
          class:list={['art-frame', 'band', `t-${projectTone(d.order)}`, 'mk', { illustrated: !!d.cover }]}>
          {d.cover ? <CoverImage src={d.cover} sizes="(max-width:740px) 94vw, 684px" priority /> : <span class="art-plate"><Motif seed={project.id} tone={projectTone(d.order)} banner plain /></span>}
        </span>

        <dl class="facts">
          <div><dt>구성</dt><dd>{d.projectType}</dd></div>
          <div><dt>기간</dt><dd>{d.period}</dd></div>
          <div><dt>역할</dt><dd>{d.role}</dd></div>
          <div><dt>주요 기술</dt><dd>{d.stack.join(', ')}</dd></div>
          {(d.repo || d.demo) && (
            <div>
              <dt>링크</dt>
              <dd>
                {d.repo && <a href={d.repo}>GitHub</a>}
                {d.repo && d.demo && ' · '}
                {d.demo && <a href={d.demo}>Demo</a>}
              </dd>
            </div>
          )}
        </dl>

        <section class="contribution" aria-label="역할과 기여 범위">
          <h2>직접 책임진 일</h2>
          <ul>{d.contributions.map((item) => <li>{item}</li>)}</ul>
          <p class="collaboration"><strong>협업 범위</strong> {d.collaboration}</p>
          <div class="outcome"><h2>확인한 결과</h2><p>{d.outcome}</p></div>
        </section>

        <MetricsTable metrics={d.metrics} />
        {d.metricNote && <p class="metric-note">{d.metricNote}</p>}

        <div class="prose"><slot /></div>

        <RelatedLinks title="관련 회고" links={related} />
      </article>

    </div>
  </div>
  <CodeCopy />
</BaseLayout>

<style>
  .mk { margin: var(--space-6) 0 var(--space-7); }
  .mk.illustrated { height:auto; aspect-ratio:2.35; }

  /* 제목 위 여백은 BackLink가 만든다 */
  .page-title { margin-top:24px; }
  .project-headline { margin: 0 0 16px; font-size: clamp(22px, 4vw, 30px); font-weight: 700; line-height: 1.4; letter-spacing: -.03em; }
  .project-summary { margin: 0 0 28px; color: var(--text-dim); font-size: 18px; line-height: 1.8; }
  .contribution { margin: 24px 0 40px; padding: 24px; border-radius: 14px; background: var(--code-bg); line-height: 1.8; }
  .contribution h2 { margin: 0 0 12px; font-size: 17px; }
  .contribution ul { padding-left: 22px; margin: 0 0 20px; }
  .contribution li + li { margin-top: 6px; }
  .collaboration { margin: 0; color: var(--text-dim); }
  .collaboration strong { display: block; color: var(--text); }
  .outcome { margin-top: 22px; padding-top: 20px; border-top: 1px solid var(--border); }
  .outcome p { margin: 0; }

  .facts {
    margin: 0 0 var(--space-1); padding: var(--space-4) 0;
    border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);
    display: grid; gap: var(--space-2);
  }
  .facts div { display: flex; gap: var(--space-3); font-size: var(--fs-400); }
  dt { flex: 0 0 64px; color: var(--text-dim); }
  dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }
  .metric-note { margin: calc(var(--space-5) * -1) 0 var(--space-8); color: var(--text-dim); font-size: var(--fs-300); line-height: var(--lh-relaxed); }
</style>
