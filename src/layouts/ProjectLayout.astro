---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import MetricsTable from '../components/MetricsTable.astro';
import CodeCopy from '../components/CodeCopy.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { getVisiblePosts } from '../lib/posts';
import { getCategory } from '../site.config';
import { dotDate } from '../lib/format';

interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props;
const d = project.data;

const all = await getVisiblePosts();
const related = (d.relatedPosts ?? [])
  .map((id) => all.find((post) => post.id === id))
  .filter((post): post is (typeof all)[number] => Boolean(post))
  .map((post) => ({
    href: `/posts/${post.id}/`,
    label: post.data.title,
    meta: `${getCategory(post.data.category).name} · ${dotDate(post.data.pubDate)}`,
  }));
---

<BaseLayout title={d.pageTitle ?? d.title} description={d.summary} ogImage={d.cover ?? `/og/project-${project.id}.png`} backHref="/projects/" backLabel="프로젝트" earlyScript={d.essay}>
  {d.essay ? (
    <article class="kkugi" data-pagefind-body>
      <slot />
    </article>
  ) : (
  <article data-pagefind-body>
    <header class="doc-head">
      <h1>{d.title}</h1>
      <p class="meta">{d.period}</p>
    </header>
    <p class="doc-lead">{d.headline}</p>
    <p class="doc-lead">{d.summary}</p>

    <dl class="facts">
      <div><dt>구성</dt><dd>{d.projectType}</dd></div>
      <div><dt>역할</dt><dd>{d.role}</dd></div>
      <div><dt>기술</dt><dd>{d.stack.join(', ')}</dd></div>
      {(d.repo || d.demo) && (
        <div>
          <dt>링크</dt>
          <dd>
            {d.repo && <a href={d.repo}>GitHub</a>}
            {d.repo && d.demo && ' · '}
            {d.demo && <a href={d.demo}>Demo</a>}
          </dd>
        </div>
      )}
    </dl>

    <section class="quiet" aria-label="역할과 기여 범위">
      <h2>직접 책임진 일</h2>
      <ul>{d.contributions.map((item) => <li>{item}</li>)}</ul>
      <p class="collab"><strong>협업 범위</strong> {d.collaboration}</p>
      <h2>확인한 결과</h2>
      <p>{d.outcome}</p>
    </section>

    <MetricsTable metrics={d.metrics} />
    {d.metricNote && <p class="note">{d.metricNote}</p>}

    <div class="prose"><slot /></div>
    <RelatedLinks title="관련 글" links={related} />
  </article>
  )}
  {!d.essay && <CodeCopy />}
</BaseLayout>

<style>
  .facts { margin: 28px 0 0; padding: 0; border-top: 1px solid var(--hair); }
  .facts div {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--divider);
    font-size: 15px;
    line-height: 1.6;
  }
  dt { color: var(--text-dim); }
  dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }
  .facts a, .quiet a {
    text-decoration: underline;
    text-decoration-color: var(--link-line);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .facts a:hover, .quiet a:hover { text-decoration-color: var(--text); }
  .quiet { margin-top: 8px; color: var(--text-body); font-size: 17px; line-height: 1.625; }
  .quiet h2 {
    margin: 64px 0 12px;
    padding-top: 16px;
    border-top: 1px solid var(--hair);
    color: var(--text);
    font-size: 17px;
    font-weight: 550;
    line-height: 1.5;
  }
  .quiet ul { margin: 0 0 1em; padding-inline-start: 1.3em; }
  .quiet li { margin-bottom: 0.35em; }
  .quiet li::marker { color: var(--text-dim); }
  .quiet p { margin: 0 0 1em; }
  .collab { color: var(--text-dim); }
  .collab strong { display: block; color: var(--text); font-weight: 550; }
</style>
