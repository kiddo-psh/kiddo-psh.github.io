---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import MetricsTable from '../components/MetricsTable.astro';
import BackLink from '../components/BackLink.astro';
import Motif from '../components/Motif.astro';
import { projectTone } from '../lib/motif';
import RelatedLinks from '../components/RelatedLinks.astro';
import { getVisiblePosts, readingMinutes } from '../lib/posts';
import { getCategory } from '../site.config';

interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props;
const d = project.data;


// frontmatter의 relatedPosts를 실제 글로 바꾼다. 없는 slug는 조용히 버린다.
const all = await getVisiblePosts();
const related = (d.relatedPosts ?? [])
  .map((id) => all.find((p) => p.id === id))
  .filter((p): p is (typeof all)[number] => Boolean(p))
  .map((p) => ({
    href: `/posts/${p.id}`,
    label: p.data.title,
    meta: `${getCategory(p.data.category).label} · ${readingMinutes(p.body)}분`,
  }));
---

<BaseLayout title={d.title} description={d.summary} ogImage={`/og/project-${project.id}.png`}>
  <div class="page-wide">
    <div class="shell doc">
      <article data-pagefind-body>
        <BackLink href="/projects" label="프로젝트" />
        {/*
          목록 카드에 있던 마크를 상세에도 둔다. 카드에서 마크를 보고 들어왔는데
          상세에 없으면 같은 프로젝트라는 신호가 문턱에서 끊긴다.
          글 상세와 같은 머리그림을 쓴다 — 상세 페이지는 둘 다 같은 자리에 같은 모양이어야 한다.
          틴트는 카드와 같은 규칙(order)으로 정한다.
        */}
        <span
          class:list={['art-frame', 'band', `t-${projectTone(d.order)}`, 'mk']}>
          <span class="art-plate"><Motif seed={project.id} tone={projectTone(d.order)} banner plain /></span>
        </span>
        <h1 class="page-title">{d.title}</h1>

        <dl class="facts">
          <div><dt>기간</dt><dd>{d.period}</dd></div>
          <div><dt>역할</dt><dd>{d.role}</dd></div>
          <div><dt>기술</dt><dd>{d.stack.join(', ')}</dd></div>
          {(d.repo || d.demo) && (
            <div>
              <dt>링크</dt>
              <dd>
                {d.repo && <a href={d.repo}>GitHub</a>}
                {d.repo && d.demo && ' · '}
                {d.demo && <a href={d.demo}>Demo</a>}
              </dd>
            </div>
          )}
        </dl>

        <MetricsTable metrics={d.metrics} />
        {d.metricNote && <p class="metric-note">{d.metricNote}</p>}

        <div class="prose"><slot /></div>

        <RelatedLinks title="관련 회고" links={related} />
      </article>

    </div>
  </div>
</BaseLayout>

<style>
  /* 제목 위 머리그림. .page-title의 위 여백을 그림이 대신 갖는다 */
  .mk { margin: var(--space-6) 0 var(--space-7); }
  .mk + .page-title { margin-top: 0; }

  /* 제목 위 여백은 BackLink가 만든다 */
  .page-title { margin-top: 0; }

  .facts {
    margin: 0 0 var(--space-1); padding: var(--space-4) 0;
    border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);
    display: grid; gap: var(--space-2);
  }
  .facts div { display: flex; gap: var(--space-3); font-size: var(--fs-400); }
  dt { flex: 0 0 47px; color: var(--text-dim); }
  dd { margin: 0; }
  .metric-note { margin: calc(var(--space-5) * -1) 0 var(--space-8); color: var(--text-dim); font-size: var(--fs-300); line-height: var(--lh-relaxed); }
</style>
