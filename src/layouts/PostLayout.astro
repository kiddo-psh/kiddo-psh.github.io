---
import BaseLayout from './BaseLayout.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import CodeCopy from '../components/CodeCopy.astro';
import Comments from '../components/Comments.astro';
import { getCategory } from '../site.config';
import { getRelatedPosts, type Post } from '../lib/posts';
import { dotDate } from '../lib/format';

interface Props { post: Post }
const { post } = Astro.props;

const cat = getCategory(post.data.category);
const related = (await getRelatedPosts(post)).map((item) => ({
  href: `/posts/${item.id}/`,
  label: item.data.title,
  meta: `${getCategory(item.data.category).name} · ${dotDate(item.data.pubDate)}`,
}));
const date = dotDate(post.data.pubDate);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={post.data.cover ?? `/og/${post.id}.png`}
  ogType="article"
  backHref="/posts/"
  backLabel="글 목록"
>
  <article data-pagefind-body>
    <header class="doc-head">
      <h1>{post.data.title}</h1>
      <p class="meta">{cat.name} · {date}</p>
    </header>
    <div class="prose"><slot /></div>
    <RelatedLinks title="같은 분류의 다른 글" links={related} />
    <Comments />
  </article>
  <CodeCopy />
</BaseLayout>
