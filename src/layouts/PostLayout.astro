---
import BaseLayout from './BaseLayout.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import BackLink from '../components/BackLink.astro';
import ArticleCover from '../components/ArticleCover.astro';
import Comments from '../components/Comments.astro';
import { getCategory } from '../site.config';
import { getRelatedPosts, readingMinutes, type Post } from '../lib/posts';

interface Props { post: Post }
const { post } = Astro.props;

const cat = getCategory(post.data.category);
const isDoc = cat.layout === 'doc';
const related = (await getRelatedPosts(post)).map((p) => ({
  href: `/posts/${p.id}`,
  label: p.data.title,
  meta: `${getCategory(p.data.category).label} · ${readingMinutes(p.body)}분`,
}));
const date = post.data.pubDate.toISOString().slice(0, 10).replace(/-/g, '.');
const minutes = readingMinutes(post.body);
const ogImage = post.data.cover ?? `/og/${post.id}.png`;
---

<BaseLayout title={post.data.title} description={post.data.description} ogImage={ogImage} ogType="article">
  <div class="page-wide">
    <div class:list={['shell', isDoc ? 'doc' : 'read']}>
      <article data-pagefind-body>
        <BackLink href="/posts" label="글" />
        <header>
          {/* 목록과 상세에서 같은 주제별 커버를 사용한다. */}
          <div class="article-hero">
            {post.data.cover ? <img src={post.data.cover} alt="" width="1200" height="750" /> : <ArticleCover id={post.id} />}
          </div>
          <p class="cat">{cat.label}</p>
          <h1 class="serif">{post.data.title}</h1>
          <p class="date">{date} · {minutes}분 읽기</p>
        </header>

        <div class="prose"><slot /></div>

        <RelatedLinks title="같은 분류의 다른 글" links={related} />
        <Comments slug={post.id} />
      </article>

    </div>
  </div>
</BaseLayout>

<style>
  header { margin-bottom: var(--space-8); }
  .article-hero { margin:28px 0 36px; }
  .article-hero img { display:block; width:100%; height:auto; border-radius:18px; }
  .cat { margin: 0 0 var(--space-3); font-size: var(--fs-200); font-weight: 800; letter-spacing: var(--ls-label); color: var(--accent); }
  h1 { margin: 0 0 var(--space-4); font-size: var(--fs-title); line-height: var(--lh-tight); letter-spacing: var(--ls-tight); }
  .date { margin: 0; padding-bottom: var(--space-5); border-bottom: 1px solid var(--border); font-size: var(--fs-300); color: var(--text-dim); }

  .shell.read .prose { line-height: var(--lh-loose); }

</style>
