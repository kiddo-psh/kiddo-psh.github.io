---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import Comments from '../components/Comments.astro';
import { getCategory } from '../site.config';
import { getRelatedPosts, readingMinutes, type Post } from '../lib/posts';

interface Props { post: Post; headings: MarkdownHeading[] }
const { post, headings } = Astro.props;

const cat = getCategory(post.data.category);
const tocItems = headings.filter((h) => h.depth === 2 || h.depth === 3);
const isDoc = cat.layout === 'doc';           // controls width and lead font
const showToc = isDoc && tocItems.length > 0; // controls the aside and the grid columns
const related = await getRelatedPosts(post);
const date = post.data.pubDate.toISOString().slice(0, 10).replace(/-/g, '.');
const minutes = readingMinutes(post.body);
const ogImage = post.data.cover ?? `/og/${post.id}.png`;
---

<BaseLayout title={post.data.title} description={post.data.description} ogImage={ogImage} ogType="article">
  <div class="page-wide">
    <div class:list={['shell', isDoc ? 'doc' : 'read', { toc: showToc }]}>
      <article data-pagefind-body>
        <header>
          <p class="cat">{cat.label}</p>
          <h1>{post.data.title}</h1>
          <p class:list={['lead', { serif: !isDoc }]}>{post.data.description}</p>
          <p class="date">{date} · {minutes}분 읽기</p>
        </header>

        <div class="prose"><slot /></div>

        <RelatedPosts posts={related} />
        <Comments slug={post.id} />
      </article>

      {/* 목차를 본문 뒤에 둔다 — 키보드·스크린리더 사용자가 목차 링크를 먼저 지나지 않는다 */}
      {showToc && <aside class="side"><TableOfContents headings={headings} /></aside>}
    </div>
  </div>
</BaseLayout>

<style>
  /*
   * 목차가 있는 글: 본문을 왼쪽에 두고 목차를 오른쪽에, 사이를 넓게 벌린다.
   * 목차가 없는 글은 본문을 가운데 정렬한다.
   */
  .shell { display: grid; margin: 40px 0 0; }
  .shell.doc { grid-template-columns: minmax(0, var(--w-doc)); justify-content: center; }
  /*
   * 여백을 clamp로 둔 이유: 고정값으로 넓게 잡으면 1200px 안팎의 창에서
   * 본문이 먼저 쪼그라든다. 넓은 화면에서는 여백이 벌어지고, 좁아지면
   * 여백이 먼저 줄고 그 다음 목차가 줄고, 마지막에 목차가 사라진다.
   */
  .shell.doc.toc {
    grid-template-columns: minmax(0, var(--w-doc)) minmax(180px, 240px);
    column-gap: clamp(56px, 8vw, 130px);
    justify-content: start;
  }
  .shell.read { grid-template-columns: minmax(0, var(--w-read)); justify-content: center; }

  header { margin-bottom: 30px; }
  .cat { margin: 0 0 10px; font-size: .74em; font-weight: 800; letter-spacing: .12em; color: var(--accent); }
  h1 { margin: 0 0 14px; font-size: 2.1em; line-height: 1.32; letter-spacing: -.03em; }
  .lead { margin: 0 0 16px; color: var(--text-dim); font-size: 1.1em; line-height: 1.7; }
  .lead.serif { font-family: var(--font-serif); font-size: 1.18em; }
  .date { margin: 0; padding-bottom: 18px; border-bottom: 1px solid var(--border); font-size: .8em; color: var(--text-dim); }

  .shell.read .prose { line-height: 1.95; }

  @media (max-width: 1040px) {
    .shell.doc.toc {
      grid-template-columns: minmax(0, var(--w-doc));
      gap: 0;
      justify-content: center;
    }
    .side { display: none; }
  }
</style>
